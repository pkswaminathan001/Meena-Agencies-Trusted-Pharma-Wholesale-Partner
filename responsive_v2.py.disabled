"""responsive_v2.py — Universal fluid responsive layout.
Works on any screen width from 320px to 8K, portrait or landscape.
"""
import streamlit as st


def inject():
    """Inject universal responsive CSS. Call once, right after set_page_config."""
    if st.session_state.get("_responsive_v2_done"):
        return

    st.markdown("""
    <style>
    /* ═══════════════════════════════════════════════════════════
       UNIVERSAL RESPONSIVE — works on every device by width, not model
       ═══════════════════════════════════════════════════════════ */

    /* 1. Fluid container: fills 100% width, max 1800px, centered */
    .main .block-container,
    [data-testid="stAppViewContainer"] > .main > .block-container,
    [data-testid="stAppViewBlockContainer"],
    section.main > div.block-container {
        width: 100% !important;
        max-width: 1800px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
        padding-top: 1rem !important;
    }

    /* 2. Fluid columns: no min-width, wrap gracefully */
    [data-testid="column"] {
        min-width: 0 !important;
        padding: 0 0.4rem !important;
    }

    /* 3. Fluid metrics — scale with viewport */
    [data-testid="stMetric"] {
        padding: clamp(0.6rem, 1.2vw, 1.4rem) !important;
    }
    [data-testid="stMetricValue"] {
        font-size: clamp(1.1rem, 2vw, 2rem) !important;
        line-height: 1.1 !important;
    }
    [data-testid="stMetricLabel"] {
        font-size: clamp(0.65rem, 0.9vw, 0.85rem) !important;
        letter-spacing: 0.6px !important;
    }

    /* 4. Fluid typography — everything scales with viewport */
    h1 { font-size: clamp(1.4rem, 3vw, 2.5rem) !important; }
    h2 { font-size: clamp(1.2rem, 2.4vw, 2rem) !important; }
    h3 { font-size: clamp(1.05rem, 1.8vw, 1.5rem) !important; }
    p, .stMarkdown { font-size: clamp(0.85rem, 1.05vw, 1rem) !important; }

    /* 5. Fluid buttons */
    .stButton > button,
    .stDownloadButton > button,
    .stFormSubmitButton > button {
        font-size: clamp(0.8rem, 1vw, 0.95rem) !important;
        padding: clamp(0.5rem, 1vw, 0.75rem) clamp(0.8rem, 1.5vw, 1.2rem) !important;
        min-height: 40px !important;
    }

    /* 6. Tabs — wrap to multiple rows on narrow screens */
    [data-baseweb="tab-list"] {
        flex-wrap: wrap !important;
        gap: 0.3rem !important;
    }
    [data-baseweb="tab"] {
        font-size: clamp(0.75rem, 1vw, 0.9rem) !important;
        padding: clamp(0.4rem, 0.9vw, 0.7rem) clamp(0.6rem, 1.2vw, 1rem) !important;
        white-space: nowrap !important;
    }

    /* 7. DataFrames — horizontal scroll on small screens */
    [data-testid="stDataFrame"] {
        overflow-x: auto !important;
        max-width: 100% !important;
    }
    [data-testid="stDataFrame"] > div {
        overflow-x: auto !important;
    }

    /* 8. Plots/charts — fluid width */
    .js-plotly-plot, [data-testid="stPlotlyChart"] {
        width: 100% !important;
    }
    .js-plotly-plot .plotly {
        width: 100% !important;
        max-width: 100% !important;
    }

    /* 9. Code blocks — scroll instead of overflow */
    pre, code {
        overflow-x: auto !important;
        max-width: 100% !important;
        white-space: pre !important;
        font-size: clamp(0.72rem, 0.95vw, 0.88rem) !important;
    }

    /* 10. Images — never overflow */
    img { max-width: 100% !important; height: auto !important; }

    /* 11. Expanders — full width */
    [data-testid="stExpander"] { width: 100% !important; }

    /* 12. Sidebar — fluid width on desktop, hidden on phone by default */
    [data-testid="stSidebar"] {
        width: clamp(200px, 20vw, 320px) !important;
        min-width: 200px !important;
    }

    /* 13. Container padding — shrink on phones */
    @media (max-width: 768px) {
        .main .block-container {
            padding-left: 0.75rem !important;
            padding-right: 0.75rem !important;
        }
        /* Stack all columns into single column on phone */
        [data-testid="column"] {
            flex: 1 1 100% !important;
            min-width: 100% !important;
            margin-bottom: 0.5rem !important;
        }
        /* Make horizontal scroll smooth */
        body { -webkit-overflow-scrolling: touch; }
    }

    /* 14. Tablet — 2 columns */
    @media (min-width: 769px) and (max-width: 1024px) {
        .main .block-container {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }
    }

    /* 15. Large desktop / 4K — cap at 1800px, add breathing room */
    @media (min-width: 1920px) {
        .main .block-container {
            max-width: 1800px !important;
            padding-left: 3rem !important;
            padding-right: 3rem !important;
        }
    }
    @media (min-width: 2560px) {
        .main .block-container {
            max-width: 2200px !important;
            padding-left: 4rem !important;
            padding-right: 4rem !important;
        }
    }

    /* 16. Touch-friendly targets on mobile */
    @media (hover: none) and (pointer: coarse) {
        .stButton > button,
        .stDownloadButton > button,
        .stFormSubmitButton > button {
            min-height: 44px !important;
            min-width: 44px !important;
        }
        [data-baseweb="tab"] {
            min-height: 44px !important;
        }
    }

    /* 17. Prevent horizontal overflow — the #1 mobile bug */
    html, body, .stApp, .main {
        overflow-x: hidden !important;
        max-width: 100vw !important;
    }

    /* 18. Fluid gap between sections */
    [data-testid="stVerticalBlock"] > [style*="flex-direction: column"] > div {
        margin-bottom: clamp(0.3rem, 0.6vw, 0.8rem) !important;
    }

    /* 19. Prevent Streamlit's default footer from squishing layout */
    footer { visibility: hidden !important; height: 0 !important; }
    #MainMenu { visibility: hidden !important; }

    /* 20. Custom scrollbar for the whole page (light touch) */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: rgba(10,14,39,0.4); }
    ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #00d4aa, #7b61ff);
        border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover { background: #00d4aa; }
    </style>
    """, unsafe_allow_html=True)
    st.session_state["_responsive_v2_done"] = True
