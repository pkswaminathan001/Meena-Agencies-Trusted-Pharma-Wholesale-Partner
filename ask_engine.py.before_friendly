# QUESTION CACHE — same question = instant answer
# ═══════════════════════════════════════════════
import hashlib
from pathlib import Path as _Path

_CACHE_FILE = _Path("ask_cache.json")
_CACHE_TTL_SECONDS = 3600  # 5 minutes

def _load_cache():
    if not _CACHE_FILE.exists():
        return {}
    try:
        import json as _j
        return _j.loads(_CACHE_FILE.read_text())
    except Exception:
        return {}

def _save_cache(cache):
    try:
        import json as _j
        _CACHE_FILE.write_text(_j.dumps(cache, default=str))
    except Exception:
        pass

def _cache_key(question: str) -> str:
    return hashlib.md5(question.lower().strip().encode()).hexdigest()[:12]

def _get_cached(question: str):
    import time as _t
    cache = _load_cache()
    k = _cache_key(question)
    if k in cache:
        entry = cache[k]
        if _t.time() - entry.get("ts", 0) < _CACHE_TTL_SECONDS:
            return entry.get("answer")
    return None

def _set_cached(question: str, answer: str):
    import time as _t
    cache = _load_cache()
    # Keep cache small — max 200 entries
    if len(cache) > 200:
        sorted_keys = sorted(cache.keys(), key=lambda x: cache[x].get("ts", 0))
        for old in sorted_keys[:50]:
            del cache[old]
    cache[_cache_key(question)] = {"answer": answer, "ts": _t.time()}
    _save_cache(cache)


