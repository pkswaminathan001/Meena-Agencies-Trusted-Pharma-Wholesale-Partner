"""


def question_to_sql(question: str) -> dict:
    """Convert natural language question to SQL."""
    schemas = db_schema.all_schemas()
    json_info = db_schema.all_json_schemas()

    user_prompt = f"""Available databases:
{schemas}

Available JSON files (cannot be queried with SQL, but mentioned for context):
{json_info}

Question: {question}

Generate SQL to answer this question. Return JSON only."""

    # Try Groq first (faster)
    groq_err = None
    if GROQ_OK:
        try:
            r = client.chat.completions.create(
            model="llama-3.1-8b-instant",
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_prompt},
            ],
            temperature=0.1,
            max_tokens=600,
            response_format={"type": "json_object"},
            )
            return json.loads(r.choices[0].message.content)
        except Exception as e:
            groq_err = e
    # Fallback to Gemini if Groq unavailable or failed
    if GEMINI_OK:
        try:
            gemini_prompt = SYSTEM_PROMPT + "\n\n" + user_prompt
            g = gemini_ask(gemini_prompt)
            if "text" in g:
                txt = g["text"].strip()
                # Strip markdown code fences
                if txt.startswith("```"):
                    parts = txt.split("```")
                    if len(parts) > 1:
                        txt = parts[1]
                        if txt.startswith("json"):
                            txt = txt[4:]
                return json.loads(txt.strip())
            else:
                return {"error": f"Groq: {groq_err or 'unavailable'}; Gemini: {g.get('error')}"}
        except Exception as gem_err:
            return {"error": f"Both LLMs failed. Groq: {groq_err or 'skipped'}. Gemini: {gem_err}"}

    return {"error": f"No LLM available. Groq: {groq_err or 'key missing'}"}


def run_sql(sql: str, db: str = "queryable.db") -> dict:
    """Run safe SQL on a SQLite DB."""
    safety = sql_safety.is_safe(sql)
    if not safety["safe"]:
        return {"error": f"Unsafe query: {safety['reason']}"}

    sql = safety["sql"]

    if not Path(db).exists():
        return {"error": f"Database {db} not found"}

    try:
        conn = sqlite3.connect(db)
        conn.row_factory = sqlite3.Row
        c = conn.cursor()
        c.execute(sql)
        rows = [dict(r) for r in c.fetchall()]
        conn.close()
        return {"rows": rows, "count": len(rows), "sql": sql}
    except Exception as e:
        return {"error": f"SQL error: {e}"}



def _fast_template_answer(question: str, rows: list, count: int) -> str:
    """Fast template for simple aggregate queries — no LLM call."""
    q = question.lower()
    if count == 0:
        return "No data found for that question."
    if count == 1 and len(rows[0]) == 1:
        key = list(rows[0].keys())[0]
        val = list(rows[0].values())[0]
        # Format number with commas if numeric
        try:
            if isinstance(val, (int, float)) and val > 1000:
                val = f"{val:,.2f}" if isinstance(val, float) else f"{val:,}"
        except Exception:
            pass
        return f"**{key.replace('_', ' ').title()}:** {val}"
    # Multi-row: bullet list, first column as title
    lines = [f"**Found {count} result(s):**", ""]
    for r in rows[:10]:
        keys = list(r.keys())
        title_val = r.get(keys[0], "?")
        line = f"• **{title_val}**"
        rest = [f"{k}: {r[k]}" for k in keys[1:4] if r[k] not in (None, "", 0)]
        if rest:
            line += " · " + " · ".join(rest)
        lines.append(line)
    if count > 10:
        lines.append(f"...and {count - 10} more")
    return "\n".join(lines)


def format_answer(question: str, rows: list, count: int) -> str:
    """Format the result as a readable answer."""
    if count == 0:
        return "No data found for that question."
    
    # Fast path: use template for ALL queries (skip LLM formatting)
    return _fast_template_answer(question, rows, count)

    prompt = f"""User asked: "{question}"

Query returned {count} rows. Here are the top 20 rows:
