"""

    try:
        r = client.chat.completions.create(
            model="llama-3.1-8b-instant",
            messages=[{"role": "user", "content": prompt}],
            temperature=0.3,
            max_tokens=400,
        )
        return r.choices[0].message.content
    except Exception as e:
        return f"Format error: {e}\n\nRaw data:\n{json.dumps(rows[:5], indent=2)}"


def ask(question: str, db: str = "queryable.db") -> dict:
    """Full pipeline: question → SQL → run → format. Uses cache."""
    # Check cache first
    cached = _get_cached(question)
    if cached:
        return {"ok": True, "answer": cached, "row_count": 1, "sql": "", "cached": True}

    # Step 1: Get SQL
    sql_result = question_to_sql(question)
    if "error" in sql_result:
        return {"ok": False, "error": sql_result["error"]}

    sql = sql_result.get("sql", "")
    if not sql:
        return {"ok": False, "error": "LLM didn't return SQL"}

    # Step 2: Run it
    run_result = run_sql(sql, db)
    if "error" in run_result:
        return {"ok": False, "error": run_result["error"], "sql": sql}

    # Step 3: Format answer
    answer = format_answer(question, run_result["rows"], run_result["count"])

    # Save to cache
    _set_cached(question, answer)

    return {
        "ok": True,
        "answer": answer,
        "row_count": run_result["count"],
        "sql": sql,
        "cached": False,
    }


