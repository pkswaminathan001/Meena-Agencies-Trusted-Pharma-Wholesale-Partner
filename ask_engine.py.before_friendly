# PRE-WARM CACHE — call on startup
# ═══════════════════════════════════════════════
def prewarm_cache():
    """Pre-compute common questions so first user hit is instant."""
    common = [
        "how many orders do we have",
        "top 3 retailers by outstanding",
        "which orders are pending",
        "which retailer owes the most",
        "stock expiring in 30 days",
        "how many approved orders",
        "show me all retailers",
    ]
    ok = 0
    for q in common:
        try:
            r = ask(q)
            if r.get("ok"):
                ok += 1
        except Exception:
            pass
    return ok
