        except Exception:
            pass

    # Fallback to Gemini
    if GEMINI_OK:
        try:
            g = gemini_ask(prompt)
            if "text" in g:
                return g["text"]
        except Exception:
            pass

    # Last resort: show raw data
    return f"Found {count} rows:\n" + json.dumps(rows[:5], indent=2)

    if count == 0:
        return "No data found for that question."

    prompt = f"""User asked: "{question}"

Query returned {count} rows. Here are the top 20 rows:
{json.dumps(rows[:20], indent=2, default=str)}

Write a SHORT, clear answer in plain English for a business owner.
- Use Rs  for money
- Use bold for key numbers
