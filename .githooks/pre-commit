#!/usr/bin/env bash
set -u
TOKEN_RE='[0-9]{8,10}:[A-Za-z0-9_-]{30,}'
AWS_RE='AKIA[0-9A-Z]{16}'
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.pdf|*.zip) continue;; esac
  if git show ":$f" 2>/dev/null | grep -Eq "$TOKEN_RE|$AWS_RE"; then
    echo "❌ BLOCKED: $f looks like it contains a live API token."
    echo "   Move to .streamlit/secrets.toml and .gitignore it."
    exit 1
  fi
done
exit 0
