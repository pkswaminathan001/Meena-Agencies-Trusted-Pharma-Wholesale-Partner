def sign_out():
    """Clear session, log event, return to login screen."""
    try:
        # Log before clearing
        user = current_user_key()
        track(user, "SIGN_OUT", page="signout")
    except Exception:
        pass
    # Clear all session state
    for key in list(st.session_state.keys()):
        try:
            del st.session_state[key]
        except Exception:
            pass
    st.rerun()


