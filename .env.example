# ═══════════════════════════════════════════════════════════
# Meena Agencies — Environment Configuration
# Copy this to .env and fill in your own values
# ═══════════════════════════════════════════════════════════

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_CHAT_ID=your_telegram_chat_id
EMPLOYEE_CHAT_ID=

# ── AI ──
GROQ_API_KEY=your_groq_api_key

# ── SMS (optional) ──
SMS_PROVIDER=mock
SMS_DAILY_LIMIT=100
PREFER_SMS=false

# ── Company ──
COMPANY_NAME=Meena Agencies Pharma Wholesale
NOTIFY_CHANNEL=telegram
