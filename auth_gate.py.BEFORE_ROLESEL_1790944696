def _render_hero(logo_b64: str):
    """Render hero card. Uses single-line HTML to avoid markdown code-block."""
    # IMPORTANT: no leading indentation -> Streamlit renders as HTML, not code block
    html = (
        '<div class="ma-hero-wrap">'
        '<div class="ma-hero">'
        f'<img class="ma-logo" src="data:image/png;base64,{logo_b64}" alt="Meena Agencies" />'
        '<div class="ma-brand">Meena Agencies</div>'
        '<div class="ma-sub">Authorised Access Only</div>'
        '<span class="ma-underline"></span>'
        '</div>'
        '</div>'
    )
    st.markdown(html, unsafe_allow_html=True)


def check_password():
    """Returns True if the user has entered the correct access password."""
    # Load logo once per render
    try:
        import base64
        from pathlib import Path
        logo_path = Path("logo.png")
        if logo_path.exists():
            logo_b64 = base64.b64encode(logo_path.read_bytes()).decode()
        else:
            logo_b64 = ""
    except Exception:
        logo_b64 = ""

    st.markdown(AUTH_CSS, unsafe_allow_html=True)

    def password_entered():
        try:
            expected = st.secrets["ACCESS_PASSWORD"]
        except Exception:
            st.session_state["_auth_state"] = "ok"
            st.session_state["_ma_auth_unlocked"] = True
            return
        entered = st.session_state.get("password", "")
        if entered and hmac.compare_digest(entered, expected):
            st.session_state["_auth_state"] = "ok"
            st.session_state["password_correct"] = True
            st.session_state["_ma_auth_unlocked"] = True
        else:
            st.session_state["_auth_state"] = "wrong"
            st.session_state["password_correct"] = False
            st.session_state["_ma_auth_unlocked"] = False

    # Check multiple possible keys for robustness
    if (st.session_state.get("_ma_auth_unlocked") is True
        or st.session_state.get("password_correct") is True):
        return True

    _render_hero(logo_b64)

    _sp_l, _mid, _sp_r = st.columns([1, 1.6, 1])
    with _mid:
        st.text_input(
            "Access Password",
            type="password",
            key="password",
            on_change=password_entered,
            placeholder="Enter your passphrase",
        )
        if st.session_state.get("_auth_state") == "wrong":
            st.error("Wrong password — try again")

    return False
