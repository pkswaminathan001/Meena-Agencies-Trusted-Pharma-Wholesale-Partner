def render(retailer):
    """Master renderer. Called from app.py retailer view."""
    _inject_css()

    # Handle "Added to cart" toast
    toast = st.session_state.pop("_added_toast", None)
    if toast:
        st.markdown(f'<div class="ma-added-toast">✅ Added to cart · {toast}</div>',
                    unsafe_allow_html=True)

    # Sticky cart bar at top
    render_sticky_cart_bar(retailer)

    # Route to right sub-view
    if st.session_state.get("show_cart_page"):
        render_cart_page(retailer)
        return

    cat_selected = st.session_state.get("cust_cat_selected")
    if cat_selected:
        render_category_detail(cat_selected)
    else:
        render_category_grid()
