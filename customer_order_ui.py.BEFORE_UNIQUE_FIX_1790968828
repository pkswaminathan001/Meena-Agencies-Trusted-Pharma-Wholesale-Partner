def render_category_grid():
    inv = _load_inventory()
    if inv.empty:
        st.error("Inventory not loaded. Please contact Meena Agencies.")
        return

    # Aggregate by category — count UNIQUE medicines, not batches
    cats = {}
    for _, row in inv.iterrows():
        med = str(row.get("medicine_name", "?"))
        qty = int(float(row.get("quantity", 0) or 0))
        cat = _infer_category(med)
        if cat not in cats:
            cats[cat] = {"meds": set(), "units": 0}
        cats[cat]["meds"].add(med)          # ← SET, not counter
        cats[cat]["units"] += qty

    # Convert sets to counts
    for cat in cats:
        cats[cat]["meds"] = len(cats[cat]["meds"])

    st.markdown("### 📁 Browse by Category")
    st.caption(f"📊 {_unique_count} unique medicines · {len(inv)} batches · {len(cats)} categories")

    # Sort by units desc, keep Other last
    sorted_cats = sorted(cats.items(),
                        key=lambda x: (x[0] == "Other", -x[1]["units"]))

    # 4 per row grid
    for i in range(0, len(sorted_cats), 4):
        cols = st.columns(4)
        for j, (cname, cdata) in enumerate(sorted_cats[i:i+4]):
            with cols[j]:
                icon = _category_icon(cname)
                units = cdata["units"]
                meds = cdata["meds"]
                if units == 0:
                    ucolor = "#ff5252"
                elif units < 500:
                    ucolor = "#ffc107"
                else:
                    ucolor = "#00d47a"

                st.markdown(f"""
                <div class="ma-cat-card">
                    <div class="ma-cat-icon">{icon}</div>
                    <div class="ma-cat-name">{cname}</div>
                    <div class="ma-cat-meta">{meds} medicine{'s' if meds != 1 else ''}</div>
                    <div class="ma-cat-units" style="color:{ucolor};">
                        {units:,} units
                    </div>
                </div>
                """, unsafe_allow_html=True)

                if st.button("Open →", key=f"cat_{cname}", use_container_width=True):
                    st.session_state["cust_cat_selected"] = cname
                    st.rerun()


