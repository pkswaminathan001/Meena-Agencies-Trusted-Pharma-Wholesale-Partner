# CATEGORY DETAIL (Level 2 — Amazon product tiles)
# ═══════════════════════════════════════════════════════════
def render_category_detail(category: str):
    inv = _load_inventory()
    if inv.empty:
        st.error("Inventory not loaded.")
        return

    # Filter inventory by category
    filtered = inv[inv["medicine_name"].astype(str).apply(_infer_category) == category]

    c1, c2 = st.columns([1, 4])
    with c1:
        if st.button("← Categories", key="back_to_cats", use_container_width=True):
            st.session_state["cust_cat_selected"] = None
            st.rerun()
    with c2:
        st.markdown(f"### {_category_icon(category)} {category}")
    # Search inside category (before grouping)
    search = st.text_input("🔍 Search in this category",
                          placeholder="Type a name…",
                          key="cat_search",
                          label_visibility="collapsed")
    if search and len(search) >= 2:
        filtered = filtered[filtered["medicine_name"].astype(str)
                           .str.contains(search, case=False, na=False)]

    if len(filtered) == 0:
        st.info("No medicines found.")
        return

    # ── GROUP BY MEDICINE ──
    import pandas as _pd
    filtered = filtered.copy()
    filtered["_qty"] = filtered["quantity"].apply(lambda x: int(float(x or 0)))
    grouped = {}
    for name, grp in filtered.groupby("medicine_name"):
        name = str(name)
        # Sort by expiry ascending to find FIFO batch
        grp = grp.sort_values("expiry_date")
        in_stock = grp[grp["_qty"] > 0]
        first_batch = in_stock.iloc[0] if len(in_stock) > 0 else grp.iloc[0]
        total_qty = int(grp["_qty"].sum())
        # Flat price
        fallback = float(first_batch.get("selling_price", 0) or 0)
        price = _flat_price(name, fallback)
        grouped[name] = {
            "name": name,
            "total_qty": total_qty,
            "batch": str(first_batch.get("batch", "") or first_batch.get("batch_number", "")),
            "price": price,
            "batch_count": len(grp),
            "medicine_for_cart": name,
        }

    st.caption(f"{len(grouped)} unique medicine{'s' if len(grouped) != 1 else ''}")

    # ── Med cards — 4 per row (one per MEDICINE, not per batch) ──
    _items = list(grouped.values())
    for i in range(0, len(_items), 4):
        cols = st.columns(4)
        for j, _m in enumerate(_items[i:i+4]):
            med = _m["name"]
            qty = _m["total_qty"]
            price = _m["price"]
            batch = _m["batch"]
            icon = _med_icon(med)

            if qty == 0:
                stock = '<span style="color:#ff5252;">❌ Out of stock</span>'
            elif qty < 20:
                stock = f'<span style="color:#ffc107;">⚠️ Only {qty} left</span>'
            else:
                stock = f'<span style="color:#00d47a;">✅ {qty:,} in stock</span>'

            with cols[j]:
                _supplier = _m.get("supplier", "") or _m.get("brand", "")
                _supplier_html = f'<div style="color:#7b61ff;font-size:0.68rem;font-weight:600;margin-top:2px;">🏭 {_supplier}</div>' if _supplier else ''
                st.markdown(f"""
                <div class="ma-med-card">
                    <div class="ma-med-icon">{icon}</div>
                    <div class="ma-med-name">{med}</div>
                    {_supplier_html}
                    <div class="ma-med-price">₹{price:,.0f}</div>
                    <div class="ma-med-batch" style="color:#8892b0;font-size:0.68rem;margin-top:4px;">{_m['batch_count']} batch{'es' if _m['batch_count'] != 1 else ''}</div>
                    <div class="ma-med-stock">{stock}</div>
                </div>
                """, unsafe_allow_html=True)

                qcol, bcol = st.columns([1, 2])
                with qcol:
                    qty_in = st.number_input("Qty", min_value=1, value=1, step=1,
                                            key=f"cqty_{i}_{j}_{med[:10]}",
                                            label_visibility="collapsed")
                with bcol:
                    if st.button("🛒 Add", key=f"cadd_{i}_{j}_{med[:10]}",
                                 use_container_width=True,
                                 disabled=(qty == 0)):
                        _add_to_cart(med, int(qty_in), batch, price)
                        st.rerun()


def _add_to_cart(medicine, qty, batch, price):
    cart = st.session_state.get("cart", []) or []
    cart.append({
        "medicine": medicine,
        "qty": qty,
        "batch": batch,
        "price": price,
    })
    st.session_state["cart"] = cart
    st.session_state["_added_toast"] = f"{medicine} × {qty}"


