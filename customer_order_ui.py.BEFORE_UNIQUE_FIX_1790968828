# CART PAGE (Level 3 — Amazon cart)
# ═══════════════════════════════════════════════════════════
def render_cart_page(retailer):
    cart = st.session_state.get("cart", []) or []
    if not cart:
        st.info("Your cart is empty.")
        if st.button("← Back to Browse", key="empty_back"):
            st.session_state["show_cart_page"] = False
            st.rerun()
        return

    c1, c2 = st.columns([1, 5])
    with c1:
        if st.button("← Continue", key="cart_back", use_container_width=True):
            st.session_state["show_cart_page"] = False
            st.rerun()
    with c2:
        st.markdown(f"### 🛒 Shopping Cart · {len(cart)} item(s)")
    st.write("")

    left, right = st.columns([3, 1], gap="medium")

    # ═══ LEFT: Items ═══
    with left:
        for i, it in enumerate(cart):
            icon = _med_icon(it.get("medicine", ""))
            med = it.get("medicine", "?")
            batch = it.get("batch", "—")
            price = float(it.get("price", 0) or 0)
            qty = int(it.get("qty", 1) or 1)
            line = qty * price

            st.markdown(f"""
            <div class="ma-cart-row">
                <div class="ma-cart-icon">{icon}</div>
                <div class="ma-cart-info">
                    <div class="ma-cart-name">{med}</div>
                    <div class="ma-cart-batch">Batch {batch} · ₹{price:,.2f} each</div>
                </div>
                <div class="ma-cart-qty">× {qty}</div>
                <div class="ma-cart-price">₹{line:,.2f}</div>
            </div>
            """, unsafe_allow_html=True)

            # Qty controls
            qc1, qc2, qc3 = st.columns([1, 1, 4])
            with qc1:
                if st.button("−", key=f"cminus_{i}", use_container_width=True):
                    if qty > 1:
                        cart[i]["qty"] = qty - 1
                        st.session_state["cart"] = cart
                        st.rerun()
            with qc2:
                if st.button("+", key=f"cplus_{i}", use_container_width=True):
                    cart[i]["qty"] = qty + 1
                    st.session_state["cart"] = cart
                    st.rerun()
            with qc3:
                if st.button("🗑️ Remove", key=f"cremove_{i}", use_container_width=True):
                    cart.pop(i)
                    st.session_state["cart"] = cart
                    st.rerun()

    # ═══ RIGHT: Summary ═══
    with right:
        subtotal = sum(int(it.get("qty", 1)) * float(it.get("price", 0) or 0) for it in cart)
        total_qty = sum(int(it.get("qty", 1)) for it in cart)

        st.markdown(f"""
        <div class="ma-summary">
            <div class="ma-summary-title">Order Summary</div>
            <div class="ma-summary-row">
                <span>Subtotal ({total_qty} units)</span>
                <span>₹{subtotal:,.2f}</span>
            </div>
            <div class="ma-summary-row discount">
                <span>Tier discount</span>
                <span>Applied at checkout</span>
            </div>
            <div class="ma-summary-row total">
                <span>TOTAL</span>
                <span>₹{subtotal:,.2f}</span>
            </div>
        </div>
        """, unsafe_allow_html=True)

        st.write("")
        location = st.text_input("📍 Delivery",
                                 value=retailer.get("address", ""),
                                 key="cart_delivery_loc")

        if st.button("📤 Place Order (Get OTP)", key="cart_place_order",
                     use_container_width=True, type="primary"):
            _create_pending_order(cart, retailer, location, subtotal)
            st.rerun()


def _create_pending_order(cart, retailer, location, total):
    """Create order + send OTP flow (existing flow)."""
    import notify_pro
    from security import check_rate, gen_otp
    from datetime import datetime

    allowed, remaining = check_rate(retailer["id"])
    if not allowed:
        st.error("🚫 Too many OTP requests. Wait 1 hour.")
        return

    otp = gen_otp()
    order_id = f"ORD-{datetime.now().strftime('%Y%m%d%H%M%S')}-{random.randint(100,999)}"
    order = {
        "order_id": order_id,
        "retailer_id": retailer["id"],
        "shop": retailer["shop"],
        "items": cart,
        "total": float(total),
        "status": "Awaiting OTP",
        "placed_at": datetime.now().strftime("%d-%b-%Y %H:%M").upper(),
        "location": location.strip(),
        "source": "app",
    }
    st.session_state.pending_order = {"otp": otp, "order": order}

    otp_msg = notify_pro.format_otp(order, otp)
    notify_pro.notify_retailer(retailer, otp_msg, prefer_sms=False)

    st.session_state["show_cart_page"] = False
    st.success(f"📤 OTP sent for order {order_id}")


