# ═══════════════════════════════════════════════════════════
import json as _json
from pathlib import Path as _Path

_FLAT_PRICES = {}
try:
    _pf = _Path("product_prices.json")
    if _pf.exists():
        _FLAT_PRICES = _json.loads(_pf.read_text())
except Exception:
    pass


def _flat_price(medicine_name: str, fallback: float = 0.0) -> float:
    """Return flat sell price from product_prices.json or fallback."""
    entry = _FLAT_PRICES.get(str(medicine_name).strip())
    if entry:
        return float(entry.get("sell", fallback))
    return fallback



def _load_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return default if default is not None else []


def _save_json(p, data):
    try:
        Path(p).write_text(json.dumps(data, indent=2))
    except Exception:
        pass


def _load_inventory():
    """Load inventory from SQLite (fallback to CSV)."""
    try:
        import sqlite3
        conn = sqlite3.connect("inventory.db")
        df = pd.read_sql("SELECT * FROM inventory", conn)
        conn.close()
        return df
    except Exception:
        try:
            return pd.read_csv("inventory.csv")
        except Exception:
            return pd.DataFrame()


def _med_icon(med: str) -> str:
    if not med:
        return "💊"
    n = str(med).lower()
    if any(k in n for k in ["inject", "insulin", "vial", "syringe", "glargine"]): return "💉"
    if any(k in n for k in ["syrup", "susp", "liquid", "drops"]): return "🧴"
    if any(k in n for k in ["powder", "sachet", "granules", "ors"]): return "🥄"
    if any(k in n for k in ["inhaler", "respule", "rotacap"]): return "💨"
    if any(k in n for k in ["cream", "ointment", "gel", "lotion"]): return "🧴"
    if any(k in n for k in ["eye", "ear", "nasal"]): return "👁️"
    if any(k in n for k in ["vitamin", "calcium", "zinc", "iron", "folic"]): return "🌱"
    if any(k in n for k in ["cardiac", "amlodipine", "telmisartan", "losartan", "statin"]): return "❤️"
    if any(k in n for k in ["diabet", "metformin", "glimepiride", "insulin"]): return "🩸"
    if any(k in n for k in ["amoxi", "azithro", "cef", "cipro", "doxy", "penicill"]): return "🦠"
    if any(k in n for k in ["dolo", "para", "ibupro", "diclof", "pain", "aspirin"]): return "🩹"
    if any(k in n for k in ["cetiri", "lorat", "fexo", "montelu", "allergy"]): return "🤧"
    if any(k in n for k in ["pantop", "omepra", "gastro", "acidity", "antacid"]): return "🫃"
    if any(k in n for k in ["cough", "cold", "flu", "fever"]): return "🤒"
    return "💊"


def _infer_category(med: str) -> str:
    if not med: return "Other"
    n = str(med).lower()
    if any(k in n for k in ["amoxi", "azithro", "cef", "cipro", "doxy", "penicill", "antibiotic"]): return "Antibiotic"
    if any(k in n for k in ["dolo", "para", "ibupro", "diclof", "aspirin", "pain", "nimesulide"]): return "Pain Relief"
    if any(k in n for k in ["cardiac", "amlodipine", "telmisartan", "losartan", "statin", "atorva"]): return "Cardiac"
    if any(k in n for k in ["diabet", "metformin", "glimepiride", "insulin", "glargine"]): return "Diabetes"
    if any(k in n for k in ["pantop", "omepra", "gastro", "acidity", "antacid", "rabepra"]): return "Gastro"
    if any(k in n for k in ["cetiri", "lorat", "fexo", "montelu", "allergy"]): return "Allergy"
    if any(k in n for k in ["inject", "vial", "ampoule", "syringe"]): return "Injection"
    if any(k in n for k in ["syrup", "susp", "suspension", "liquid"]): return "Syrup"
    if any(k in n for k in ["inhaler", "respule", "rotacap", "asthma"]): return "Inhaler"
    if any(k in n for k in ["powder", "sachet", "ors", "granules"]): return "Powder"
    if any(k in n for k in ["cream", "ointment", "gel", "derma", "soap"]): return "Derma"
    if any(k in n for k in ["vitamin", "calcium", "zinc", "iron", "folic"]): return "Vitamins"
    if any(k in n for k in ["cough", "cold", "flu", "fever", "benadryl"]): return "Cold & Cough"
    return "Other"


def _category_icon(cat: str) -> str:
    return {
        "Antibiotic": "🦠", "Pain Relief": "💊", "Cardiac": "❤️",
        "Diabetes": "🩸", "Gastro": "🫃", "Allergy": "🤧",
        "Injection": "💉", "Syrup": "🧴", "Inhaler": "💨",
        "Powder": "🥄", "Derma": "🧼", "Vitamins": "🌱",
        "Cold & Cough": "🤒", "Other": "💊",
    }.get(cat, "💊")


