"""
auth_gate.py — Extra security layer before the app loads.
Requires a password to even reach the login screen.
"""
import streamlit as st
import hmac


def check_password():
    """Returns True if the user has entered the correct access password."""

    def password_entered():
        try:
            expected = st.secrets["ACCESS_PASSWORD"]
        except Exception:
            # No password set — allow (dev mode)
            st.session_state["_auth_state"] = "ok"
            return
        entered = st.session_state.get("password", "")
        if entered and hmac.compare_digest(entered, expected):
            st.session_state["_auth_state"] = "ok"
            st.session_state["password_correct"] = True
        else:
            st.session_state["_auth_state"] = "wrong"
            st.session_state["password_correct"] = False

    # Already authenticated?
    if st.session_state.get("password_correct") is True:
        return True

    # Show header
    st.markdown("""
    <div style="max-width:420px;margin:80px auto;padding:32px;
                background:linear-gradient(135deg,#0e1d4a,#1a2a55);
                border-radius:16px;border:1px solid #00d4ff33;
                text-align:center;">
        <h2 style="color:#eaf6ff;margin:0 0 8px 0;">🔒 Meena Agencies</h2>
        <p style="color:#8892b0;font-size:0.9rem;margin:0;">
            Authorised access only
        </p>
    </div>
    """, unsafe_allow_html=True)

    # Password input
    st.text_input(
        "Access Password",
        type="password",
        key="password",
        on_change=password_entered,
    )

    # Only show error if user actually tried (not on first load)
    if st.session_state.get("_auth_state") == "wrong":
        st.error("❌ Wrong password")

    return False
