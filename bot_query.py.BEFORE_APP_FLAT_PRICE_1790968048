_PRICE_CACHE = None

def get_flat_price(medicine_name: str):
    """
    Return (sell_price, mrp) for a medicine from product_prices.json.
    Falls back to median(cost*1.25) if not in the file.
    Returns (None, None) if truly unknown.
    """
    global _PRICE_CACHE
    try:
        if _PRICE_CACHE is None:
            import json
            pf = Path("product_prices.json")
            _PRICE_CACHE = json.loads(pf.read_text()) if pf.exists() else {}
        entry = _PRICE_CACHE.get(str(medicine_name).strip())
        if entry:
            return (float(entry.get("sell", 0)), float(entry.get("mrp", 0)))
    except Exception:
        pass
    return (None, None)


def reload_prices():
    """Force reload of product_prices.json."""
    global _PRICE_CACHE
    _PRICE_CACHE = None

