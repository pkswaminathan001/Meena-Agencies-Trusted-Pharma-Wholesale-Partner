def customer_context(retailer: dict) -> str:
    """Context for a specific retailer — only THEIR data. NO batch info ever."""
    if not retailer:
        return "Customer not identified."

    orders = _load_json("orders.json", [])
    r_orders = [o for o in orders if o.get("retailer_id") == retailer["id"]]
    recent = sorted(r_orders, key=lambda o: o.get("placed_at", ""), reverse=True)[:5]

    lines = [
        f"CUSTOMER: {retailer.get('shop','?')}",
        f"Owner: {retailer.get('owner','—')}",
        f"Credit limit: {_fmt_money(retailer.get('credit_limit',0))}",
        f"Outstanding: {_fmt_money(retailer.get('outstanding',0))}",
        f"Available credit: {_fmt_money(retailer.get('credit_limit',0) - retailer.get('outstanding',0))}",
        "",
        f"RECENT ORDERS ({len(recent)}):",
    ]
    for o in recent:
        lines.append(
            f"• {o.get('order_id','?')} · {_fmt_money(o.get('total',0))} · "
            f"{o.get('status','?')} · {o.get('placed_at','?')}"
        )

    pending = [o for o in r_orders if o.get("status") in ("Pending", "Awaiting OTP")]
    if pending:
        lines.append("")
        lines.append(f"PENDING ({len(pending)}):")
        for o in pending:
            lines.append(f"• {o.get('order_id','?')} · {_fmt_money(o.get('total',0))}")

    return "\n".join(lines)



def customer_stock_query(query: str) -> str:
    """
    Show ALL variants matching the query.
    Each variant = unique medicine_name. Numbered list for easy selection.
    Pure ASCII. No batches, no expiry.
    """
    inv = _load_inventory()
    if inv is None or len(inv) == 0:
        return "Stock data temporarily unavailable."
    try:
        match = inv[inv["medicine_name"].astype(str)
                   .str.contains(query, case=False, na=False)]
        if len(match) == 0:
            return f"No medicine found matching '{query}'."

        # Group by FULL medicine_name (this keeps variants separate)
        grouped = {}
        for _, row in match.iterrows():
            name = str(row.get("medicine_name", "?")).strip()
            qty = int(row.get("quantity", 0) or 0)
            if qty <= 0:
                continue
            price = float(row.get("selling_price", 0) or row.get("price", 0) or 0)
            mrp = float(row.get("mrp", price * 1.3) or 0)

            if name not in grouped:
                grouped[name] = {"qty": 0, "prices": [], "mrps": []}
            grouped[name]["qty"] += qty
            if price > 0:
                grouped[name]["prices"].append(price)
            if mrp > 0:
                grouped[name]["mrps"].append(mrp)

        if not grouped:
            return f"No in-stock items for '{query}'."

        import statistics

        # Sort variants by name (alphabetical)
        sorted_variants = sorted(grouped.items(), key=lambda x: x[0])

        lines = [f"Found {len(sorted_variants)} variant(s) for '{query}':", ""]

        for i, (name, info) in enumerate(sorted_variants, 1):
            prices = sorted(info["prices"])
            rep_price = statistics.median(prices) if prices else 0
            lines.append(
                f"  {i}. {name} | {info['qty']:,} units | Rs.{rep_price:,.0f}"
            )

        lines.append("")
        if len(sorted_variants) == 1:
            lines.append(f"Reply 'order' to place an order for this item.")
        else:
            lines.append(f"Reply with the number (1-{len(sorted_variants)}) to select.")

        return "\n".join(lines)
    except Exception as e:
        return f"Search error: {e}"



def customer_price_query(query: str) -> str:
    """Price lookup."""
    return customer_stock_query(query)


