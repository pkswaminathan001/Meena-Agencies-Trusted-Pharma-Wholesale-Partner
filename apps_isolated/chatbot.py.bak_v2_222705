"""
chatbot.py — FAST Telegram chatbot for Meena Agencies
Optimized for instant replies. Uses AI only for complex queries.
"""
import json, os, sys, time, traceback, urllib.request, urllib.parse, re
from datetime import datetime
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor

PARENT = Path(__file__).parent.parent
ENV_FILE = Path.home() / ".config" / "meena" / ".env"
LOG_FILE = PARENT / "chatbot.log"
STATE_FILE = PARENT / "chatbot_state.json"

# Speed settings
POLL_TIMEOUT = 10
AI_TIMEOUT = 15
AI_MODEL = "openai/gpt-oss-20b"   # Faster than gpt-oss-120b


def log(msg):
    try:
        ts = datetime.now().strftime("%d-%b-%Y %H:%M:%S")
        with open(LOG_FILE, "a") as f:
            f.write(f"[{ts}] {msg}\n")
    except Exception:
        pass


def load_env():
    env = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().split("\n"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def load_json(path, default):
    if Path(path).exists():
        try:
            return json.loads(Path(path).read_text())
        except Exception:
            return default
    return default


def save_json(path, data):
    try:
        Path(path).write_text(json.dumps(data, indent=2))
    except Exception:
        pass


ENV = load_env()
TOKEN = ENV.get("TELEGRAM_BOT_TOKEN", "")
OWNER_CHAT_ID = str(ENV.get("OWNER_CHAT_ID", ""))


# ═══════════════════════════════════════════════════════
# TELEGRAM — non-blocking send
# ═══════════════════════════════════════════════════════
def tg_api(method, params=None, timeout=10):
    try:
        url = f"https://api.telegram.org/bot{TOKEN}/{method}"
        data = urllib.parse.urlencode(params or {}).encode() if params else None
        req = urllib.request.Request(url, data=data, method="POST" if data else "GET")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except Exception as e:
        log(f"tg_api {method} error: {e}")
        return None


def tg_send(chat_id, text):
    return tg_api("sendMessage", {
        "chat_id": str(chat_id),
        "text": text,
        "parse_mode": "HTML",
        "disable_web_page_preview": "true",
    })


def tg_typing(chat_id):
    """Show 'typing...' indicator immediately (fire-and-forget)."""
    tg_api("sendChatAction", {"chat_id": str(chat_id), "action": "typing"}, timeout=3)


# ═══════════════════════════════════════════════════════
# USER ROLES (with cache)
# ═══════════════════════════════════════════════════════
_ROLE_CACHE = {}

def get_user_role(chat_id):
    cid = str(chat_id)
    if cid in _ROLE_CACHE:
        return _ROLE_CACHE[cid]

    if cid == OWNER_CHAT_ID:
        result = ("owner", "Swaminathan", None)
    else:
        result = (None, None, None)
        retailers = load_json(PARENT / "retailers.json", [])
        if isinstance(retailers, dict):
            retailers = list(retailers.values())
        for r in retailers:
            if isinstance(r, dict) and str(r.get("telegram_chat_id", "")).strip() == cid:
                result = ("retailer", r.get("owner", r.get("shop", "Retailer")), r.get("id"))
                break
        else:
            reps = load_json(PARENT / "salespeople.json", [])
            if isinstance(reps, dict):
                reps = list(reps.values())
            for rep in reps:
                if isinstance(rep, dict) and str(rep.get("telegram_chat_id", "")).strip() == cid:
                    result = ("rep", rep.get("name", "Rep"), rep.get("id"))
                    break

    _ROLE_CACHE[cid] = result
    return result


# ═══════════════════════════════════════════════════════
# DATA (with short cache)
# ═══════════════════════════════════════════════════════
_CACHE = {}
_CACHE_TTL = 30  # seconds

def _cached(key, loader):
    now = time.time()
    if key in _CACHE:
        data, ts = _CACHE[key]
        if now - ts < _CACHE_TTL:
            return data
    data = loader()
    _CACHE[key] = (data, now)
    return data


def load_orders():
    def _load():
        o = load_json(PARENT / "orders.json", [])
        return o if isinstance(o, list) else list(o.values())
    return _cached("orders", _load)


def load_retailers():
    def _load():
        r = load_json(PARENT / "retailers.json", [])
        return r if isinstance(r, list) else list(r.values())
    return _cached("retailers", _load)


def money(v):
    try:
        return f"Rs.{float(v):,.2f}"
    except Exception:
        return "Rs.0.00"


# ═══════════════════════════════════════════════════════
# GROQ AI — faster model
# ═══════════════════════════════════════════════════════
def groq_ask(question, context):
    try:
        key = (PARENT / ".groq_key").read_text().strip()
        if not key:
            return None
        payload = {
            "model": AI_MODEL,
            "messages": [
                {"role": "system", "content":
                 "You are JARVIS for Meena Agencies, pharma distributor in "
                 "Tamil Nadu. Answer SHORT and specific. Max 100 words. "
                 "Use Rs. for money. Only use provided data."},
                {"role": "system", "content": "DATA:\n" + context},
                {"role": "user", "content": question},
            ],
            "temperature": 0.3,
            "max_tokens": 250,
        }
        req = urllib.request.Request(
            "https://api.groq.com/openai/v1/chat/completions",
            data=json.dumps(payload).encode(),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
                "User-Agent": "Meena-Chatbot/2.0",
            },
        )
        with urllib.request.urlopen(req, timeout=AI_TIMEOUT) as resp:
            d = json.loads(resp.read())
            return d["choices"][0]["message"]["content"].strip()
    except Exception as e:
        log(f"groq error: {e}")
        return None


def build_context():
    orders = load_orders()
    rets = load_retailers()
    lines = [f"Orders: {len(orders)}"]
    pending = [o for o in orders if (o.get("status") or "").lower() == "pending"]
    lines.append(f"Pending: {len(pending)}")
    lines.append("Retailers:")
    for r in rets:
        if not isinstance(r, dict):
            continue
        lines.append(
            f"- {r.get('shop','?')} ({r.get('id','?')}): "
            f"outstanding Rs.{float(r.get('outstanding') or 0):,.0f}, "
            f"limit Rs.{float(r.get('credit_limit') or 0):,.0f}, "
            f"status={r.get('status','Active')}"
        )
    return "\n".join(lines)


# ═══════════════════════════════════════════════════════
# FAST KEYWORD MATCHER (no AI for these)
# ═══════════════════════════════════════════════════════
def match_owner_intent(text):
    """Return (intent, handler) if a rule matches. Otherwise (None, None)."""
    t = text.strip().lower()

    if t in ("hi", "hello", "start", "/start", "vanakkam"):
        return "greet"
    if "pending" in t:
        return "pending"
    if t in ("retailers", "list retailers", "shops"):
        return "retailers"
    if "brief" in t or "summary" in t:
        return "brief"
    if "how is business" in t or t == "business":
        return "brief"
    return None


def owner_reply(intent, text):
    if intent == "greet":
        return (
            "🙏 <b>Vanakkam Swaminathan!</b>\n\n"
            "<b>Quick commands:</b>\n"
            "• pending\n"
            "• retailers\n"
            "• brief\n\n"
            "<i>Or ask anything in natural language.</i>"
        )

    if intent == "pending":
        orders = load_orders()
        pending = [o for o in orders if (o.get("status") or "").lower() == "pending"]
        if not pending:
            return "✅ No pending orders."
        lines = [f"⏳ <b>{len(pending)} pending:</b>\n"]
        for o in pending[:8]:
            lines.append(
                f"• <b>{o.get('order_id','?')}</b>\n"
                f"  {o.get('shop','?')} · {money(o.get('total',0))}"
            )
        return "\n".join(lines)

    if intent == "retailers":
        rets = load_retailers()
        lines = [f"🏪 <b>{len(rets)} retailers:</b>\n"]
        for r in rets:
            if not isinstance(r, dict):
                continue
            out = float(r.get("outstanding") or 0)
            lim = float(r.get("credit_limit") or 0)
            pct = (out / lim * 100) if lim else 0
            emoji = "🔴" if pct >= 90 else ("🟠" if pct >= 60 else "🟢")
            lines.append(f"{emoji} <b>{r.get('shop','?')}</b>\n   {money(out)} ({pct:.0f}%)")
        return "\n".join(lines)

    if intent == "brief":
        orders = load_orders()
        pending = [o for o in orders if (o.get("status") or "").lower() == "pending"]
        rets = load_retailers()
        total_out = sum(float(r.get("outstanding") or 0) for r in rets if isinstance(r, dict))
        return (
            f"📊 <b>Brief — {datetime.now().strftime('%d-%b')}</b>\n\n"
            f"📦 {len(orders)} orders ({len(pending)} pending)\n"
            f"💰 Outstanding: {money(total_out)}\n"
            f"🏪 {len(rets)} retailers"
        )

    return None


# ═══════════════════════════════════════════════════════
# HANDLERS
# ═══════════════════════════════════════════════════════
def handle_owner(chat_id, text):
    # Fast path — rule-based
    intent = match_owner_intent(text)
    if intent:
        return owner_reply(intent, text)
    # Slow path — AI
    return groq_ask(text, build_context())


def handle_retailer(chat_id, text, name, retailer_id):
    t = text.strip().lower()

    retailers = load_retailers()
    me = next((r for r in retailers
               if isinstance(r, dict) and str(r.get("id","")).upper() == str(retailer_id).upper()),
              {})

    if t in ("hi", "hello", "start", "/start", "vanakkam"):
        out = float(me.get("outstanding") or 0)
        lim = float(me.get("credit_limit") or 0)
        return (
            f"🙏 <b>Vanakkam {name}!</b>\n\n"
            f"💰 Outstanding: <b>{money(out)}</b>\n"
            f"💳 Available: <b>{money(lim - out)}</b>\n\n"
            f"Reply: <b>bills</b> · <b>balance</b> · <b>order</b>"
        )

    if t in ("bills", "orders", "my bills"):
        mine = [o for o in load_orders()
                if str(o.get("retailer_id","")).upper() == str(retailer_id).upper()]
        if not mine:
            return "No orders yet."
        lines = [f"🧾 <b>Last {min(len(mine),5)} orders:</b>\n"]
        for o in mine[-5:][::-1]:
            s = (o.get("status") or "").lower()
            e = {"pending":"⏳","approved":"✅","delivered":"🎉","cancelled":"❌"}.get(s,"•")
            lines.append(f"{e} {o.get('order_id','?')} · {money(o.get('total',0))}")
        return "\n".join(lines)

    if t in ("balance", "ledger", "outstanding"):
        out = float(me.get("outstanding") or 0)
        lim = float(me.get("credit_limit") or 0)
        return (
            f"💰 <b>Your Ledger</b>\n\n"
            f"Limit:  <b>{money(lim)}</b>\n"
            f"Owed:   <b>{money(out)}</b>\n"
            f"Available: <b>{money(lim - out)}</b>"
        )

    if t in ("order", "place order", "new order"):
        return (
            "🛒 <b>Place order:</b>\n\n"
            "1. Open: http://localhost:8501\n"
            f"2. Login: {retailer_id}\n"
            "3. Add items → Request OTP"
        )

    return f"Vanakkam {name}! Reply: <b>bills</b> · <b>balance</b> · <b>order</b>"


def handle_rep(chat_id, text, name, rep_id):
    fwd = (
        f"👤 <b>Rep Message</b>\n\n"
        f"<b>From:</b> {name} ({rep_id})\n"
        f"<b>Time:</b> {datetime.now().strftime('%d-%b %H:%M')}\n"
        f"<b>Text:</b> {text}"
    )
    tg_send(OWNER_CHAT_ID, fwd)
    return "✅ Sent to owner."


def handle_unknown(chat_id, text):
    return (
        "🙏 <b>Vanakkam!</b>\n\n"
        "This bot is for Meena Agencies partners.\n"
        "📞 Register: +91 63821 30536"
    )


def route_message(chat_id, text):
    role, name, rid = get_user_role(chat_id)
    if role == "owner":
        return handle_owner(chat_id, text)
    elif role == "retailer":
        return handle_retailer(chat_id, text, name, rid)
    elif role == "rep":
        return handle_rep(chat_id, text, name, rid)
    else:
        return handle_unknown(chat_id, text)


# ═══════════════════════════════════════════════════════
# MESSAGE PROCESSOR (runs in thread)
# ═══════════════════════════════════════════════════════
def process_one(update):
    """Process a single update in a worker thread."""
    try:
        msg = update.get("message") or update.get("edited_message") or {}
        chat = msg.get("chat", {})
        chat_id = chat.get("id")
        text = msg.get("text") or msg.get("caption") or ""
        if not chat_id or not text:
            return

        # Fire typing indicator IMMEDIATELY
        tg_typing(chat_id)

        # Then process
        reply = route_message(chat_id, text)
        if reply:
            tg_send(chat_id, reply)
            log(f"Replied to {chat_id}: {text[:30]!r}")
    except Exception as e:
        log(f"process error: {e}\n{traceback.format_exc()}")


# ═══════════════════════════════════════════════════════
# MAIN LOOP — non-blocking
# ═══════════════════════════════════════════════════════
def main():
    if not TOKEN:
        print("❌ No token"); sys.exit(1)

    print("═" * 50)
    print("  Meena Agencies — FAST Chatbot v2")
    print("═" * 50)
    print(f"  Model: {AI_MODEL}")
    print(f"  Poll timeout: {POLL_TIMEOUT}s")
    print(f"  Log: {LOG_FILE}")
    print("═" * 50)

    state = load_json(STATE_FILE, {"offset": 0})
    offset = state.get("offset", 0)

    # Skip old messages on startup
    first = tg_api("getUpdates", {"timeout": 0})
    if first and first.get("result"):
        last = max(u.get("update_id", 0) for u in first["result"])
        offset = last + 1
        save_json(STATE_FILE, {"offset": offset})

    print(f"  ✅ Listening (from offset {offset})")
    print("═" * 50)

    executor = ThreadPoolExecutor(max_workers=4)
    backoff = 1

    while True:
        try:
            r = tg_api("getUpdates", {
                "offset": offset,
                "timeout": POLL_TIMEOUT,
            }, timeout=POLL_TIMEOUT + 10)

            if not r or not r.get("ok"):
                time.sleep(backoff)
                backoff = min(backoff * 2, 30)
                continue

            backoff = 1

            for u in r.get("result", []):
                executor.submit(process_one, u)
                offset = u.get("update_id", offset) + 1
                save_json(STATE_FILE, {"offset": offset})

            # NO sleep — immediately poll again

        except KeyboardInterrupt:
            print("\n👋 Stopped")
            break
        except Exception as e:
            log(f"Loop error: {e}")
            time.sleep(min(30, backoff))
            backoff = min(backoff * 2, 30)


if __name__ == "__main__":
    main()
