def main():
    if "retailer" not in st.session_state:
        login_screen()
        return

    r = st.session_state.retailer
    st.session_state.setdefault("page", "home")
    render_sidebar()

    page = st.session_state.page
    if page == "home":        page_home(r)
    elif page == "order":     page_order(r)
    elif page == "stock":     page_stock(r)
    else:
        # try external module first
        try:
            import importlib
            rp = importlib.import_module("retailer_pages")
            fn = getattr(rp, f"render_{page}", None)
            if fn:
                fn(r); return
        except Exception:
            pass
        label = next((m[2] for m in MENU if m[0] == page), page.title())
        icon  = next((m[1] for m in MENU if m[0] == page), "⏳")
        page_placeholder(r, label, icon)


main()
