    row = st.columns(min(len(cats), 6))
    for i, cat in enumerate(cats):
        with row[i % len(row)]:
            active = st.session_state.order_cat == cat
            if st.button(
                f"{'✅ ' if active else ''}{cat}",
                key=f"cat_{cat}",
                use_container_width=True,
                type="primary" if active else "secondary",
            ):
                st.session_state.order_cat = cat
                st.rerun()

    # ── Filter ──
    view = df.copy()
    if st.session_state.order_cat != "All":
        view = view[view["cat"] == st.session_state.order_cat]
    if q:
        view = view[view["name"].str.lower().str.contains(q, na=False)]

    if sort_by == "Price ↑":
        view = view.sort_values("price")
    elif sort_by == "Price ↓":
        view = view.sort_values("price", ascending=False)
    elif sort_by == "Stock ↑":
        view = view.sort_values("stock")

    st.caption(f"**{len(view)}** medicine(s) · {int(view['stock'].sum()):,} units in stock")

    # ── Card grid (3 columns on desktop, stacks on mobile via CSS) ──
