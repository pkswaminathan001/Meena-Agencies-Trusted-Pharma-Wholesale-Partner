def render_sidebar():
    with st.sidebar:
        st.markdown(f'<div style="padding:0.8rem 0;">{logo_html(52)}</div>',
                    unsafe_allow_html=True)
        st.markdown("**Meena Agencies**")
        st.caption(st.session_state.get("retailer_id", ""))
        st.markdown("---")

        cur = st.session_state.get("page", "home")
        for k, ic, lbl in MENU:
            is_active = (k == cur)
            if st.button(f"{ic}  {lbl}", key=f"nav_{k}",
                         use_container_width=True,
                         type="primary" if is_active else "secondary"):
                st.session_state.page = k
                st.rerun()

        st.markdown("---")
        if st.button("🚪  Sign Out", key="nav_out", use_container_width=True):
            st.session_state.clear()
            st.rerun()


def main():
    if "retailer" not in st.session_state:
        login_screen()
        return

    r = st.session_state.retailer
    st.session_state.setdefault("page", "home")
    render_sidebar()

    page = st.session_state.page
    if page == "home":        page_home(r)
    elif page == "order":     page_order(r)
    elif page == "stock":     page_stock(r)
    else:
        # try external module first
        try:
            import importlib
            rp = importlib.import_module("retailer_pages")
            fn = getattr(rp, f"render_{page}", None)
            if fn:
                fn(r); return
        except Exception:
            pass
        label = next((m[2] for m in MENU if m[0] == page), page.title())
        icon  = next((m[1] for m in MENU if m[0] == page), "⏳")
        page_placeholder(r, label, icon)


main()
