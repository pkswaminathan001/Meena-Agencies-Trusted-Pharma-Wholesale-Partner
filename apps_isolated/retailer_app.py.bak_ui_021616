def page_order(r):
    st.markdown("## 🛒 Place Order")
    st.caption("Search or browse medicines. Add to cart and submit.")
    df = load_inventory()
    if df.empty:
        st.warning("Inventory not available."); return

    name_col = find_col(df, "medicine_name","medicine","name","product","product_name","item")
    price_col = find_col(df, "cost_price","price","mrp","rate","selling_price","unit_price")
    stock_col = find_col(df, "quantity","stock","qty","available","on_hand")

    if not name_col:
        st.error("Inventory has no product column.")
        with st.expander("🔍 Debug — see what's in inventory.csv"):
            st.write("**Columns detected:**", list(df.columns))
            st.write("**Row count:**", len(df))
            st.write("**Sample row:**")
            st.dataframe(df.head(3))
        return


    q = st.text_input("Search medicine", placeholder="e.g. Dolo, ORS",
                      key="oq").strip().lower()
    view = df.copy()
    if q:
        view = view[view[name_col].astype(str).str.lower().str.contains(q, na=False)]
    st.caption(f"{len(view)} medicine(s)")

    if "cart" not in st.session_state:
        st.session_state.cart = []

    for idx, (_, row) in enumerate(view.head(50).iterrows()):
        nm = str(row[name_col])
        try: pr = float(row[price_col]) if price_col and pd.notna(row[price_col]) else 0.0
        except Exception: pr = 0.0
        try: stk = int(row[stock_col]) if stock_col and pd.notna(row[stock_col]) else 0
        except Exception: stk = 0
        safe = "".join(c for c in nm if c.isalnum())[:15]
        uniq = f"{idx}_{safe}"

        c1, c2, c3 = st.columns([5, 2, 2])
        c1.markdown(f"**{nm}**")
        c2.markdown(f"₹{pr:.2f}")
        with c3:
            if stk > 0:
                if st.button(f"Add ({stk})", key=f"add_{uniq}", use_container_width=True):
                    st.session_state.cart.append({"name": nm, "price": pr, "qty": 1})
                    st.toast(f"Added {nm}")
            else:
                st.button("Out of stock", key=f"oos_{uniq}",
                          disabled=True, use_container_width=True)

    if st.session_state.cart:
        st.markdown("### 🧺 Cart")
        total = 0.0
        for i, it in enumerate(list(st.session_state.cart)):
            total += it["price"] * it["qty"]
            cc1, cc2, cc3 = st.columns([5, 3, 1])
            cc1.write(it["name"])
            cc2.write(f"₹{it['price']:.2f} × {it['qty']}")
            if cc3.button("✕", key=f"rm_{i}"):
                st.session_state.cart.pop(i); st.rerun()
        st.markdown(f"**Total: ₹{total:.2f}**")
        if st.button("✅ Submit Order", type="primary"):
            st.success(f"Order placed! ₹{total:.2f}")
            st.session_state.cart = []


