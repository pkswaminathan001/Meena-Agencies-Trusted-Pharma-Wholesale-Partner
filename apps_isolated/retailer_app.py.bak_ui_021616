def logo_html(h: int = 40) -> str:
    p = Path(__file__).parent / "static" / "logo.png"
    if p.exists():
        b64 = base64.b64encode(p.read_bytes()).decode()
        return f'<img src="data:image/png;base64,{b64}" style="height:{h}px;" alt="Meena">'
    return "🦚"


def find_col(df, *cands):
    cols = list(df.columns)
    for c in cands:
        if c in cols: return c
    lower = {str(c).lower(): c for c in cols}
    for c in cands:
        if c.lower() in lower: return lower[c.lower()]
    return None


@st.cache_data(ttl=5)
def load_inventory() -> pd.DataFrame:
    for p in (PARENT / "inventory.csv", Path("inventory.csv")):
        if p.exists():
            try:
                df = pd.read_csv(p)
                df.columns = [c.strip().lower() for c in df.columns]
                return df
            except Exception: pass
    return pd.DataFrame()


@st.cache_data(ttl=60)
def load_retailers() -> pd.DataFrame:
    import json as _json
    # JSON first
    for p in (PARENT / "retailers.json", Path("retailers.json")):
        if p.exists():
            try:
                data = _json.loads(p.read_text())
                if isinstance(data, dict):
                    data = list(data.values())
                return pd.DataFrame(data)
            except Exception: pass
    # CSVs
    for name in ("retailers.csv","retailer_master.csv","users.csv","credentials.csv"):
        for base in (PARENT, Path(".")):
            p = base / name
            if p.exists():
                try: return pd.read_csv(p)
                except Exception: pass
    return pd.DataFrame()


# ────────── LOGIN ──────────
def login_screen():
    _, mid, _ = st.columns([1, 2, 1])
    with mid:
        st.markdown(
            f'<div style="text-align:center;margin:2rem 0 1rem;">{logo_html(80)}</div>',
            unsafe_allow_html=True)
        st.markdown(
            '<h2 style="text-align:center;color:#0e7490;margin-bottom:0;">Meena Agencies</h2>',
            unsafe_allow_html=True)
        st.markdown(
            '<p style="text-align:center;color:#6b7280;margin-top:0;">Retailer Portal</p>',
            unsafe_allow_html=True)
        st.markdown("---")

        with st.form("login_form"):
            rid = st.text_input("Retailer ID", placeholder="e.g. RET001")
            pin = st.text_input("PIN", type="password", placeholder="4-digit PIN")
            ok = st.form_submit_button("Sign In", use_container_width=True)

        if not ok:
            return

        if not rid or not pin:
            st.error("Enter both Retailer ID and PIN.")
            return

        users = load_retailers()
        if users.empty:
            st.error("User database not found.")
            return

        id_col = find_col(users, "retailer_id","id","code","user_id","username")
        pin_col = find_col(users, "pin_hash","pin","password","passcode")
        name_col = find_col(users, "name","firm_name","retailer_name")

        if not id_col or not pin_col:
            st.error(f"Columns wrong. Found: {list(users.columns)}")
            return

        users["_id"]  = users[id_col].astype(str).str.strip().str.upper()
        users["_pin"] = users[pin_col].astype(str).str.strip()

        sub = users[users["_id"] == rid.strip().upper()]
        if sub.empty:
            st.error(f"Retailer {rid.upper()} not found.")
            return

        stored = sub.iloc[0]["_pin"]
        entered = pin.strip()

        # Try plain, then sha256, then sha256 of lowercase
        candidates = {
            entered,
            hashlib.sha256(entered.encode()).hexdigest(),
            hashlib.sha256(entered.lower().encode()).hexdigest(),
            hashlib.md5(entered.encode()).hexdigest(),
        }
        if stored not in candidates:
            st.error("Invalid PIN.")
            return

        user = sub.iloc[0].drop(labels=["_id","_pin"], errors="ignore").to_dict()
        st.session_state.retailer = user
        st.session_state.retailer_id = rid.strip().upper()
        st.session_state.page = "home"
        st.rerun()


