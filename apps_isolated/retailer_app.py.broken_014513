    if not retailer:
        st.error("Session expired. Please log in again.")
        st.session_state.retailer_user = None
        st.rerun()

    render_sidebar(retailer)

    page = st.session_state.retailer_page

    if page == "home":
        page_home(retailer)
    elif page == "order":
        page_order(retailer)
    elif page in ("reorder", "favorites", "stock", "ledger", "notify", "offers", "business", "contact"):
        try:
            import retailer_pages
            mapping = {
                "reorder": "render_reorder",
                "favorites": "render_favorites",
                "stock": "render_stock_check",
                "ledger": "render_ledger",
                "notify": "render_notifications",
                "offers": "render_offers",
                "business": "render_business_stats",
                "contact": "render_contact",
            }
            fn = getattr(retailer_pages, mapping[page], None)
            if fn:
                fn(retailer)
            else:
                st.warning(f"Function {mapping[page]} not found")
        except Exception as e:
            st.error(f"Error: {e}")
    else:
        # Try existing retailer_pages first
        handled = render_existing_page(page, retailer)
        if not handled:
            st.info(f"Page '{page}' — not yet wired")
            if st.button("← Home"):
                st.session_state.retailer_page = "home"
                st.rerun()
