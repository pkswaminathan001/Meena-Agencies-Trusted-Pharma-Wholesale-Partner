def render_existing_page(page_key, retailer):
    """Try to delegate to existing retailer_pages.py functions."""
    try:
        import retailer_pages
    except Exception as e:
        st.error(f"Could not import retailer_pages: {e}")
        return False

    mapping = {
        "order":     ("render_order",     None),
        "reorder":   ("render_reorder",   None),
        "bills":     ("render_bills",     None),
        "track":     ("render_track",     None),
        "cart":      ("render_cart",      None),
        "favorites": ("render_favorites", None),
        "stock":     ("render_stock",     None),
        "ledger":    ("render_ledger",    None),
        "notify":    ("render_notifications", None),
        "offers":    ("render_offers",    None),
        "business":  ("render_business",  None),
        "contact":   ("render_contact",   None),
        "profile":   ("render_profile",   None),
    }

    if page_key not in mapping:
        return False

    func_name, _ = mapping[page_key]
    func = getattr(retailer_pages, func_name, None)

    if func is None:
        st.warning(f"⚠️ `retailer_pages.{func_name}()` not found")
        st.info(f"This page will be built next. Currently showing placeholder.")
        st.caption(f"Available in retailer_pages.py: "
                   f"{[x for x in dir(retailer_pages) if x.startswith('render_')]}")
        return True

    try:
        func(retailer)
        return True
    except Exception as e:
        st.error(f"Error in {func_name}: {e}")
        import traceback
        with st.expander("Full traceback"):
            st.code(traceback.format_exc())
        return True




def page_order(retailer):
    """Place Order — reads inventory.csv directly."""
    import pandas as pd

    st.markdown("## 🛒 Place Order")
    st.caption("Search or browse. Add items to cart.")

    if "cart" not in st.session_state:
        st.session_state.cart = []

    csv_path = PARENT / "inventory.csv"
    if not csv_path.exists():
        st.error(f"❌ inventory.csv not found at {csv_path}")
        return

    try:
        df = pd.read_csv(csv_path)
    except Exception as e:
        st.error(f"❌ Could not read inventory.csv: {e}")
        return

    df["quantity"] = pd.to_numeric(df["quantity"], errors="coerce").fillna(0).astype(int)
    df["cost_price"] = pd.to_numeric(df["cost_price"], errors="coerce").fillna(0)
    df["selling_price"] = (df["cost_price"] * 1.25).round(2)

    st.success(f"✅ Loaded {len(df)} items")

    search = st.text_input("🔍 Search medicines", placeholder="e.g. Paracetamol")

    filtered = df.copy()
    if search.strip():
        filtered = filtered[filtered["medicine_name"].str.contains(search, case=False, na=False)]

    grouped = filtered.groupby("medicine_name").agg({
        "quantity": "sum",
        "selling_price": "mean",
        "batch_number": "count",
    }).reset_index().rename(columns={"batch_number": "batches"})

    st.caption(f"**{len(grouped)} unique medicines**")

    for i in range(0, len(grouped), 3):
        cols = st.columns(3)
        for j, (_, row) in enumerate(grouped.iloc[i:i+3].iterrows()):
            with cols[j]:
                _medicine_tile(row)

    if st.session_state.cart:
        st.markdown("---")
        st.markdown(f"### 🛍️ Cart ({len(st.session_state.cart)} items)")
        total = 0
        for idx, item in enumerate(st.session_state.cart):
            c1, c2, c3 = st.columns([4, 1, 1])
            with c1:
                st.markdown(f"**{item['medicine']}** — {item['qty']} × ₹{item['price']:.2f}")
            with c2:
                st.markdown(f"**₹{item['qty'] * item['price']:.2f}**")
            with c3:
                if st.button("🗑", key=f"rm_{idx}"):
                    st.session_state.cart.pop(idx)
                    st.rerun()
            total += item["qty"] * item["price"]
        st.markdown(f"### Total: **₹{total:,.2f}**")
        if st.button("✅ Submit Order", type="primary"):
            st.success("Order submitted (OTP flow coming next)")


def _medicine_tile(row):
    name = row["medicine_name"]
    qty = int(row.get("quantity", 0))
    price = float(row.get("selling_price", 0))
    batches = int(row.get("batches", 1))

    st.markdown(f"""
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:1rem;margin:0.4rem 0;">
        <div style="font-weight:700;color:#0a0e27;">{name[:35]}</div>
        <div style="color:#0091ea;font-weight:700;font-size:1.1rem;">₹{price:.2f}</div>
        <div style="color:#64748b;font-size:0.75rem;">{qty} units · {batches} batches</div>
    </div>
    """, unsafe_allow_html=True)

    qc1, qc2 = st.columns([2, 1])
    with qc2:
        q = st.number_input("Qty", min_value=1, max_value=max(1, qty), value=1, key=f"q_{name}", label_visibility="collapsed")
    with qc1:
        if st.button("➕ Add", key=f"add_{name}", use_container_width=True):
            st.session_state.cart.append({"medicine": name, "qty": int(q), "price": price})
            st.rerun()


