def _swami_stt(audio_bytes, filename="audio.wav"):
    import os, json, urllib.request
    key = os.environ.get("GROQ_API_KEY") or os.environ.get("groq_api_key", "")
    if not key:
        return None, "GROQ_API_KEY not set"
    try:
        boundary = "----swami" + os.urandom(8).hex()
        parts = []
        def field(n, v):
            parts.append(("--" + boundary + "\r\n").encode())
            parts.append(('Content-Disposition: form-data; name="' + n + '"\r\n\r\n').encode())
            parts.append(str(v).encode() + b"\r\n")
        field("model", "whisper-large-v3")
        field("language", "ta")
        field("response_format", "json")
        parts.append(("--" + boundary + "\r\n").encode())
        parts.append(('Content-Disposition: form-data; name="file"; filename="' + filename + '"\r\n').encode())
        parts.append(b"Content-Type: audio/wav\r\n\r\n")
        parts.append(audio_bytes + b"\r\n")
        parts.append(("--" + boundary + "--\r\n").encode())
        req = urllib.request.Request(
            "https://api.groq.com/openai/v1/audio/transcriptions",
            data=b"".join(parts),
            headers={"Authorization": "Bearer " + key,
                     "Content-Type": "multipart/form-data; boundary=" + boundary})
        with urllib.request.urlopen(req, timeout=45) as r:
            return json.loads(r.read()).get("text", "").strip(), None
    except Exception as e:
        return None, str(e)


def _swami_tts(text, voice, rate="+0%", pitch="+0Hz"):
    import io, asyncio, threading
    try:
        import edge_tts
    except ImportError:
        return None, "edge-tts not installed"
    result = [None, None]
    def _w():
        try:
            async def _run():
                comm = edge_tts.Communicate(text, voice, rate=rate, pitch=pitch)
                buf = io.BytesIO()
                async for c in comm.stream():
                    if c.get("type") == "audio":
                        buf.write(c["data"])
                return buf.getvalue()
            result[0] = asyncio.run(_run())
        except Exception as e:
            result[1] = str(e)
    t = threading.Thread(target=_w, daemon=True); t.start(); t.join(timeout=40)
    if result[0] is None:
        return None, result[1] or "tts timeout"
    return result[0], None


def _swami_guide_reply(gk, user_msg, history):
    import os, json, urllib.request
    g = _SWAMI_GUIDES[gk]
    key = os.environ.get("GROQ_API_KEY") or os.environ.get("groq_api_key", "")
    if key:
        try:
            msgs = [{"role": "system", "content": _swami_system_prompt(gk)}]
            for h in history[-8:]:
                if h.get("role") in ("user", "assistant"):
                    msgs.append({"role": h["role"], "content": h["content"]})
            msgs.append({"role": "user", "content": user_msg})
            body = json.dumps({"model": "llama-3.1-8b-instant",
                               "messages": msgs, "temperature": 0.75,
                               "max_tokens": 240}).encode()
            req = urllib.request.Request(
                "https://api.groq.com/openai/v1/chat/completions", data=body,
                headers={"Authorization": "Bearer " + key,
                         "Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=20) as r:
                return json.loads(r.read())["choices"][0]["message"]["content"].strip()
        except Exception:
            pass
    m = (user_msg or "").lower()
    for keys, rep in g["fallback"].items():
        if any(k in m for k in keys):
            return rep
    return g["default"]


