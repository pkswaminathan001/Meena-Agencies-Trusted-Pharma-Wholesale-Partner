def _poll_telegram_verified_otp():
    """Auto-check if current retailer's OTP was verified via Telegram."""
    if not SHARED_OTP_LOADED:
        return
    rid = st.session_state.get("retailer_id")
    if not rid:
        return

    # Initialize tracking timestamp
    if "otp_poll_since" not in st.session_state:
        st.session_state.otp_poll_since = datetime.now().isoformat(timespec="seconds")

    try:
        recent = shared_otp.get_verified_since(st.session_state.otp_poll_since)
    except Exception:
        return

    for oid, entry in recent:
        if str(entry.get("retailer_id", "")).upper() == str(rid).upper():
            # This retailer's OTP was verified via Telegram!
            st.session_state.otp_verified_via_telegram = {
                "order_id": oid,
                "entry": entry,
            }
            st.session_state.otp_poll_since = datetime.now().isoformat(timespec="seconds")
            return




def poll_telegram_verification():
    """Auto-complete order if owner verified OTP via Telegram."""
    if not SHARED_OTP_LOADED:
        return
    oid = st.session_state.get("current_otp_id")
    if not oid:
        return
    entry = shared_otp.get_otp(oid)
    if not entry:
        return
    if entry.get("status") != "verified":
        return

    # OTP verified via Telegram — complete the order
    if st.session_state.get("otp_sent_for_cart"):
        order = place_order_with_approval(
            st.session_state.get("retailer"),
            st.session_state.get("cart", []),
        )
        if order:
            try:
                orders = load_orders()
                for o in orders:
                    if o.get("order_id") == order.get("order_id"):
                        o["otp_id"] = oid
                        o["otp_verified_via"] = entry.get("verified_via", "telegram")
                save_orders(orders)
            except Exception:
                pass
            st.session_state.success_order = order
            try:
                _so = st.session_state.get("success_order") or {}
                _oid = _so.get("id") or _so.get("order_id") or (_so.get("order", {}) or {}).get("id")
                if _oid and st.session_state.get("_toasted_for") != _oid:
                    st.toast(f"🧾 Order placed! ID: {_oid}", icon="✅", duration=4500)
                    st.balloons()
                    st.session_state["_toasted_for"] = _oid
            except Exception:
                pass

            st.session_state.cart = []
            st.session_state.otp_sent_for_cart = False
            st.session_state.pop("current_otp_id", None)
            st.session_state.pop("otp_code_input", None)
