def _swami_track(event, **kw):
    """Append a usage event. Silent on failure."""
    try:
        rec = {"ts": _dt.now().isoformat(timespec="seconds"), "event": event}
        rec.update(kw)
        with open(_USAGE_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception:
        pass


