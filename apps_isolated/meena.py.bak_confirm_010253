def _j_handle(q):
    # Try Groq first if key exists
    try:
        _ctx = _build_business_context()
        _reply = _groq_ask(q, _ctx)
        if _reply and not _reply.startswith("Groq error"):
            st.session_state.jmsgs.append(("user", q))
            st.session_state.jmsgs.append(("bot", _reply + "\n\n_\u2014 Powered by Llama 3.3 via Groq_"))
            st.rerun()
            return
    except Exception:
        pass
    # Fallback: rules
    orders = load_orders(); rets = load_retailers(); inv = load_inventory()
    ql = q.lower()
    if "pending" in ql:
        n = len([o for o in orders if (o.get("status") or "").lower()=="pending"])
        a = f"You have **{n}** pending order(s)."
    elif "top" in ql or "outstanding" in ql:
        top = sorted(rets, key=lambda r: float(r.get("outstanding") or 0), reverse=True)[:3]
        a = "Top 3 by outstanding:\n\n" + "\n".join(f"{i+1}. {r.get('shop','?')} — {money(r.get('outstanding',0))}" for i,r in enumerate(top))
    elif "low" in ql and "stock" in ql:
        qty = find_col(inv,"quantity","stock","qty")
        nm  = find_col(inv,"medicine_name","medicine","name")
        if qty and nm:
            inv2 = inv.copy(); inv2["_q"]=pd.to_numeric(inv2[qty],errors="coerce").fillna(0)
            low = inv2[inv2["_q"]<100].head(5)
            a = "Low stock:\n\n" + "\n".join(f"• {r[nm]} — {int(r['_q'])} units" for _,r in low.iterrows()) if not low.empty else "No low stock."
        else: a = "Inventory unreadable."
    elif "revenue" in ql or "total" in ql:
        tot = sum(float(o.get("total",0)) for o in orders)
        a = f"Total revenue: **{money(tot)}** across {len(orders)} orders."
    else:
        a = "Try: *pending orders*, *top retailers*, *low stock*, or *revenue*."
    st.session_state.jmsgs.append(("user", q))
    st.session_state.jmsgs.append(("bot", a))
    st.rerun()




