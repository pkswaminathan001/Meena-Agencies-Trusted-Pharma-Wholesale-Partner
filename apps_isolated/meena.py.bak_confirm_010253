def owner_ai_analyzer():
    """AI co-pilot: analyzes every retailer, ranks risk, suggests action."""
    st.markdown("## 🧠 AI Co-Pilot — Retailer Analyzer")
    st.caption("Reads live data, ranks every retailer, tells you who needs attention")

    rets = load_retailers()
    orders = load_orders()
    if not rets:
        st.warning("No retailers."); return

    # ── Local analysis first (works without Groq) ──
    rows = []
    for r in rets:
        rid = r.get("id", "?")
        shop = r.get("shop", "?")
        lim = float(r.get("credit_limit") or 0)
        out = float(r.get("outstanding") or 0)
        status = str(r.get("status") or "Active")
        my = [o for o in orders if str(o.get("retailer_id","")).upper() == rid.upper()]
        # Last order
        last_dt = None
        for o in my:
            try:
                d = pd.to_datetime(o.get("placed_at"), errors="coerce", format="mixed")
                if pd.notna(d) and (last_dt is None or d > last_dt):
                    last_dt = d
            except Exception: pass
        days_since = (datetime.now() - last_dt).days if last_dt else 999
        pct = (out / lim * 100) if lim else 0

        # Risk score: 0 = safe, 100 = danger
        risk = 0
        risk += min(pct, 100) * 0.5              # credit usage (0-50)
        risk += min(days_since / 2, 30)          # staleness (0-30)
        risk += 10 if "hold" in status.lower() else 0
        risk += 10 if out > 100000 else 0
        risk = min(risk, 100)

        # Recommendation (rule-based)
        if "hold" in status.lower():
            action = "🔒 Frozen — awaiting payment. Call to discuss."
            urgency = "critical"
        elif pct >= 100:
            action = f"🚫 Over limit by ₹{out-lim:,.0f}. Freeze now."
            urgency = "critical"
        elif pct >= 90:
            action = f"⚠️ At {pct:.0f}% credit. Call before next order."
            urgency = "high"
        elif days_since > 90:
            action = f"😴 Dormant {days_since} days. Re-engagement call."
            urgency = "high"
        elif days_since > 60:
            action = f"🕐 No order in {days_since} days. Send offer."
            urgency = "medium"
        elif out > 50000 and days_since <= 30:
            action = f"💰 Active but high balance (₹{out:,.0f}). Friendly reminder."
            urgency = "medium"
        else:
            action = f"✅ Healthy. Last order {days_since} days ago."
            urgency = "ok"

        rows.append({
            "ID": rid, "Shop": shop,
            "Limit": lim, "Outstanding": out,
            "Used%": round(pct, 1),
            "Days Since": days_since,
            "Status": status,
            "Risk": round(risk, 1),
            "Urgency": urgency,
            "Action": action,
        })

    df = pd.DataFrame(rows).sort_values("Risk", ascending=False)

    # ── Hero ──
    critical = df[df["Urgency"] == "critical"]
    high = df[df["Urgency"] == "high"]
    medium = df[df["Urgency"] == "medium"]
    ok = df[df["Urgency"] == "ok"]

    st.markdown(f"""
    <div class="hero">
        <div class="hero-eyebrow">🧠 AI CO-PILOT</div>
        <h1>Your attention is needed on <span class="accent">{len(critical) + len(high)}</span> retailers</h1>
        <p>Ranked by risk. Highest priority first.</p>
        <div class="hero-stats">
            <div><div class="hero-stat-label">🔴 Critical</div><div class="hero-stat-value">{len(critical)}</div></div>
            <div><div class="hero-stat-label">🟠 High</div><div class="hero-stat-value">{len(high)}</div></div>
            <div><div class="hero-stat-label">🟡 Medium</div><div class="hero-stat-value">{len(medium)}</div></div>
