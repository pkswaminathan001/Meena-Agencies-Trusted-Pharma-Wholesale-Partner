def _extract_city(address: str) -> str:
    """Pull a known city from an address string."""
    if not address: return ""
    low = address.lower()
    # Longest names first to catch 'tiruchirappalli' before 'trichy'
    for name in sorted(TN_LOCATIONS.keys(), key=len, reverse=True):
        if name in low:
            return name
    return ""


def _geocode(address: str) -> tuple:
    """Return (lat, lon, city) — falls back to TN center."""
    city = _extract_city(address)
    if city:
        lat, lon = TN_LOCATIONS[city]
        return lat, lon, city
    return TN_CENTER[0], TN_CENTER[1], ""


def _risk_color(outstanding: float, limit: float, days: int = 0) -> str:
    """Return marker color based on outstanding ratio + age."""
    if limit <= 0:
        return "#8892b0"    # grey — no credit line
    ratio = outstanding / limit
    if ratio >= 0.9 or days > 90:
        return "#ff4d6d"    # red — bad debt risk
    if ratio >= 0.6 or days > 45:
        return "#ffb547"    # orange — watch closely
    if outstanding > 0:
        return "#00d4ff"    # cyan — normal outstanding
    return "#00d47a"        # green — clear


