# ─── Data loaders ───
@st.cache_data(ttl=60)
def load_inventory() -> pd.DataFrame:
    for p in (PARENT / "inventory.csv", Path("inventory.csv")):
        if p.exists():
            try:
                df = pd.read_csv(p)
                df.columns = [c.strip().lower() for c in df.columns]
                return df
            except Exception:
                pass
    return pd.DataFrame()


@st.cache_data(ttl=60)
def load_retailers() -> pd.DataFrame:
    import json, sqlite3
    # 1) Try CSVs first
    candidates = [
        "retailers.csv", "retailer_master.csv", "users.csv",
        "retailer_credentials.csv", "logins.csv", "credentials.csv",
        "user_master.csv", "auth.csv", "accounts.csv",
    ]
    for name in candidates:
        for base in (PARENT, Path(".")):
            p = base / name
            if p.exists():
                try:
                    return pd.read_csv(p)
                except Exception:
                    pass

    # 2) JSON files
    for name in ("retailers.json", "users.json", "credentials.json"):
        for base in (PARENT, Path(".")):
            p = base / name
            if p.exists():
                try:
                    data = json.loads(p.read_text())
                    if isinstance(data, dict):
                        data = list(data.values())
                    return pd.DataFrame(data)
                except Exception:
                    pass

    # 3) SQLite databases — scan tables for a retailer-ish table
    for dbname in ("pharma.db", "app.db", "data.db", "database.db",
                   "meena.db", "retailers.db", "users.db"):
        for base in (PARENT, Path(".")):
            p = base / dbname
            if p.exists():
                try:
                    con = sqlite3.connect(str(p))
                    tables = pd.read_sql(
                        "SELECT name FROM sqlite_master WHERE type='table'",
                        con,
                    )["name"].tolist()
                    for t in tables:
                        if any(k in t.lower() for k in
                               ("retail", "user", "cred", "login", "auth", "account")):
                            df = pd.read_sql(f"SELECT * FROM {t}", con)
                            con.close()
                            return df
                    con.close()
                except Exception:
                    pass

    return pd.DataFrame()


def find_col(df: pd.DataFrame, *candidates):
    """Exact match, then case-insensitive, then substring."""
    cols = list(df.columns)
    for c in candidates:
        if c in cols:
            return c
    lower = {str(c).lower(): c for c in cols}
    for c in candidates:
        if c.lower() in lower:
            return lower[c.lower()]
    for c in candidates:
        for col in cols:
            if c.lower() in str(col).lower():
                return col
    return None


# ─── Login ───
def login_screen():
    _, mid, _ = st.columns([1, 2, 1])
    with mid:
        st.markdown(
            f'<div style="text-align:center;margin:2rem 0 1rem;">{logo_html(80)}</div>',
            unsafe_allow_html=True,
        )
        st.markdown(
            '<h2 style="text-align:center;color:#0e7490;margin-bottom:0;">Meena Agencies</h2>',
            unsafe_allow_html=True,
        )
        st.markdown(
            '<p style="text-align:center;color:#6b7280;margin-top:0;">Retailer Portal</p>',
            unsafe_allow_html=True,
        )
        st.markdown("---")
        with st.form("login_form", clear_on_submit=False):
            rid = st.text_input("Retailer ID", placeholder="e.g. RET001")
            pin = st.text_input("PIN", type="password", placeholder="4-digit PIN")
            submitted = st.form_submit_button("Sign In", use_container_width=True)

        if submitted:
            if not rid or not pin:
                st.error("Please enter Retailer ID and PIN.")
                return
            users = load_retailers()
            if users.empty:
                st.error("User database not found.")
                return
            id_col = find_col(
                users,
                "retailer_id", "retailerid", "ret_id", "code", "user_id",
                "userid", "username", "user", "login", "id", "firm_code",
                "shop_code", "account",
            )
            pin_col = find_col(
                users,
                "pin", "pin_code", "pincode", "password", "pass", "passcode",
                "pass_word", "pwd", "secret",
            )
            if not id_col or not pin_col:
                st.error("User database is misconfigured.")
                st.write("**Columns found in user file:**", list(users.columns))
                st.write("**Sample row:**")
                st.dataframe(users.head(3))
                st.caption(
                    "Tell Claude the exact column names shown above "
                    "so the login can be wired to them."
                )
                return
            users[id_col] = users[id_col].astype(str).str.strip().str.upper()
            users[pin_col] = users[pin_col].astype(str).str.strip()
            match = users[
                (users[id_col] == rid.strip().upper())
                & (users[pin_col] == str(pin).strip())
            ]
            if match.empty:
                st.error("Invalid Retailer ID or PIN.")
                return
            st.session_state.retailer = match.iloc[0].to_dict()
            st.session_state.retailer_id = rid.strip().upper()
            st.session_state.page = "home"
            st.rerun()


# ─── Pages ───
def page_home(r):
    name = (
        r.get("name")
        or r.get("retailer_name")
        or r.get("firm_name")
        or st.session_state.get("retailer_id", "Retailer")
    )
    st.markdown(
        f"""
        <div class="hero">
            <h1>Welcome, {name} 👋</h1>
            <p>Your retail dashboard — order medicines, track deliveries, manage your ledger.</p>
        </div>
        """,
        unsafe_allow_html=True,
    )

    c1, c2, c3, c4 = st.columns(4)
    c1.metric("Last Order", "—")
    c2.metric("Pending", "0")
    c3.metric("Due Amount", "₹0")
    c4.metric("Offers", "3")

    st.markdown("### Quick Actions")
    q1, q2, q3 = st.columns(3)
    if q1.button("🛒 Place Order", use_container_width=True, key="qa_order"):
        st.session_state.page = "order"
        st.rerun()
    if q2.button("🔍 Stock Check", use_container_width=True, key="qa_stock"):
        st.session_state.page = "stock"
        st.rerun()
    if q3.button("💰 Ledger", use_container_width=True, key="qa_ledger"):
        st.session_state.page = "ledger"
        st.rerun()


def page_order(r):
    st.markdown("## 🛒 Place Order")
    st.caption("Search or browse medicines. Add to cart and submit.")

    df = load_inventory()
    if df.empty:
        st.warning("Inventory not available. Please try again later.")
        return

    name_col = find_col(df, "name", "product", "medicine", "product_name", "item")
    price_col = find_col(df, "price", "mrp", "rate", "selling_price")
    stock_col = find_col(df, "stock", "qty", "quantity", "available")

    if not name_col:
        st.error("Inventory file has no product-name column.")
        st.write("Columns found:", list(df.columns))
        return

    q = st.text_input(
        "Search medicine",
        placeholder="e.g. Dolo, ORS, Azithromycin",
        key="order_q",
    ).strip().lower()

    view = df.copy()
    if q:
        view = view[view[name_col].astype(str).str.lower().str.contains(q, na=False)]

    st.caption(f"{len(view)} medicine(s) found")

    if "cart" not in st.session_state:
        st.session_state.cart = []

    for _, row in view.head(50).iterrows():
        name = str(row[name_col])
        try:
            price = float(row[price_col]) if price_col and pd.notna(row[price_col]) else 0.0
        except Exception:
            price = 0.0
        try:
            stock = int(row[stock_col]) if stock_col and pd.notna(row[stock_col]) else 0
        except Exception:
            stock = 0

        c1, c2, c3 = st.columns([5, 2, 2])
        c1.markdown(f"**{name}**")
        c2.markdown(f"₹{price:.2f}")
        with c3:
            if stock > 0:
                if st.button(
                    f"Add (stock {stock})",
                    key=f"add_{name}",
                    use_container_width=True,
                ):
                    st.session_state.cart.append({"name": name, "price": price, "qty": 1})
                    st.toast(f"Added {name}")
            else:
                st.button(
                    "Out of stock",
                    key=f"oos_{name}",
                    disabled=True,
                    use_container_width=True,
                )

    if st.session_state.cart:
        st.markdown("### 🧺 Cart")
        total = 0.0
        for i, item in enumerate(st.session_state.cart):
            total += item["price"] * item["qty"]
            cc1, cc2, cc3 = st.columns([5, 3, 1])
            cc1.write(item["name"])
            cc2.write(f"₹{item['price']:.2f} × {item['qty']}")
            if cc3.button("✕", key=f"rm_{i}"):
                st.session_state.cart.pop(i)
                st.rerun()
        st.markdown(f"**Total: ₹{total:.2f}**")
        if st.button("✅ Submit Order", type="primary"):
            st.success(f"Order placed! Total ₹{total:.2f}")
            st.session_state.cart = []


def page_stock(r):
    st.markdown("## 🔍 Stock Check")
    st.caption("Search any medicine — see stock & price instantly")

    df = load_inventory()
    if df.empty:
        st.warning("Inventory not available.")
        return

    name_col = find_col(df, "name", "product", "medicine", "product_name", "item")
    price_col = find_col(df, "price", "mrp", "rate", "selling_price")
    stock_col = find_col(df, "stock", "qty", "quantity", "available")

    if not name_col:
        st.error("Inventory file has no product-name column.")
        return

    q = st.text_input(
        "Search",
        placeholder="Type medicine name...",
        key="stock_q",
        label_visibility="collapsed",
    ).strip().lower()

    if not q:
        st.caption("Type to search...")
        return

    view = df[df[name_col].astype(str).str.lower().str.contains(q, na=False)].head(50)
    st.caption(f"{len(view)} result(s)")

    for _, row in view.iterrows():
        name = str(row[name_col])
        price = row[price_col] if price_col and pd.notna(row[price_col]) else "—"
        stock = row[stock_col] if stock_col and pd.notna(row[stock_col]) else "—"
        st.markdown(
            f"""
            <div class="product-card">
                <div class="name">{name}</div>
                <div class="price">₹{price}</div>
                <div class="stock">Stock: {stock}</div>
            </div>
            """,
            unsafe_allow_html=True,
        )


def page_placeholder(r, label, icon="⏳"):
    st.markdown(f"## {icon} {label}")
    st.info("Coming soon.")


# ─── Sidebar ───
MENU = [
    ("home",     "🏠", "Home"),
    ("order",    "🛒", "Place Order"),
    ("reorder",  "🔁", "Reorder Last"),
    ("bills",    "🧾", "Bill History"),
    ("track",    "🚚", "Track Deliveries"),
    ("cart",     "🛍️", "My Cart"),
    ("favorites","⭐", "Frequently Ordered"),
    ("stock",    "🔍", "Stock Check"),
    ("ledger",   "💰", "Ledger / Balance"),
    ("notify",   "🔔", "Notifications"),
    ("offers",   "🎁", "Offers & Schemes"),
    ("business", "📊", "My Business"),
    ("contact",  "📞", "Contact Us"),
    ("profile",  "👤", "My Profile"),
]


def render_sidebar():
    with st.sidebar:
        st.markdown(
            f'<div style="padding:0.8rem 0;">{logo_html(52)}</div>',
            unsafe_allow_html=True,
        )
        st.markdown("**Meena Agencies**")
        st.caption(st.session_state.get("retailer_id", ""))
        st.markdown("---")

        current = st.session_state.get("page", "home")
        for key, icon, label in MENU:
            active = key == current
            if st.button(
                f"{icon}  {label}",
                key=f"nav_{key}",
                use_container_width=True,
                type="primary" if active else "secondary",
            ):
                st.session_state.page = key
                st.rerun()

        st.markdown("---")
        if st.button("🚪  Sign Out", key="nav_signout", use_container_width=True):
            st.session_state.clear()
            st.rerun()


# ─── Router ───
def main():
    if "retailer" not in st.session_state:
        login_screen()
        return

    r = st.session_state.retailer
    st.session_state.setdefault("page", "home")

    render_sidebar()

    page = st.session_state.page
    if page == "home":
        page_home(r)
    elif page == "order":
        page_order(r)
    elif page == "stock":
        page_stock(r)
    else:
        # Try external pages module first
        try:
            import importlib
            rp = importlib.import_module("retailer_pages")
            fn = getattr(rp, f"render_{page}", None)
            if fn:
                fn(r)
                return
        except Exception:
            pass
        label = next((m[2] for m in MENU if m[0] == page), page.title())
        icon = next((m[1] for m in MENU if m[0] == page), "⏳")
        page_placeholder(r, label, icon)


main()
