"""
retailer_app.py — Clean Retailer App (v4)
Port: 8501
Fixes: CSS color errors, Path.read_text() bug, missing page_order/page_stock_check
"""
import base64
import sys
from pathlib import Path
from datetime import datetime

import pandas as pd
import streamlit as st

PARENT = Path(__file__).parent.parent
sys.path.insert(0, str(PARENT))

st.set_page_config(
    page_title="Meena Agencies — Retailer",
    page_icon="🛒",
    layout="wide",
    initial_sidebar_state="expanded",
)


# ─── Logo helper (base64, no file IO at render time) ───
def logo_html(height: int = 40) -> str:
    p = Path(__file__).parent / "static" / "logo.png"
    if p.exists():
        b64 = base64.b64encode(p.read_bytes()).decode()
        return f'<img src="data:image/png;base64,{b64}" style="height:{height}px;" alt="Meena Agencies">'
    return "🦚"


