def _classify(name: str):
    """Return (emoji, color, category) for a medicine name."""
    n = name.lower()
    for key, emoji, color in _CAT_MAP:
        if key.lower() in n:
            return emoji, color, key
    return "💊", "#00d4ff", "Medicine"


@st.cache_data(ttl=15)
def _order_catalog():
    """Load + clean inventory for the ordering page."""
    import pandas as pd
    raw = load_inventory()
    if raw.empty:
        return pd.DataFrame()
    df = raw.copy()

    name_col  = find_col(df, "medicine_name","medicine","name","product","product_name","item")
    price_col = find_col(df, "cost_price","price","mrp","rate","selling_price","unit_price")
    stock_col = find_col(df, "quantity","stock","qty","available","on_hand")
    batch_col = find_col(df, "batch_number","batch","lot")
    exp_col   = find_col(df, "expiry_date","expiry","exp")
    if not name_col:
        return pd.DataFrame()

    out = pd.DataFrame()
    out["name"]  = df[name_col].astype(str).str.strip()
    out["price"] = pd.to_numeric(df[price_col], errors="coerce").fillna(0) if price_col else 0.0
    out["stock"] = pd.to_numeric(df[stock_col], errors="coerce").fillna(0).astype(int) if stock_col else 0
    out["batch"] = df[batch_col].astype(str) if batch_col else "—"
    out["exp"]   = df[exp_col].astype(str) if exp_col else "—"

    # Apply a sale markup so cost_price looks like a retail price
    if price_col and price_col.lower() in ("cost_price",):
        out["price"] = (out["price"] * 1.18).round(2)

    # Group duplicates: keep one row per name, sum stock, cheapest price
    grouped = (
        out.groupby("name", as_index=False)
           .agg(
                price=("price", "min"),
                stock=("stock", "sum"),
                batches=("batch", "count"),
                earliest_exp=("exp", "min"),
           )
    )
    grouped["emoji"], grouped["color"], grouped["cat"] = zip(
        *grouped["name"].map(_classify)
    )
    return grouped.sort_values("name").reset_index(drop=True)


