def logo_html(h: int = 40) -> str:
    p = Path(__file__).parent / "static" / "logo.png"
    if p.exists():
        b64 = base64.b64encode(p.read_bytes()).decode()
        return f'<img src="data:image/png;base64,{b64}" style="height:{h}px;" alt="Meena">'
    return "🦚"


def find_col(df, *cands):
    cols = list(df.columns)
    for c in cands:
        if c in cols: return c
    lower = {str(c).lower(): c for c in cols}
    for c in cands:
        if c.lower() in lower: return lower[c.lower()]
    return None


@st.cache_data(ttl=5)
def load_inventory() -> pd.DataFrame:
    for p in (PARENT / "inventory.csv", Path("inventory.csv")):
        if p.exists():
            try:
                df = pd.read_csv(p)
                df.columns = [c.strip().lower() for c in df.columns]
                return df
            except Exception: pass
    return pd.DataFrame()


@st.cache_data(ttl=60)
def load_retailers() -> pd.DataFrame:
    import json as _json
    # JSON first
    for p in (PARENT / "retailers.json", Path("retailers.json")):
        if p.exists():
            try:
                data = _json.loads(p.read_text())
                if isinstance(data, dict):
                    data = list(data.values())
                return pd.DataFrame(data)
            except Exception: pass
    # CSVs
    for name in ("retailers.csv","retailer_master.csv","users.csv","credentials.csv"):
        for base in (PARENT, Path(".")):
            p = base / name
            if p.exists():
                try: return pd.read_csv(p)
                except Exception: pass
    return pd.DataFrame()


