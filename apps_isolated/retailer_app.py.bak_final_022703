                             use_container_width=True):
                    st.session_state.order_page = cur_page + 1
                    st.rerun()

    # ── Cart drawer ──
    _render_cart()


def _render_med_card(row):
    """One medicine card with qty stepper + Add button."""
    name  = row["name"]
    price = float(row["price"])
    stock = int(row["stock"])
    emoji = row["emoji"]
    color = row["color"]
    cat   = row["cat"]
    batches = int(row.get("batches", 1))

    # Card container
    st.markdown(f"""
    <div style="
        background:#1a1f2e;border:1px solid #2a3142;border-radius:12px;
        padding:0.9rem 0.8rem 0.5rem;margin-bottom:0.5rem;
        border-top:3px solid {color};
    ">
        <div style="text-align:center;font-size:1.8rem;line-height:1;">{emoji}</div>
        <div style="text-align:center;font-weight:700;font-size:0.9rem;
                    margin-top:0.4rem;color:#e8eaf6;min-height:2.4rem;line-height:1.2;">
            {name[:36]}
        </div>
        <div style="text-align:center;margin-top:0.4rem;">
            <span style="background:{color}22;color:{color};
                         border:1px solid {color}55;border-radius:6px;
                         padding:1px 8px;font-size:0.68rem;">{cat}</span>
        </div>
        <div style="text-align:center;font-size:1.15rem;font-weight:800;
                    color:{color};margin-top:0.5rem;">
            ₹{price:,.2f}
        </div>
        <div style="text-align:center;font-size:0.72rem;color:#8892b0;margin-top:0.15rem;">
            {batches} batch{'es' if batches != 1 else ''} · {stock:,} in stock
        </div>
    </div>
    """, unsafe_allow_html=True)

    qty_key = f"qty_{name}"
    st.session_state.setdefault(qty_key, 1)

    qc1, qc2 = st.columns([1, 2])
    with qc1:
        qty = st.number_input(
            "Qty", min_value=1, max_value=max(1, min(stock, 999)),
            value=st.session_state[qty_key],
            key=f"qty_in_{name}",
            label_visibility="collapsed",
        )
        st.session_state[qty_key] = qty
    with qc2:
        if stock <= 0:
            st.button("Out of stock", key=f"add_{name}", disabled=True,
                      use_container_width=True)
        else:
            if st.button("➕ Add", key=f"add_{name}", use_container_width=True,
                         type="primary"):
                # Merge with existing cart line if same name
                cart = st.session_state.cart
                for line in cart:
                    if line["name"] == name:
                        line["qty"] += qty
                        break
                else:
                    cart.append({"name": name, "price": price, "qty": qty})
                st.session_state.cart = cart
                st.toast(f"Added {qty} × {name}")
                st.rerun()


def _render_cart():
    """Bottom cart summary."""
    cart = st.session_state.get("cart", [])
    if not cart:
        return

    total = sum(l["price"] * l["qty"] for l in cart)
    count = sum(l["qty"] for l in cart)

    st.markdown("---")
    st.markdown(f"### 🧺 Cart — {count} item(s) · ₹{total:,.2f}")

    for i, line in enumerate(list(cart)):
        c1, c2, c3, c4 = st.columns([4, 2, 2, 1])
        c1.markdown(f"**{line['name']}**")
        c2.markdown(f"₹{line['price']:,.2f} × {line['qty']}")
        c3.markdown(f"₹{line['price']*line['qty']:,.2f}")
        if c4.button("✕", key=f"rm_{i}_{line['name']}"):
            cart.pop(i)
            st.session_state.cart = cart
            st.rerun()

    b1, b2 = st.columns(2)
    if b1.button("✅ Submit Order (Get OTP)", type="primary",
                 use_container_width=True):
        st.success(f"Order placed! Total ₹{total:,.2f} — {count} item(s).")
        st.session_state.cart = []
        st.rerun()
    if b2.button("🗑️ Clear Cart", use_container_width=True):
        st.session_state.cart = []
        st.rerun()


