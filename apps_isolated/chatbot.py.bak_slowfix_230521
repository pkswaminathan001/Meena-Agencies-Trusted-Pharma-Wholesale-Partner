_CACHE = {"data": None, "ts": 0}


def load_catalog():
    now = time.time()
    if _CACHE["data"] and (now - _CACHE["ts"]) < 60:
        return _CACHE["data"]

    products = {}
    try:
        if INVENTORY_FILE.exists():
            with open(INVENTORY_FILE, newline="") as f:
                for row in csv.DictReader(f):
                    name = (row.get("medicine_name") or "").strip()
                    if not name:
                        continue
                    qty = int(float(row.get("quantity") or 0))
                    cost = float(row.get("cost_price") or 0)
                    price = round(cost * 1.18, 2)
                    if name in products:
                        products[name]["stock"] += qty
                        products[name]["batches"] += 1
                    else:
                        products[name] = {"name": name, "price": price,
                                           "stock": qty, "batches": 1,
                                           "category": _classify(name)}
    except Exception as e:
        log(f"catalog: {e}")

    _CACHE["data"] = products
    _CACHE["ts"] = now
    return products


def _classify(name):
    n = name.lower()
    for kw, cat in [
        ("amoxi", "Antibiotic"), ("azithro", "Antibiotic"), ("cef", "Antibiotic"),
        ("paracet", "Pain Relief"), ("ibupro", "Pain Relief"), ("dolo", "Pain Relief"),
        ("atorva", "Cardiac"), ("metfor", "Diabetes"), ("insulin", "Diabetes"),
        ("cetiri", "Allergy"), ("omepra", "Gastro"), ("ors", "Hydration"),
        ("cough", "Cough & Cold"), ("salbutamol", "Respiratory"),
    ]:
        if kw in n:
            return cat
    return "General"


def catalog_list():
    cat = load_catalog()
    items = sorted(cat.values(), key=lambda x: x["name"])
    for i, p in enumerate(items):
        p["idx"] = i
    return items


def by_idx():
    return {p["idx"]: p for p in catalog_list()}


def by_category():
    groups = {}
    for p in catalog_list():
        groups.setdefault(p["category"], []).append(p)
    return groups


def search(q, limit=10):
    q = q.lower().strip()
    m = [p for p in catalog_list() if q in p["name"].lower()]
    m.sort(key=lambda x: (0 if x["name"].lower().startswith(q) else 1, x["name"]))
    return m[:limit]


