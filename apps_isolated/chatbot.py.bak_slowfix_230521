# MAIN
# ═══════════════════════════════════════════════════════
def main():
    if not TOKEN:
        print("❌ No token"); sys.exit(1)

    print("═" * 50)
    print("  Meena Agencies Shop v5")
    print("═" * 50)
    print(f"  Catalog: {len(load_catalog())} medicines")
    print("═" * 50)

    state = load_json(STATE_FILE, {"offset": 0})
    offset = state.get("offset", 0)

    first = tg_api("getUpdates", {"timeout": 0})
    if first and first.get("result"):
        last = max(u.get("update_id", 0) for u in first["result"])
        offset = last + 1
        save_json(STATE_FILE, {"offset": offset})

    print(f"  ✅ Listening (offset {offset})")
    print("═" * 50)

    executor = ThreadPoolExecutor(max_workers=4)
    backoff = 1

    while True:
        try:
            r = tg_api("getUpdates", {"offset": offset, "timeout": POLL_TIMEOUT},
                       timeout=POLL_TIMEOUT + 10)
            if not r or not r.get("ok"):
                time.sleep(backoff)
                backoff = min(backoff * 2, 30)
                continue
            backoff = 1
            for u in r.get("result", []):
                executor.submit(process, u)
                offset = u.get("update_id", offset) + 1
                save_json(STATE_FILE, {"offset": offset})
        except KeyboardInterrupt:
            print("\n👋 Stopped"); break
        except Exception as e:
            log(f"Loop: {e}")
            time.sleep(min(30, backoff))
            backoff = min(backoff * 2, 30)


if __name__ == "__main__":
    main()
