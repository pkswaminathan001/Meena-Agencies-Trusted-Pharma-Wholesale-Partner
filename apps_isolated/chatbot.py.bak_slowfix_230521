def tg_api(method, params=None, timeout=10):
    try:
        url = f"https://api.telegram.org/bot{TOKEN}/{method}"
        if params:
            data = json.dumps(params).encode()
            req = urllib.request.Request(url, data=data, method="POST",
                                         headers={"Content-Type": "application/json"})
        else:
            req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except Exception as e:
        log(f"tg_api {method}: {e}")
        return None


def tg_send(chat_id, text, keyboard=None):
    p = {"chat_id": str(chat_id), "text": text, "parse_mode": "HTML",
         "disable_web_page_preview": True}
    if keyboard:
        p["reply_markup"] = keyboard
    return tg_api("sendMessage", p)


def tg_edit(chat_id, msg_id, text, keyboard=None):
    p = {"chat_id": str(chat_id), "message_id": msg_id, "text": text,
         "parse_mode": "HTML", "disable_web_page_preview": True}
    if keyboard is not None:
        p["reply_markup"] = keyboard
    return tg_api("editMessageText", p)


def tg_answer(cb_id, text=None):
    p = {"callback_query_id": cb_id}
    if text:
        p["text"] = text
    return tg_api("answerCallbackQuery", p)


def tg_typing(chat_id):
    tg_api("sendChatAction", {"chat_id": str(chat_id), "action": "typing"}, timeout=3)


def kb(rows):
