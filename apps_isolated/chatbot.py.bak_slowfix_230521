# CALLBACK ROUTER
# ═══════════════════════════════════════════════════════
def route_callback(cb):
    try:
        cb_id = cb.get("id")
        chat_id = cb.get("message", {}).get("chat", {}).get("id")
        msg_id = cb.get("message", {}).get("message_id")
        data = cb.get("data", "")

        if not chat_id or not data:
            tg_answer(cb_id)
            return

        chat_id_str = str(chat_id)

        # Owner approve/reject
        if data.startswith("appr:"):
            if chat_id_str != OWNER_CHAT_ID:
                tg_answer(cb_id, "Not authorized"); return
            oid = data[5:]
            if approve(oid):
                tg_answer(cb_id, "✅ Approved")
                tg_edit(chat_id, msg_id,
                        f"✅ <b>Approved</b>\n\n<code>{oid}</code>\n\nCustomer notified.",
                        keyboard=None)
            else:
                tg_answer(cb_id, "Not found")
            return

        if data.startswith("rej:"):
            if chat_id_str != OWNER_CHAT_ID:
                tg_answer(cb_id, "Not authorized"); return
            oid = data[4:]
            if reject(oid):
                tg_answer(cb_id, "❌ Rejected")
                tg_edit(chat_id, msg_id,
                        f"❌ <b>Rejected</b>\n\n<code>{oid}</code>\n\nCustomer notified.",
                        keyboard=None)
            else:
                tg_answer(cb_id, "Not found")
            return

        # Public navigation
        if data == "noop":
            tg_answer(cb_id); return

        if data == "menu":
            t, k = v_menu(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "cats":
            t, k = v_categories(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data.startswith("cat:"):
            cat = data[4:]
            t, k = v_category(chat_id, cat)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data.startswith("prd:"):
            try: idx = int(data[4:])
            except: tg_answer(cb_id, "Error"); return
            t, k = v_product(chat_id, idx)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data.startswith("inc:"):
            try: idx = int(data[4:])
            except: tg_answer(cb_id, "Error"); return
            cart_inc(chat_id, idx)
            cnt = cart_count(get_cart(chat_id))
            tg_answer(cb_id, f"➕ Added  ·  Cart: {cnt}")
            t, k = v_product(chat_id, idx)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data.startswith("dec:"):
            try: idx = int(data[4:])
            except: tg_answer(cb_id, "Error"); return
            cart_dec(chat_id, idx)
            cnt = cart_count(get_cart(chat_id))
            tg_answer(cb_id, f"➖ Removed  ·  Cart: {cnt}")
            t, k = v_product(chat_id, idx)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data.startswith("rmv:"):
            try: idx = int(data[4:])
            except: tg_answer(cb_id, "Error"); return
            cart_remove(chat_id, idx)
            tg_answer(cb_id, "🗑️ Removed")
            t, k = v_product(chat_id, idx)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "cart":
            t, k = v_cart(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "clear":
            cart_clear(chat_id)
            tg_answer(cb_id, "Cleared")
            t, k = v_cart(chat_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "checkout":
            cart = get_cart(chat_id)
            if not cart:
                tg_answer(cb_id, "Cart empty"); return
            tg_answer(cb_id, "Sending OTP...")
            t, k = v_otp_prompt(chat_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "favs":
            t, k = v_favs(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "offers":
            t, k = v_offers(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "about":
            t, k = v_about(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "contact":
            t, k = v_contact(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        if data == "search":
            t, k = v_search_prompt(chat_id)
            tg_answer(cb_id)
            tg_edit(chat_id, msg_id, t, k)
            return

        tg_answer(cb_id)
    except Exception as e:
        log(f"route_callback: {e}\n{traceback.format_exc()}")


# ═══════════════════════════════════════════════════════
# TEXT ROUTER
# ═══════════════════════════════════════════════════════
def route_text(chat_id, text):
    t = text.strip().lower()

    # ═══ OWNER TEST MODE ═══
    if str(chat_id) == OWNER_CHAT_ID:
        if t.startswith("/test "):
            parts = text.strip().split(" ", 1)
            if len(parts) == 2:
                rid = parts[1].strip().upper()
                _set_test_retailer(rid)
                # Find shop
                shop = rid
                for r in load_json(PARENT / "retailers.json", []):
                    if isinstance(r, dict) and str(r.get("id","")).upper() == rid:
                        shop = r.get("shop", rid)
                        break
                tg_send(chat_id,
                    f"🧪 <b>Test Mode ON</b>\n\n"
                    f"Now ordering as: <b>{shop}</b> (<code>{rid}</code>)\n\n"
                    f"Add products → Checkout → OTP will show {shop}.\n\n"
                    f"To exit: <code>/test off</code>",
                    keyboard=kb([[{"text": "💊 Start Shopping", "callback_data": "cats"}]]))
                return

        if t in ("/test off", "/testoff", "/reset"):
            _set_test_retailer(None)
            tg_send(chat_id, "🧪 Test mode OFF. You're back to Owner.")
            return

        if t in ("/test", "/whoami"):
            cur = _get_test_retailer()
            if cur:
                tg_send(chat_id, f"🧪 Currently testing as: <code>{cur}</code>")
            else:
                tg_send(chat_id, "👑 You are Owner (real).")
            return

        if t.startswith("/test?"):
            lines = ["🧪 <b>Available Test Retailers:</b>\n"]
            for rid, shop in _list_retailers():
                lines.append(f"• <code>/test {rid}</code> → {shop}")
            lines.append("")
            lines.append("• <code>/test off</code> → back to Owner")
            tg_send(chat_id, "\n".join(lines))
            return

    # OTP check first
    otps = load_json(OTPS_FILE, {})
    if str(chat_id) in otps and re.match(r'^\d{6}$', t):
        ok, msg, cart = verify_otp(chat_id, t)
        if not ok:
            tg_send(chat_id, f"❌ {msg}")
            return
        order = create_order(chat_id, cart)
        cart_clear(chat_id)
        t2, k2 = v_after_order(chat_id, order)
        tg_send(chat_id, t2, k2)
        return

    # Welcome
    if t in ("hi", "hello", "start", "/start", "vanakkam", "hey", "/menu"):
        tx, kx = v_menu(chat_id)
        tg_send(chat_id, tx, kx)
        return

    # Commands
    if t in ("products", "browse", "catalog", "medicines"):
        tx, kx = v_categories(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("cart", "my cart", "basket"):
        tx, kx = v_cart(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("checkout", "buy", "place order"):
        tx, kx = v_otp_prompt(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("clear", "empty"):
        cart_clear(chat_id)
        tx, kx = v_menu(chat_id)
        tg_send(chat_id, "🗑️ Cart cleared.", kx)
        return

    if t in ("offers", "deals", "discounts"):
        tx, kx = v_offers(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("about", "info"):
        tx, kx = v_about(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("contact", "phone", "call", "help"):
        tx, kx = v_contact(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("search", "/search"):
        tx, kx = v_search_prompt(chat_id)
        tg_send(chat_id, tx, kx)
        return

    if t in ("favs", "favorites", "frequent"):
        tx, kx = v_favs(chat_id)
        tg_send(chat_id, tx, kx)
        return

    # Search by name (bare text)
    if 2 <= len(text.strip()) <= 40:
        matches = search(text)
        if matches:
            tx, kx = v_search_results(chat_id, text)
            tg_send(chat_id, tx, kx)
            return

    # Fallback
    tx, kx = v_menu(chat_id)
    tg_send(chat_id, tx, kx)


# ═══════════════════════════════════════════════════════
# PROCESSOR
# ═══════════════════════════════════════════════════════
def process(update):
    try:
        if "callback_query" in update:
            route_callback(update["callback_query"])
            return

        msg = update.get("message") or update.get("edited_message") or {}
        chat = msg.get("chat", {})
        chat_id = chat.get("id")
        text = msg.get("text") or msg.get("caption") or ""
        if not chat_id or not text:
            return

        tg_typing(chat_id)
        route_text(chat_id, text)
        log(f"{chat_id}: {text[:40]!r}")
    except Exception as e:
        log(f"process: {e}\n{traceback.format_exc()}")


