def _buyer_identity(chat_id):
    """Return (display_name, identifier, badge_line, is_registered)."""
    # Test mode — if owner is impersonating a retailer
    override = getattr(_buyer_identity, "_test_retailer", None)
    if override:
        for r in load_json(PARENT / "retailers.json", []):
            if isinstance(r, dict) and str(r.get("id","")).upper() == override.upper():
                shop = r.get("shop", override)
                badge = f"🏪 Test as {shop}"
                return (shop, override, badge, True)

    role, name, rid = get_role(chat_id)
    if role == "owner":
        badge = "👑 Owner (testing)"
        return ("Owner", "OWNER", badge, True)
    if role == "retailer" and rid:
        for r in load_json(PARENT / "retailers.json", []):
            if isinstance(r, dict) and str(r.get("id","")).upper() == str(rid).upper():
                shop = r.get("shop", name or "Retailer")
                badge = f"🏪 {shop}"
                return (shop, rid, badge, True)
        return (name or "Retailer", rid, f"🏪 {name or 'Retailer'}", True)
    if role == "rep":
        return (name or "Rep", rid, "👤 Sales Rep", True)
    # Public guest
    badge = "🆕 Guest (not registered)"
    return ("Guest Customer", f"TG-{chat_id}", badge, False)


