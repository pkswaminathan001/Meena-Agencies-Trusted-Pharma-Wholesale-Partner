def create_order(chat_id, cart):
    shop, retailer_id, badge, is_registered = _buyer_identity(chat_id)

    order = {
        "order_id": f"ORD-{datetime.now():%Y%m%d%H%M%S}-TG",
        "retailer_id": retailer_id,
        "shop": shop,
        "placed_at": datetime.now().strftime("%d-%b-%Y %H:%M"),
        "total": round(cart_total(cart), 2),
        "items": [{"medicine": l["name"], "qty": int(l["qty"]),
                    "price": float(l["price"]),
                    "line_total": round(float(l["price"]) * int(l["qty"]), 2)}
                   for l in cart],
        "status": "pending",
        "source": "telegram",
        "chat_id": str(chat_id),
    }

    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    orders.append(order)
    save_json(PARENT / "orders.json", orders)

    # Save favorites
    for l in cart:
        add_fav(chat_id, l["name"])

    # Notify owner
    # Check if retailer is registered
    is_registered = retailer_id and not str(retailer_id).startswith("TG-")
    reg_badge = "✅ Registered" if is_registered else "🆕 New customer"
    tg_username = ""

    lines = [f"🔔 <b>NEW ORDER — Awaiting Your Approval</b>\n",
             f"<b>Order ID:</b> <code>{order['order_id']}</code>",
             f"<b>Shop:</b> {shop}",
             f"<b>Retailer ID:</b> {retailer_id}  ·  {reg_badge}",
             f"<b>Source:</b> Telegram",
             f"<b>Time:</b> {order['placed_at']}\n"]
    for i, it in enumerate(order["items"], 1):
        lines.append(f"{i}. {it['medicine']} × {it['qty']} = Rs.{it['line_total']:,.2f}")
    lines.append(f"\n<b>Total: Rs.{order['total']:,.2f}</b>")
    tg_send(OWNER_CHAT_ID, "\n".join(lines),
            keyboard=kb([[
                {"text": "✅ Approve", "callback_data": f"appr:{order['order_id']}"},
                {"text": "❌ Reject", "callback_data": f"rej:{order['order_id']}"},
            ]]))
    return order


def approve(order_id):
    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    for o in orders:
        if o.get("order_id") == order_id:
            o["status"] = "approved"
            o["approved_at"] = datetime.now().strftime("%d-%b-%Y %H:%M")
            save_json(PARENT / "orders.json", orders)
            cid = o.get("chat_id")
            if cid:
                items_txt = "\n".join(
                    f"  {i}. {it['medicine']} × {it['qty']}"
                    for i, it in enumerate(o["items"], 1)
                )
                tg_send(cid,
                    f"🎉 <b>Order Approved!</b>\n\n"
                    f"<b>Order ID:</b> {o['order_id']}\n"
                    f"<b>Total:</b> Rs.{o['total']:,.2f}\n\n"
                    f"<b>Items:</b>\n{items_txt}\n\n"
                    f"📦 <i>We'll dispatch soon.</i>",
                    keyboard=kb([[{"text": "🛒 Shop More", "callback_data": "menu"}]]))
            return True
    return False


def reject(order_id):
    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    for o in orders:
        if o.get("order_id") == order_id:
            o["status"] = "cancelled"
            save_json(PARENT / "orders.json", orders)
            cid = o.get("chat_id")
            if cid:
                tg_send(cid,
                    f"❌ <b>Order Cancelled</b>\n\n"
                    f"<b>Order ID:</b> {o['order_id']}\n\n"
                    f"Please contact us for details.",
                    keyboard=kb([[{"text": "🛒 Back to Shop", "callback_data": "menu"}]]))
            return True
    return False


