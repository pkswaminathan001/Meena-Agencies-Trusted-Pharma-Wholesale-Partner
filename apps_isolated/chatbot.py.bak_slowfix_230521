def gen_otp():
    return "".join(str(random.randint(0, 9)) for _ in range(6))


def save_otp(chat_id, code, cart):
    otps = load_json(OTPS_FILE, {})
    otps[str(chat_id)] = {"code": code, "cart": cart, "attempts": 0,
                           "expires_at": (datetime.now() + timedelta(minutes=OTP_TTL_MIN)).isoformat()}
    save_json(OTPS_FILE, otps)


def verify_otp(chat_id, entered):
    otps = load_json(OTPS_FILE, {})
    e = otps.get(str(chat_id))
    if not e:
        return False, "No OTP pending", None
    try:
        if datetime.now() > datetime.fromisoformat(e["expires_at"]):
            del otps[str(chat_id)]
            save_json(OTPS_FILE, otps)
            return False, "OTP expired", None
    except Exception:
        return False, "Invalid OTP", None
    if e.get("attempts", 0) >= 5:
        del otps[str(chat_id)]
        save_json(OTPS_FILE, otps)
        return False, "Too many attempts", None
    if str(entered).strip() != e["code"]:
        e["attempts"] = e.get("attempts", 0) + 1
        otps[str(chat_id)] = e
        save_json(OTPS_FILE, otps)
        return False, f"Wrong. {5 - e['attempts']} tries left", None
    cart = e["cart"]
    del otps[str(chat_id)]
    save_json(OTPS_FILE, otps)
    return True, "OK", cart


