def get_cart(chat_id):
    return load_json(CARTS_FILE, {}).get(str(chat_id), [])


def save_cart(chat_id, cart):
    carts = load_json(CARTS_FILE, {})
    if cart:
        carts[str(chat_id)] = cart
    else:
        carts.pop(str(chat_id), None)
    save_json(CARTS_FILE, carts)


def cart_total(cart):
    return sum(float(l["price"]) * int(l["qty"]) for l in cart)


def cart_count(cart):
    return sum(int(l["qty"]) for l in cart)


def cart_inc(chat_id, idx):
    p = by_idx().get(idx)
    if not p:
        return
    cart = get_cart(chat_id)
    for l in cart:
        if l["name"] == p["name"]:
            l["qty"] = int(l["qty"]) + 1
            save_cart(chat_id, cart)
            return
    cart.append({"name": p["name"], "qty": 1, "price": p["price"]})
    save_cart(chat_id, cart)


def cart_dec(chat_id, idx):
    p = by_idx().get(idx)
    if not p:
        return
    cart = get_cart(chat_id)
    new = []
    for l in cart:
        if l["name"] == p["name"]:
            q = int(l["qty"]) - 1
            if q > 0:
                new.append({**l, "qty": q})
        else:
            new.append(l)
    save_cart(chat_id, new)


def cart_remove(chat_id, idx):
    p = by_idx().get(idx)
    if not p:
        return
    cart = [l for l in get_cart(chat_id) if l["name"] != p["name"]]
    save_cart(chat_id, cart)


def cart_clear(chat_id):
    save_cart(chat_id, [])


