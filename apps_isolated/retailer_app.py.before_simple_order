PARENT = Path(__file__).parent.parent


LOGO_PATH = Path(__file__).parent / "static" / "logo.png"

def render_logo(size=60):
    """Render peacock logo if available, else emoji fallback."""
    if LOGO_PATH.exists():
        st.markdown(
            f'<div style="text-align:center;margin-bottom:1rem;">'
            f'<img src="data:image/png;base64,{_logo_b64()}" '
            f'style="width:{size}px;height:{size}px;border-radius:50%;'
            f'box-shadow:0 4px 20px rgba(0,145,234,0.3);" />'
            f'</div>',
            unsafe_allow_html=True,
        )
    else:
        st.markdown(
            f'<div style="text-align:center;font-size:{size}px;margin-bottom:1rem;">🦚</div>',
            unsafe_allow_html=True,
        )

def _logo_b64():
    """Load logo as base64 string."""
    import base64
    try:
        return base64.b64encode(LOGO_PATH.read_bytes()).decode()
    except Exception:
        return ""



def load_json(fname, default):
    p = PARENT / fname
    if p.exists():
        try:
            return json.loads(p.read_text())
        except Exception:
            return default
    return default

def load_retailers():
    return load_json("retailers.json", [])

def save_retailers(r):
    (PARENT / "retailers.json").write_text(json.dumps(r, indent=2))

def verify_pin(provided, stored_hash):
    """Uses existing security.py if available; else fallback."""
    try:
        from security import verify_secret
        return verify_secret(provided, stored_hash)
    except Exception:
        import hashlib
        return hashlib.sha256(provided.encode()).hexdigest() == stored_hash


