def render_sidebar(retailer):
    with st.sidebar:
        render_logo(size=80)
        st.markdown("### 🛒 Meena Agencies")
        st.caption(f"**{retailer.get('shop', '')}**")
        st.caption(f"{retailer.get('owner', '')} · {retailer.get('id', '')}")
        st.caption(f"₹{retailer.get('outstanding', 0):,.0f} outstanding")
        st.markdown("---")

        for key, icon, label, help_text in MENU_ITEMS:
            active = st.session_state.retailer_page == key
            prefix = "**▸ " if active else ""
            suffix = "**" if active else ""
            if st.button(f"{prefix}{icon} {label}{suffix}",
                         key=f"nav_{key}",
                         use_container_width=True,
                         help=help_text):
                st.session_state.retailer_page = key
                st.rerun()

        st.markdown("---")
        if st.button("🚪 Sign Out", use_container_width=True):
            st.session_state.retailer_user = None
            st.session_state.retailer_page = "home"
            st.rerun()


