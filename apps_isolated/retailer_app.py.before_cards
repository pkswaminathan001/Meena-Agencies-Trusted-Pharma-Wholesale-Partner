    background: #fff; border: 1px solid var(--border);
    border-radius: 12px; padding: 1rem 1.2rem;
    margin-bottom: 0.7rem;
}
.product-card .name  { font-weight: 600; color: #1f2937; }
.product-card .price { color: #0e7490; font-weight: 700; }
.product-card .stock { color: #6b7280; font-size: 0.9rem; }
