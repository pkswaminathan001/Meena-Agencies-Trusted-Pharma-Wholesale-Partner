"""
retailer_app.py — Bulletproof Retailer App (v5)
Fixes: missing sidebar, mobile overlay, wrong app routing
"""
import base64, sys, json, hashlib
from pathlib import Path
import pandas as pd
import streamlit as st

PARENT = Path(__file__).parent.parent
sys.path.insert(0, str(PARENT))

st.set_page_config(
    page_title="Meena Agencies — Retailer",
    page_icon="🦚",
    layout="wide",
    initial_sidebar_state="expanded",   # ALWAYS start open
)

# ────────── CSS ──────────
st.markdown("""
<style>
:root {
    --brand: #0e7490; --accent: #f59e0b; --text: #1f2937;
    --muted: #6b7280; --bg: #f7f9fc; --card: #ffffff;
    --border: #e5e7eb;
}
html, body, .stApp, [data-testid="stAppViewContainer"] {
    background: var(--bg) !important;
    color: var(--text) !important;
    font-family: "Source Sans", sans-serif !important;
}
section[data-testid="stSidebar"] {
    background: #ffffff !important;
    border-right: 1px solid var(--border);
    min-width: 260px !important;
    max-width: 300px !important;
}
/* MOBILE FIX: sidebar slides in, does NOT cover the whole screen */
@media (max-width: 768px) {
    section[data-testid="stSidebar"] {
        min-width: 220px !important;
        max-width: 78vw !important;
    }
}
.stButton > button {
    border-radius: 10px; font-weight: 600;
    border: 1px solid var(--border);
}
.stButton > button:hover { border-color: var(--brand); color: var(--brand); }
.hero {
    background: linear-gradient(135deg, #0e7490, #155e75);
    color: #fff; padding: 1.5rem 2rem; border-radius: 16px;
    margin-bottom: 1.5rem;
}
.hero h1 { margin: 0; font-size: 1.9rem; color: #fff; }
.hero p  { margin: 0.3rem 0 0; opacity: 0.92; color: #fff; }
