.metric-box .value { color: var(--brand); font-size: 1.6rem; font-weight: 700; }
</style>
""", unsafe_allow_html=True)


def logo_html(h: int = 40) -> str:
    p = Path(__file__).parent / "static" / "logo.png"
    if p.exists():
        b64 = base64.b64encode(p.read_bytes()).decode()
        return f'<img src="data:image/png;base64,{b64}" style="height:{h}px;" alt="Meena">'
    return "🦚"


def find_col(df, *cands):
    cols = list(df.columns)
    for c in cands:
        if c in cols: return c
    lower = {str(c).lower(): c for c in cols}
    for c in cands:
        if c.lower() in lower: return lower[c.lower()]
    return None


@st.cache_data(ttl=60)
def load_inventory() -> pd.DataFrame:
    for p in (PARENT / "inventory.csv", Path("inventory.csv")):
        if p.exists():
            try:
                df = pd.read_csv(p)
                df.columns = [c.strip().lower() for c in df.columns]
                return df
            except Exception: pass
    return pd.DataFrame()


@st.cache_data(ttl=60)
def load_retailers() -> pd.DataFrame:
    import json as _json
    # JSON first
    for p in (PARENT / "retailers.json", Path("retailers.json")):
        if p.exists():
            try:
                data = _json.loads(p.read_text())
                if isinstance(data, dict):
                    data = list(data.values())
                return pd.DataFrame(data)
            except Exception: pass
    # CSVs
    for name in ("retailers.csv","retailer_master.csv","users.csv","credentials.csv"):
        for base in (PARENT, Path(".")):
            p = base / name
            if p.exists():
                try: return pd.read_csv(p)
                except Exception: pass
    return pd.DataFrame()


# ────────── LOGIN ──────────
def login_screen():
    _, mid, _ = st.columns([1, 2, 1])
    with mid:
        st.markdown(
            f'<div style="text-align:center;margin:2rem 0 1rem;">{logo_html(80)}</div>',
            unsafe_allow_html=True)
        st.markdown(
            '<h2 style="text-align:center;color:#0e7490;margin-bottom:0;">Meena Agencies</h2>',
            unsafe_allow_html=True)
        st.markdown(
            '<p style="text-align:center;color:#6b7280;margin-top:0;">Retailer Portal</p>',
            unsafe_allow_html=True)
        st.markdown("---")

        with st.form("login_form"):
            rid = st.text_input("Retailer ID", placeholder="e.g. RET001")
            pin = st.text_input("PIN", type="password", placeholder="4-digit PIN")
            ok = st.form_submit_button("Sign In", use_container_width=True)

        if not ok:
            return

        if not rid or not pin:
            st.error("Enter both Retailer ID and PIN.")
            return

        users = load_retailers()
        if users.empty:
            st.error("User database not found.")
            return

        id_col = find_col(users, "retailer_id","id","code","user_id","username")
        pin_col = find_col(users, "pin_hash","pin","password","passcode")
        name_col = find_col(users, "name","firm_name","retailer_name")

        if not id_col or not pin_col:
            st.error(f"Columns wrong. Found: {list(users.columns)}")
            return

        users["_id"]  = users[id_col].astype(str).str.strip().str.upper()
        users["_pin"] = users[pin_col].astype(str).str.strip()

        sub = users[users["_id"] == rid.strip().upper()]
        if sub.empty:
            st.error(f"Retailer {rid.upper()} not found.")
            return

        stored = sub.iloc[0]["_pin"]
        entered = pin.strip()

        # Try plain, then sha256, then sha256 of lowercase
        candidates = {
            entered,
            hashlib.sha256(entered.encode()).hexdigest(),
            hashlib.sha256(entered.lower().encode()).hexdigest(),
            hashlib.md5(entered.encode()).hexdigest(),
        }
        if stored not in candidates:
            st.error("Invalid PIN.")
            return

        user = sub.iloc[0].drop(labels=["_id","_pin"], errors="ignore").to_dict()
        st.session_state.retailer = user
        st.session_state.retailer_id = rid.strip().upper()
        st.session_state.page = "home"
        st.rerun()


# ────────── PAGES ──────────
def page_home(r):
    name = (r.get("name") or r.get("firm_name")
            or r.get("retailer_name") or st.session_state.retailer_id)
    st.markdown(f"""
        <div class="hero">
            <h1>Welcome, {name} 👋</h1>
            <p>Your retail dashboard — order medicines, track deliveries, manage your ledger.</p>
        </div>
    """, unsafe_allow_html=True)

    c1, c2, c3, c4 = st.columns(4)
    for col, label, val in [
        (c1, "Last Order", "—"),
        (c2, "Pending", "0"),
        (c3, "Due Amount", "₹0"),
        (c4, "Offers", "3"),
    ]:
        col.markdown(f"""
            <div class="metric-box">
                <div class="label">{label}</div>
                <div class="value">{val}</div>
            </div>
        """, unsafe_allow_html=True)

    st.markdown("### Quick Actions")
    q1, q2, q3 = st.columns(3)
    if q1.button("🛒 Place Order", use_container_width=True, key="qa_o"):
        st.session_state.page = "order"; st.rerun()
    if q2.button("🔍 Stock Check", use_container_width=True, key="qa_s"):
        st.session_state.page = "stock"; st.rerun()
    if q3.button("💰 Ledger", use_container_width=True, key="qa_l"):
        st.session_state.page = "ledger"; st.rerun()


def page_order(r):
    st.markdown("## 🛒 Place Order")
    st.caption("Search or browse medicines. Add to cart and submit.")
    df = load_inventory()
    if df.empty:
        st.warning("Inventory not available."); return

    name_col = find_col(df, "name","product","medicine","product_name","item")
    price_col = find_col(df, "price","mrp","rate","selling_price")
    stock_col = find_col(df, "stock","qty","quantity","available")
    if not name_col:
        st.error("Inventory has no product column."); return

    q = st.text_input("Search medicine", placeholder="e.g. Dolo, ORS",
                      key="oq").strip().lower()
    view = df.copy()
    if q:
        view = view[view[name_col].astype(str).str.lower().str.contains(q, na=False)]
    st.caption(f"{len(view)} medicine(s)")

    if "cart" not in st.session_state:
        st.session_state.cart = []

    for idx, (_, row) in enumerate(view.head(50).iterrows()):
        nm = str(row[name_col])
        try: pr = float(row[price_col]) if price_col and pd.notna(row[price_col]) else 0.0
        except Exception: pr = 0.0
        try: stk = int(row[stock_col]) if stock_col and pd.notna(row[stock_col]) else 0
        except Exception: stk = 0
        safe = "".join(c for c in nm if c.isalnum())[:15]
        uniq = f"{idx}_{safe}"

        c1, c2, c3 = st.columns([5, 2, 2])
        c1.markdown(f"**{nm}**")
        c2.markdown(f"₹{pr:.2f}")
        with c3:
            if stk > 0:
                if st.button(f"Add ({stk})", key=f"add_{uniq}", use_container_width=True):
                    st.session_state.cart.append({"name": nm, "price": pr, "qty": 1})
                    st.toast(f"Added {nm}")
            else:
                st.button("Out of stock", key=f"oos_{uniq}",
                          disabled=True, use_container_width=True)

    if st.session_state.cart:
        st.markdown("### 🧺 Cart")
        total = 0.0
        for i, it in enumerate(list(st.session_state.cart)):
            total += it["price"] * it["qty"]
            cc1, cc2, cc3 = st.columns([5, 3, 1])
            cc1.write(it["name"])
            cc2.write(f"₹{it['price']:.2f} × {it['qty']}")
            if cc3.button("✕", key=f"rm_{i}"):
                st.session_state.cart.pop(i); st.rerun()
        st.markdown(f"**Total: ₹{total:.2f}**")
        if st.button("✅ Submit Order", type="primary"):
            st.success(f"Order placed! ₹{total:.2f}")
            st.session_state.cart = []


def page_stock(r):
    st.markdown("## 🔍 Stock Check")
    st.caption("Search any medicine — see stock & price instantly")
    df = load_inventory()
    if df.empty:
        st.warning("Inventory not available."); return
    name_col = find_col(df, "name","product","medicine","product_name","item")
    price_col = find_col(df, "price","mrp","rate","selling_price")
    stock_col = find_col(df, "stock","qty","quantity","available")
    if not name_col:
        st.error("Inventory has no product column."); return
    q = st.text_input("Search", placeholder="Type medicine name...",
                      key="sq", label_visibility="collapsed").strip().lower()
    if not q:
        st.caption("Type to search..."); return
    view = df[df[name_col].astype(str).str.lower().str.contains(q, na=False)].head(50)
    st.caption(f"{len(view)} result(s)")
    for _, row in view.iterrows():
        nm = str(row[name_col])
        pr = row[price_col] if price_col and pd.notna(row[price_col]) else "—"
        stk = row[stock_col] if stock_col and pd.notna(row[stock_col]) else "—"
        st.markdown(f"""
            <div class="product-card">
                <div class="name">{nm}</div>
                <div class="price">₹{pr}</div>
                <div class="stock">Stock: {stk}</div>
            </div>
        """, unsafe_allow_html=True)


def page_placeholder(r, label, icon="⏳"):
    st.markdown(f"## {icon} {label}")
    st.info("Coming soon.")


MENU = [
    ("home",     "🏠", "Home"),
    ("order",    "🛒", "Place Order"),
    ("reorder",  "🔁", "Reorder Last"),
    ("bills",    "🧾", "Bill History"),
    ("track",    "🚚", "Track Deliveries"),
    ("cart",     "🛍️", "My Cart"),
    ("favorites","⭐", "Frequently Ordered"),
    ("stock",    "🔍", "Stock Check"),
    ("ledger",   "💰", "Ledger / Balance"),
    ("notify",   "🔔", "Notifications"),
    ("offers",   "🎁", "Offers & Schemes"),
    ("business", "📊", "My Business"),
    ("contact",  "📞", "Contact Us"),
    ("profile",  "👤", "My Profile"),
]


def render_sidebar():
    with st.sidebar:
        st.markdown(f'<div style="padding:0.8rem 0;">{logo_html(52)}</div>',
                    unsafe_allow_html=True)
        st.markdown("**Meena Agencies**")
        st.caption(st.session_state.get("retailer_id", ""))
        st.markdown("---")

        cur = st.session_state.get("page", "home")
        for k, ic, lbl in MENU:
            is_active = (k == cur)
            if st.button(f"{ic}  {lbl}", key=f"nav_{k}",
                         use_container_width=True,
                         type="primary" if is_active else "secondary"):
                st.session_state.page = k
                st.rerun()

        st.markdown("---")
        if st.button("🚪  Sign Out", key="nav_out", use_container_width=True):
            st.session_state.clear()
            st.rerun()


def main():
    if "retailer" not in st.session_state:
        login_screen()
        return

    r = st.session_state.retailer
    st.session_state.setdefault("page", "home")
    render_sidebar()

    page = st.session_state.page
    if page == "home":        page_home(r)
    elif page == "order":     page_order(r)
    elif page == "stock":     page_stock(r)
    else:
        # try external module first
        try:
            import importlib
            rp = importlib.import_module("retailer_pages")
            fn = getattr(rp, f"render_{page}", None)
            if fn:
                fn(r); return
        except Exception:
            pass
        label = next((m[2] for m in MENU if m[0] == page), page.title())
        icon  = next((m[1] for m in MENU if m[0] == page), "⏳")
        page_placeholder(r, label, icon)


main()
