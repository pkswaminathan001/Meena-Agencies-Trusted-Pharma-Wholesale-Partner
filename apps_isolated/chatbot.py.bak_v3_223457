def get_user_role(chat_id):
    cid = str(chat_id)
    if cid in _ROLE_CACHE:
        return _ROLE_CACHE[cid]

    if cid == OWNER_CHAT_ID:
        result = ("owner", "Swaminathan", None)
    else:
        result = (None, None, None)
        retailers = load_json(PARENT / "retailers.json", [])
        if isinstance(retailers, dict):
            retailers = list(retailers.values())
        for r in retailers:
            if isinstance(r, dict) and str(r.get("telegram_chat_id", "")).strip() == cid:
                result = ("retailer", r.get("owner", r.get("shop", "Retailer")), r.get("id"))
                break
        else:
            reps = load_json(PARENT / "salespeople.json", [])
            if isinstance(reps, dict):
                reps = list(reps.values())
            for rep in reps:
                if isinstance(rep, dict) and str(rep.get("telegram_chat_id", "")).strip() == cid:
                    result = ("rep", rep.get("name", "Rep"), rep.get("id"))
                    break

    _ROLE_CACHE[cid] = result
    return result


