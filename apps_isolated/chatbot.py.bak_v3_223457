def handle_public(chat_id, text, name=None):
    """Anyone can use these commands."""
    intent, arg = parse_public_intent(text)

    if intent == "welcome":
        return public_welcome(name)
    if intent == "products":
        return public_products()
    if intent == "search":
        return public_search(arg)
    if intent == "offers":
        return public_offers()
    if intent == "about":
        return public_about()
    if intent == "contact":
        return public_contact()

    # Unknown intent → welcoming menu
    return public_welcome(name)


def handle_owner(chat_id, text):
    """Owner gets everything, including business commands."""
    t = text.strip().lower()

    # Public command fallback
    intent, arg = parse_public_intent(text)
    if intent and intent != "welcome":
        if intent == "products":
            return public_products()
        if intent == "search":
            return public_search(arg)
        if intent == "offers":
            return public_offers()
        if intent == "about":
            return public_about()
        if intent == "contact":
            return public_contact()

    # Owner-specific
    if t in ("hi", "hello", "start", "/start", "vanakkam"):
        return (
            "🙏 <b>Vanakkam Swaminathan!</b>\n\n"
            "<b>Business commands:</b>\n"
            "• <b>pending</b> — pending orders\n"
            "• <b>retailers</b> — retailer list\n"
            "• <b>brief</b> — daily summary\n\n"
            "<b>Public commands:</b>\n"
            "• products · search &lt;name&gt; · offers\n\n"
            "<i>Or ask anything in natural language.</i>"
        )

    if "pending" in t:
        orders = load_orders()
        pending = [o for o in orders if (o.get("status") or "").lower() == "pending"]
        if not pending:
            return "✅ No pending orders."
        lines = [f"⏳ <b>{len(pending)} pending:</b>\n"]
        for o in pending[:8]:
            lines.append(
                f"• <b>{o.get('order_id','?')}</b>\n"
                f"  {o.get('shop','?')} · {money(o.get('total',0))}"
            )
        return "\n".join(lines)

    if t in ("retailers", "shops", "list"):
        rets = load_retailers()
        lines = [f"🏪 <b>{len(rets)} retailers:</b>\n"]
        for r in rets:
            if not isinstance(r, dict):
                continue
            out = float(r.get("outstanding") or 0)
            lim = float(r.get("credit_limit") or 0)
            pct = (out / lim * 100) if lim else 0
            emoji = "🔴" if pct >= 90 else ("🟠" if pct >= 60 else "🟢")
            lines.append(f"{emoji} <b>{r.get('shop','?')}</b>\n   {money(out)} ({pct:.0f}%)")
        return "\n".join(lines)

    if "brief" in t or "summary" in t:
        orders = load_orders()
        pending = [o for o in orders if (o.get("status") or "").lower() == "pending"]
        rets = load_retailers()
        total_out = sum(float(r.get("outstanding") or 0) for r in rets if isinstance(r, dict))
        cat = load_catalog()
        return (
            f"📊 <b>Brief — {datetime.now().strftime('%d-%b')}</b>\n\n"
            f"📦 {len(orders)} orders ({len(pending)} pending)\n"
            f"💰 Outstanding: {money(total_out)}\n"
            f"🏪 {len(rets)} retailers\n"
            f"💊 {len(cat)} medicines"
        )

    # AI fallback
    reply = groq_ask(text, build_owner_context())
    if reply:
        return reply

    return "Try: <b>pending</b>, <b>retailers</b>, <b>brief</b>, <b>products</b>, or ask anything."


def handle_retailer(chat_id, text, name, retailer_id):
    t = text.strip().lower()

    # Public fallback
    intent, arg = parse_public_intent(text)
    if intent and intent not in ("welcome", None):
        return handle_public(chat_id, text, name)

    retailers = load_retailers()
    me = next((r for r in retailers
               if isinstance(r, dict) and str(r.get("id","")).upper() == str(retailer_id).upper()),
              {})

    if t in ("hi", "hello", "start", "/start", "vanakkam"):
        out = float(me.get("outstanding") or 0)
        lim = float(me.get("credit_limit") or 0)
        return (
            f"🙏 <b>Vanakkam {name}!</b>\n\n"
            f"💰 Outstanding: <b>{money(out)}</b>\n"
            f"💳 Available: <b>{money(lim - out)}</b>\n\n"
            f"<b>Your commands:</b>\n"
            f"• <b>bills</b> · <b>balance</b> · <b>order</b>\n\n"
            f"<b>Public:</b>\n"
            f"• products · search &lt;name&gt; · offers"
        )

    if t in ("bills", "orders", "my bills"):
        mine = [o for o in load_orders()
                if str(o.get("retailer_id","")).upper() == str(retailer_id).upper()]
        if not mine:
            return "No orders yet."
        lines = [f"🧾 <b>Last {min(len(mine),5)} orders:</b>\n"]
        for o in mine[-5:][::-1]:
            s = (o.get("status") or "").lower()
            e = {"pending":"⏳","approved":"✅","delivered":"🎉","cancelled":"❌"}.get(s,"•")
            lines.append(f"{e} {o.get('order_id','?')} · {money(o.get('total',0))}")
        return "\n".join(lines)

    if t in ("balance", "ledger", "outstanding"):
        out = float(me.get("outstanding") or 0)
        lim = float(me.get("credit_limit") or 0)
        return (
            f"💰 <b>Your Ledger</b>\n\n"
            f"Limit:      <b>{money(lim)}</b>\n"
            f"Owed:       <b>{money(out)}</b>\n"
            f"Available:  <b>{money(lim - out)}</b>"
        )

    if t in ("order", "place order", "new order"):
        return (
            "🛒 <b>Place order:</b>\n\n"
            "1. Open: http://localhost:8501\n"
            f"2. Login: {retailer_id}\n"
            "3. Add items → Request OTP"
        )

    return public_welcome(name)


def handle_rep(chat_id, text, name, rep_id):
    fwd = (
        f"👤 <b>Rep Message</b>\n\n"
        f"<b>From:</b> {name} ({rep_id})\n"
        f"<b>Time:</b> {datetime.now().strftime('%d-%b %H:%M')}\n"
        f"<b>Text:</b> {text}"
    )
    tg_send(OWNER_CHAT_ID, fwd)
    return "✅ Sent to owner."


def route_message(chat_id, text):
    role, name, rid = get_user_role(chat_id)
    if role == "owner":
        return handle_owner(chat_id, text)
    elif role == "retailer":
        return handle_retailer(chat_id, text, name, rid)
    elif role == "rep":
        return handle_rep(chat_id, text, name, rid)
    else:
        return handle_public(chat_id, text)


# ═══════════════════════════════════════════════════════
# MESSAGE PROCESSOR
# ═══════════════════════════════════════════════════════
def process_one(update):
    try:
        msg = update.get("message") or update.get("edited_message") or {}
        chat = msg.get("chat", {})
        chat_id = chat.get("id")
        text = msg.get("text") or msg.get("caption") or ""
        if not chat_id or not text:
            return

        tg_typing(chat_id)
        reply = route_message(chat_id, text)
        if reply:
            tg_send(chat_id, reply)
            log(f"Replied to {chat_id}: {text[:30]!r}")
    except Exception as e:
        log(f"process error: {e}\n{traceback.format_exc()}")


