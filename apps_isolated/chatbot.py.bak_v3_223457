_CACHE = {}
_CACHE_TTL = 30


def _cached(key, loader):
    now = time.time()
    if key in _CACHE:
        data, ts = _CACHE[key]
        if now - ts < _CACHE_TTL:
            return data
    data = loader()
    _CACHE[key] = (data, now)
    return data


def load_orders():
    def _load():
        o = load_json(PARENT / "orders.json", [])
        return o if isinstance(o, list) else list(o.values())
    return _cached("orders", _load)


def load_retailers():
    def _r():
        r = load_json(PARENT / "retailers.json", [])
        return r if isinstance(r, list) else list(r.values())
    return _cached("retailers", _r)


def money(v):
    try:
        return f"Rs.{float(v):,.2f}"
    except Exception:
        return "Rs.0.00"


