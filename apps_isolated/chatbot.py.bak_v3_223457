def groq_ask(question, context):
    try:
        key = (PARENT / ".groq_key").read_text().strip()
        if not key:
            return None
        payload = {
            "model": AI_MODEL,
            "messages": [
                {"role": "system", "content":
                 "You are JARVIS for Meena Agencies pharma distributor. "
                 "Answer SHORT. Max 120 words. Use Rs. for money."},
                {"role": "system", "content": "DATA:\n" + context},
                {"role": "user", "content": question},
            ],
            "temperature": 0.3,
            "max_tokens": 300,
        }
        req = urllib.request.Request(
            "https://api.groq.com/openai/v1/chat/completions",
            data=json.dumps(payload).encode(),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
                "User-Agent": "Meena-Chatbot/3.0",
            },
        )
        with urllib.request.urlopen(req, timeout=AI_TIMEOUT) as resp:
            d = json.loads(resp.read())
            return d["choices"][0]["message"]["content"].strip()
    except Exception as e:
        log(f"groq error: {e}")
        return None


