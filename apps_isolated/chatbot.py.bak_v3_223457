    print(f"  ✅ Listening from offset {offset}")
    print("═" * 50)

    executor = ThreadPoolExecutor(max_workers=4)
    backoff = 1

    while True:
        try:
            r = tg_api("getUpdates", {"offset": offset, "timeout": POLL_TIMEOUT},
                       timeout=POLL_TIMEOUT + 10)
            if not r or not r.get("ok"):
                time.sleep(backoff)
                backoff = min(backoff * 2, 30)
                continue
            backoff = 1
            for u in r.get("result", []):
                executor.submit(process_one, u)
                offset = u.get("update_id", offset) + 1
                save_json(STATE_FILE, {"offset": offset})
        except KeyboardInterrupt:
            print("\n👋 Stopped"); break
        except Exception as e:
            log(f"Loop error: {e}")
            time.sleep(min(30, backoff))
            backoff = min(backoff * 2, 30)


if __name__ == "__main__":
    main()
