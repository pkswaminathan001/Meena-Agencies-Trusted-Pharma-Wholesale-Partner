# ═══════════════════════════════════════════════════════
# INTENT MATCHING
# ═══════════════════════════════════════════════════════
def parse_public_intent(text):
    """Return (intent, arg) for public commands."""
    t = text.strip().lower()

    if t in ("hi", "hello", "start", "/start", "vanakkam", "hey"):
        return ("welcome", None)

    if t in ("products", "catalog", "medicines", "catalogue", "browse"):
        return ("products", None)

    if t in ("offers", "deals", "discounts"):
        return ("offers", None)

    if t in ("about", "info", "who are you"):
        return ("about", None)

    if t in ("contact", "phone", "call", "reach"):
        return ("contact", None)

    m = re.match(r'^(?:search|find|price of|price)\s+(.+)$', text.strip(), re.IGNORECASE)
    if m:
        return ("search", m.group(1).strip())

    # Bare medicine name (single word or phrase) — treat as search
    if 2 <= len(t) <= 40 and not any(x in t for x in ("help", "?")):
        # If it looks like a medicine name
        if any(kw in t for kw in ("mg", "ml", "tablet", "capsule", "syrup", "injection", "powder",
                                   "paracet", "dolo", "ors", "amoxi", "azithro", "cetiri",
                                   "atorva", "metfor", "insulin", "omepra", "ibupro", "cough",
                                   "salbutamol")):
            return ("search", text.strip())

    return (None, None)


