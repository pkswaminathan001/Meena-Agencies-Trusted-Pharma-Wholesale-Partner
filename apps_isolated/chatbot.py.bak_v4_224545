def money(v):
    try:
        return f"Rs.{float(v):,.2f}"
    except Exception:
        return "Rs.0.00"


def welcome_kb():
    return kb([
        [{"text": "💊 Browse Products", "callback_data": "cat"}],
        [{"text": "🛒 My Cart", "callback_data": "cart"}],
        [{"text": "🎁 Offers", "callback_data": "offers"}],
        [{"text": "ℹ️ About", "callback_data": "about"},
         {"text": "📞 Contact", "callback_data": "contact"}],
    ])


def catalog_kb():
    """One button per product — max 2 per row."""
    items = catalog_list()
    rows = []
    for p in items:
        label = f"➕ {p['name']}"
        if len(label) > 30:
            label = label[:28] + ".."
        rows.append([{"text": label, "callback_data": f"add:{p['idx']}"}])
    rows.append([{"text": "🛒 View Cart", "callback_data": "cart"}])
    return kb(rows)


def cart_kb(cart):
    """Buttons: remove each item, checkout, clear."""
    rows = []
    for l in cart:
        label = f"🗑️ {l['name']} × {l['qty']}"
        if len(label) > 32:
            label = label[:30] + ".."
        rows.append([{"text": label, "callback_data": f"rm:{l['name'][:40]}"}])
    rows.append([
        {"text": "✅ Checkout", "callback_data": "checkout"},
        {"text": "🗑️ Clear Cart", "callback_data": "clear"},
    ])
    return kb(rows)


def build_catalog_text():
    groups = catalog_summary()
    if not groups:
        return "⚠️ Catalog loading..."
    total = sum(len(v) for v in groups.values())
    lines = [f"💊 <b>Medicine Catalog</b> ({total} items)\n"]
    for cat_name in sorted(groups.keys()):
        items = groups[cat_name]
        lines.append(f"<b>{cat_name}</b>")
        for p in items:
            lines.append(f"  • {p['name']} — {money(p['price'])}")
        lines.append("")
    lines.append("<i>Tap a product to add to cart.</i>")
    return "\n".join(lines)


def build_cart_text(cart):
    if not cart:
        return "🛒 Your cart is empty.\n\nTap Browse Products to add items."
    lines = [f"🛒 <b>Your Cart</b> ({cart_count(cart)} items)\n"]
    for l in cart:
        lines.append(
            f"• <b>{l['name']}</b>\n"
            f"  {l['qty']} × {money(l['price'])} = "
            f"<b>{money(float(l['price'])*int(l['qty']))}</b>"
        )
    lines.append(f"\n<b>Total: {money(cart_total(cart))}</b>")
    lines.append("\n<i>Tap Checkout to receive OTP.</i>")
    return "\n".join(lines)


