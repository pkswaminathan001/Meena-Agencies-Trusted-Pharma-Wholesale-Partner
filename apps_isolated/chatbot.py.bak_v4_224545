def get_cart(chat_id):
    carts = load_json(CARTS_FILE, {})
    return carts.get(str(chat_id), [])


def save_cart(chat_id, cart):
    carts = load_json(CARTS_FILE, {})
    if cart:
        carts[str(chat_id)] = cart
    else:
        carts.pop(str(chat_id), None)
    save_json(CARTS_FILE, carts)


def cart_add(chat_id, product):
    cart = get_cart(chat_id)
    for line in cart:
        if line["name"] == product["name"]:
            line["qty"] += 1
            save_cart(chat_id, cart)
            return
    cart.append({"name": product["name"], "qty": 1, "price": product["price"]})
    save_cart(chat_id, cart)


def cart_remove(chat_id, name):
    cart = get_cart(chat_id)
    cart = [l for l in cart if l["name"] != name]
    save_cart(chat_id, cart)
    return cart


def cart_clear(chat_id):
    save_cart(chat_id, [])


def cart_total(cart):
    return sum(float(l["price"]) * int(l["qty"]) for l in cart)


def cart_count(cart):
    return sum(int(l["qty"]) for l in cart)


