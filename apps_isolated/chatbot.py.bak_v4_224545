def create_order(chat_id, cart):
    """Create a pending order, send to owner for approval."""
    role, name, rid = get_user_role(chat_id)
    shop = "Telegram Customer"
    retailer_id = f"TG-{chat_id}"

    if role == "retailer":
        retailer_id = rid or retailer_id
        retailer_data = next(
            (r for r in load_json(PARENT / "retailers.json", [])
             if isinstance(r, dict) and str(r.get("id","")).upper() == str(rid).upper()),
            {}
        )
        shop = retailer_data.get("shop", name or "Retailer")

    order = {
        "order_id": f"ORD-{datetime.now():%Y%m%d%H%M%S}-TG",
        "retailer_id": retailer_id,
        "shop": shop,
        "placed_at": datetime.now().strftime("%d-%b-%Y %H:%M"),
        "total": round(cart_total(cart), 2),
        "items": [{
            "medicine": l["name"],
            "qty": int(l["qty"]),
            "price": float(l["price"]),
            "line_total": round(float(l["price"]) * int(l["qty"]), 2),
        } for l in cart],
        "status": "pending",
        "source": "telegram",
        "chat_id": str(chat_id),
    }

    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    orders.append(order)
    save_json(PARENT / "orders.json", orders)

    # Notify owner with Approve/Reject buttons
    lines = [
        f"🔔 <b>New Order — Awaiting Your Approval</b>\n",
        f"<b>Order ID:</b> {order['order_id']}",
        f"<b>From:</b> {shop} ({retailer_id})",
        f"<b>Time:</b> {order['placed_at']}",
        f"<b>Items:</b> {len(order['items'])}\n",
    ]
    for i, it in enumerate(order["items"], 1):
        lines.append(f"{i}. {it['medicine']} × {it['qty']} = Rs.{it['line_total']:,.2f}")
    lines.append(f"\n<b>Total: Rs.{order['total']:,.2f}</b>")
    body = "\n".join(lines)

    keyboard = kb([
        [
            {"text": "✅ Approve", "callback_data": f"appr:{order['order_id']}"},
            {"text": "❌ Reject", "callback_data": f"rej:{order['order_id']}"},
        ]
    ])
    tg_send(OWNER_CHAT_ID, body, keyboard=keyboard)

    return order


def approve_order(order_id, owner_chat_id):
    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    for o in orders:
        if o.get("order_id") == order_id:
            o["status"] = "approved"
            o["approved_by"] = "OWNER"
            o["approved_at"] = datetime.now().strftime("%d-%b-%Y %H:%M")
            save_json(PARENT / "orders.json", orders)

            # Notify customer
            cid = o.get("chat_id")
            if cid:
                tg_send(cid,
                    f"✅ <b>Order Approved!</b>\n\n"
                    f"<b>Order ID:</b> {o['order_id']}\n"
                    f"<b>Total:</b> Rs.{o['total']:,.2f}\n\n"
                    f"<i>We'll dispatch soon. You'll get another "
                    f"message when it ships.</i>"
                )
            return o
    return None


def reject_order(order_id, owner_chat_id):
    orders = load_json(PARENT / "orders.json", [])
    if isinstance(orders, dict):
        orders = list(orders.values())
    for o in orders:
        if o.get("order_id") == order_id:
            o["status"] = "cancelled"
            o["cancelled_by"] = "OWNER"
            o["cancelled_at"] = datetime.now().strftime("%d-%b-%Y %H:%M")
            save_json(PARENT / "orders.json", orders)

            cid = o.get("chat_id")
            if cid:
                tg_send(cid,
                    f"❌ <b>Order Rejected</b>\n\n"
                    f"<b>Order ID:</b> {o['order_id']}\n\n"
                    f"<i>Please contact us for details.</i>"
                )
            return o
    return None


