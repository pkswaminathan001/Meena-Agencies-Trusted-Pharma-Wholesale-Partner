_CATALOG_CACHE = {"data": None, "ts": 0}


def load_catalog():
    now = time.time()
    if _CATALOG_CACHE["data"] and (now - _CATALOG_CACHE["ts"]) < 60:
        return _CATALOG_CACHE["data"]

    products = {}
    try:
        if INVENTORY_FILE.exists():
            with open(INVENTORY_FILE, newline="") as f:
                reader = csv.DictReader(f)
                for row in reader:
                    name = (row.get("medicine_name") or "").strip()
                    if not name:
                        continue
                    qty = int(float(row.get("quantity") or 0))
                    cost = float(row.get("cost_price") or 0)
                    public_price = round(cost * 1.18, 2)
                    if name in products:
                        products[name]["stock"] += qty
                        products[name]["batches"] += 1
                    else:
                        products[name] = {
                            "name": name,
                            "price": public_price,
                            "stock": qty,
                            "batches": 1,
                            "category": _classify(name),
                        }
    except Exception as e:
        log(f"catalog error: {e}")

    _CATALOG_CACHE["data"] = products
    _CATALOG_CACHE["ts"] = now
    return products


def _classify(name):
    n = name.lower()
    for kw, cat in [
        ("amoxi", "Antibiotic"), ("azithro", "Antibiotic"), ("cef", "Antibiotic"),
        ("paracet", "Pain Relief"), ("ibupro", "Pain Relief"), ("dolo", "Pain Relief"),
        ("atorva", "Cardiac"), ("metfor", "Diabetes"), ("insulin", "Diabetes"),
        ("cetiri", "Allergy"), ("omepra", "Gastro"), ("ors", "Hydration"),
        ("cough", "Cough & Cold"), ("salbutamol", "Respiratory"),
        ("vitamin", "Supplement"),
    ]:
        if kw in n:
            return cat
    return "General"


def catalog_list():
    """Return sorted list of product dicts with stable index."""
    cat = load_catalog()
    items = sorted(cat.values(), key=lambda x: x["name"])
    for i, p in enumerate(items):
        p["idx"] = i
    return items


def catalog_by_idx():
    return {p["idx"]: p for p in catalog_list()}


def catalog_summary():
    groups = {}
    for p in catalog_list():
        groups.setdefault(p["category"], []).append(p)
    return groups


def search_products(query, limit=10):
    if not query:
        return []
    q = query.lower().strip()
    matches = [p for p in catalog_list() if q in p["name"].lower()]
    matches.sort(key=lambda x: (0 if x["name"].lower().startswith(q) else 1, x["name"]))
    return matches[:limit]


