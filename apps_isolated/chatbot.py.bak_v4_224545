def gen_otp():
    return "".join(str(random.randint(0, 9)) for _ in range(6))


def save_otp(chat_id, code, cart):
    otps = load_json(OTPS_FILE, {})
    otps[str(chat_id)] = {
        "code": code,
        "cart": cart,
        "expires_at": (datetime.now() + timedelta(minutes=OTP_TTL_MIN)).isoformat(),
        "attempts": 0,
    }
    save_json(OTPS_FILE, otps)


def verify_otp(chat_id, entered):
    otps = load_json(OTPS_FILE, {})
    entry = otps.get(str(chat_id))
    if not entry:
        return False, "No pending OTP. Type 'cart' to start.", None
    try:
        expires = datetime.fromisoformat(entry["expires_at"])
        if datetime.now() > expires:
            del otps[str(chat_id)]
            save_json(OTPS_FILE, otps)
            return False, "OTP expired. Request a new one.", None
    except Exception:
        return False, "Invalid OTP.", None
    if entry.get("attempts", 0) >= 5:
        del otps[str(chat_id)]
        save_json(OTPS_FILE, otps)
        return False, "Too many wrong attempts.", None
    if str(entered).strip() != str(entry["code"]):
        entry["attempts"] = entry.get("attempts", 0) + 1
        otps[str(chat_id)] = entry
        save_json(OTPS_FILE, otps)
        return False, f"Wrong OTP. {5 - entry['attempts']} tries left.", None
    cart = entry["cart"]
    del otps[str(chat_id)]
    save_json(OTPS_FILE, otps)
    return True, "OK", cart


