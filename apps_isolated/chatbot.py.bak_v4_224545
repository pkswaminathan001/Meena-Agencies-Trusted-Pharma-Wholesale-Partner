# CALLBACK QUERY HANDLER
# ═══════════════════════════════════════════════════════
def handle_callback(cb):
    """Handle inline button clicks."""
    try:
        cb_id = cb.get("id")
        chat_id = cb.get("message", {}).get("chat", {}).get("id")
        msg_id = cb.get("message", {}).get("message_id")
        data = cb.get("data", "")

        if not chat_id or not data:
            tg_answer_callback(cb_id)
            return

        # Approve / Reject from owner
        if data.startswith("appr:"):
            oid = data[5:]
            if str(chat_id) != OWNER_CHAT_ID:
                tg_answer_callback(cb_id, "Not authorized")
                return
            o = approve_order(oid, chat_id)
            if o:
                tg_answer_callback(cb_id, "✅ Approved")
                tg_edit(chat_id, msg_id,
                    f"✅ <b>Approved</b>\n\n{oid}\n\nCustomer notified.",
                    keyboard=None)
            else:
                tg_answer_callback(cb_id, "Order not found")
            return

        if data.startswith("rej:"):
            oid = data[4:]
            if str(chat_id) != OWNER_CHAT_ID:
                tg_answer_callback(cb_id, "Not authorized")
                return
            o = reject_order(oid, chat_id)
            if o:
                tg_answer_callback(cb_id, "❌ Rejected")
                tg_edit(chat_id, msg_id,
                    f"❌ <b>Rejected</b>\n\n{oid}\n\nCustomer notified.",
                    keyboard=None)
            else:
                tg_answer_callback(cb_id, "Order not found")
            return

        # Public actions
        if data == "cat":
            tg_answer_callback(cb_id, "Opening catalog...")
            show_catalog(chat_id, msg_id)
            return

        if data == "cart":
            tg_answer_callback(cb_id, "Opening cart...")
            show_cart(chat_id, msg_id)
            return

        if data == "clear":
            cart_clear(chat_id)
            tg_answer_callback(cb_id, "Cleared")
            show_cart(chat_id, msg_id)
            return

        if data == "checkout":
            cart = get_cart(chat_id)
            if not cart:
                tg_answer_callback(cb_id, "Cart empty")
                return
            tg_answer_callback(cb_id, "Sending OTP...")
            start_checkout(chat_id)
            return

        if data == "offers":
            cat = load_catalog()
            items = sorted(cat.values(), key=lambda x: -x["stock"])[:5]
            lines = ["🎁 <b>Featured Today</b>\n"]
            rows = []
            for p in items:
                lines.append(f"⭐ <b>{p['name']}</b> — {money(p['price'])}")
                rows.append([{"text": f"➕ Add {p['name'][:25]}", "callback_data": f"add:{p['idx']}"}])
            rows.append([{"text": "🛒 View Cart", "callback_data": "cart"}])
            tg_answer_callback(cb_id)
            tg_edit(chat_id, msg_id, "\n".join(lines), keyboard=kb(rows))
            return

        if data == "about":
            tg_answer_callback(cb_id)
            tg_edit(chat_id, msg_id,
                f"<b>🦚 MEENA AGENCIES</b>\n"
                f"<i>Trusted Pharma Wholesale Partner</i>\n\n"
                f"📍 Thanjavur, Tamil Nadu\n"
                f"💊 {len(load_catalog())} medicines\n"
                f"⚡ Shop 24/7 right here\n\n"
                f"<i>Tap below to browse.</i>",
                keyboard=kb([[{"text": "💊 Browse Products", "callback_data": "cat"}]]))
            return

        if data == "contact":
            tg_answer_callback(cb_id)
            tg_edit(chat_id, msg_id,
                f"📞 <b>Contact Meena Agencies</b>\n\n"
                f"📱 Phone: +91 63821 30536\n"
                f"📧 meena.agencies@gmail.com\n"
                f"📍 Thanjavur, Tamil Nadu\n\n"
                f"<i>Shop 24/7 right here in Telegram.</i>",
                keyboard=kb([[{"text": "💊 Browse Products", "callback_data": "cat"}]]))
            return

        if data.startswith("add:"):
            try:
                idx = int(data[4:])
                p = catalog_by_idx().get(idx)
                if not p:
                    tg_answer_callback(cb_id, "Product not found")
                    return
                cart_add(chat_id, p)
                count = cart_count(get_cart(chat_id))
                tg_answer_callback(cb_id, f"✅ Added. Cart: {count} item(s)")
            except Exception as e:
                log(f"add err: {e}")
                tg_answer_callback(cb_id, "Error")
            return

        if data.startswith("rm:"):
            name = data[3:]
            cart = cart_remove(chat_id, name)
            tg_answer_callback(cb_id, "Removed")
            show_cart(chat_id, msg_id)
            return

        tg_answer_callback(cb_id)
    except Exception as e:
        log(f"callback error: {e}\n{traceback.format_exc()}")


# ═══════════════════════════════════════════════════════
# TEXT MESSAGE HANDLER
# ═══════════════════════════════════════════════════════
def handle_text(chat_id, text):
    t = text.strip().lower()

    # OTP check first (if user has pending OTP)
    otps = load_json(OTPS_FILE, {})
    if str(chat_id) in otps and re.match(r'^\d{6}$', t):
        ok, msg, cart = verify_otp(chat_id, t)
        if not ok:
            tg_send(chat_id, f"❌ {msg}")
            return
        order = create_order(chat_id, cart)
        cart_clear(chat_id)
        tg_send(chat_id,
            f"✅ <b>Order Placed Successfully!</b>\n\n"
            f"<b>Order ID:</b> {order['order_id']}\n"
            f"<b>Total:</b> Rs.{order['total']:,.2f}\n\n"
            f"⏳ Waiting for owner approval.\n"
            f"You'll get a notification once approved.",
            keyboard=welcome_kb())
        return

    # Welcome
    if t in ("hi", "hello", "start", "/start", "vanakkam", "hey"):
        show_welcome(chat_id)
        return

    # Catalog
    if t in ("products", "catalog", "medicines", "browse"):
        show_catalog(chat_id)
        return

    # Cart
    if t in ("cart", "my cart", "basket"):
        show_cart(chat_id)
        return

    # Checkout
    if t in ("checkout", "buy", "place order"):
        start_checkout(chat_id)
        return

    # Clear
    if t in ("clear", "empty"):
        cart_clear(chat_id)
        tg_send(chat_id, "🗑️ Cart cleared.", keyboard=welcome_kb())
        return

    # Search
    m = re.match(r'^(?:search|find|price of|price)\s+(.+)$', text.strip(), re.IGNORECASE)
    if m:
        search_and_reply(chat_id, m.group(1).strip())
        return

    # Offers
    if t in ("offers", "deals", "discounts"):
        cb = {"id": "auto", "message": {"chat": {"id": chat_id}, "message_id": 0}, "data": "offers"}
        # Simpler: send directly
        cat = load_catalog()
        items = sorted(cat.values(), key=lambda x: -x["stock"])[:5]
        lines = ["🎁 <b>Featured Today</b>\n"]
        rows = []
        for p in items:
            lines.append(f"⭐ <b>{p['name']}</b> — {money(p['price'])}")
            rows.append([{"text": f"➕ Add {p['name'][:25]}", "callback_data": f"add:{p['idx']}"}])
        rows.append([{"text": "🛒 View Cart", "callback_data": "cart"}])
        tg_send(chat_id, "\n".join(lines), keyboard=kb(rows))
        return

    if t in ("about", "info"):
        tg_send(chat_id,
            f"<b>🦚 MEENA AGENCIES</b>\n"
            f"<i>Trusted Pharma Wholesale Partner</i>\n\n"
            f"📍 Thanjavur, Tamil Nadu\n"
            f"💊 {len(load_catalog())} medicines\n"
            f"⚡ Shop 24/7 right here",
            keyboard=welcome_kb())
        return

    if t in ("contact", "phone", "call"):
        tg_send(chat_id,
            f"📞 <b>Contact Meena Agencies</b>\n\n"
            f"📱 +91 63821 30536\n"
            f"📧 meena.agencies@gmail.com\n"
            f"📍 Thanjavur, Tamil Nadu",
            keyboard=welcome_kb())
        return

    # Bare product name → search
    if 2 <= len(text.strip()) <= 40:
        if any(kw in t for kw in ("mg", "ml", "tablet", "capsule", "syrup",
                                   "paracet", "dolo", "ors", "amoxi", "azithro",
                                   "cetiri", "atorva", "metfor", "insulin", "omepra",
                                   "ibupro", "cough", "salbutamol")):
            search_and_reply(chat_id, text.strip())
            return

    # Fallback
    tg_send(chat_id,
        "I didn't catch that. Try:\n"
        "• <b>products</b> — browse catalog\n"
        "• <b>cart</b> — view your cart\n"
        "• <b>search &lt;medicine&gt;</b>\n"
        "• <b>offers</b> — today's deals",
        keyboard=welcome_kb())


# ═══════════════════════════════════════════════════════
# MESSAGE PROCESSOR
# ═══════════════════════════════════════════════════════
def process_one(update):
    try:
        # Callback query (button click)
        if "callback_query" in update:
            handle_callback(update["callback_query"])
            return

        msg = update.get("message") or update.get("edited_message") or {}
        chat = msg.get("chat", {})
        chat_id = chat.get("id")
        text = msg.get("text") or msg.get("caption") or ""
        if not chat_id or not text:
            return

        tg_typing(chat_id)
        handle_text(chat_id, text)
        log(f"Handled {chat_id}: {text[:40]!r}")
    except Exception as e:
        log(f"process error: {e}\n{traceback.format_exc()}")


