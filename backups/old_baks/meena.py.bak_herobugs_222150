            except Exception: pass
    return dict(DEFAULT_RULES)

def save_rules(rules):
    try:
        if SEC_LOADED: sec.log_audit("owner", "save_rules", details=dict(rules))
    except Exception: pass
    for p in (PARENT/"approval_rules.json", Path("approval_rules.json")):
