def _groq_ask(question, context):
    """Send a question + business context to Groq. Returns string reply or None."""
    try:
        import urllib.request
        key = ""
        for p in (PARENT / ".groq_key", Path(".groq_key")):
            if p.exists():
                key = p.read_text().strip()
                break
        if not key or not key.startswith("gsk_"):
            return None

        payload = {
            "model": "openai/gpt-oss-120b",
            "messages": [
                {"role": "system",
                 "content": "You are JARVIS, AI assistant for Meena Agencies, "
                            "a wholesale pharma distributor in Tamil Nadu, India. "
                            "Answer concisely using the live data. Be specific with "
                            "numbers. Use Rs. for amounts. Never invent data."},
                {"role": "system", "content": "LIVE DATA:\n" + context},
                {"role": "user",   "content": question},
            ],
            "temperature": 0.3,
            "max_tokens": 700,
        }
        req = urllib.request.Request(
            "https://api.groq.com/openai/v1/chat/completions",
            data=json.dumps(payload).encode(),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
                "User-Agent": "Meena/1.0 (+local)",
                "Accept": "application/json",
            },
        )
        with urllib.request.urlopen(req, timeout=25) as resp:
            data = json.loads(resp.read())
            return data["choices"][0]["message"]["content"].strip()
    except Exception as e:
        return "Groq error: " + str(e)


def _build_business_context():
    """Snapshot of live business data for the AI model."""
    try:
        orders = load_orders()
        rets = load_retailers()
        inv = load_inventory()
        lines = []
        lines.append("=== BUSINESS SNAPSHOT ===")
        lines.append(f"Total orders: {len(orders)}")
        pend = [o for o in orders if (o.get("status") or "").lower() == "pending"]
        lines.append(f"Pending orders: {len(pend)} (worth Rs.{sum(float(o.get('total',0)) for o in pend):,.0f})")
        lines.append("")
        lines.append("=== RETAILERS ===")
        for r in rets:
            lines.append(
                f"- {r.get('shop','?')} ({r.get('id','?')}): "
                f"owner={r.get('owner','?')}, "
                f"outstanding=Rs.{float(r.get('outstanding') or 0):,.0f}, "
                f"limit=Rs.{float(r.get('credit_limit') or 0):,.0f}, "
                f"status={r.get('status','Active')}"
            )
        if not inv.empty:
            lines.append("")
            lines.append(f"=== INVENTORY === {len(inv)} rows in stock")
        return "\n".join(lines)
    except Exception as e:
        return f"(context build error: {e})"


