def load_commandments():
    for p in (COMMANDMENTS_FILE, Path("commandments.json")):
        if p.exists():
            try:
                d = json.loads(p.read_text())
                return {**COMMANDMENTS_HARD, **COMMANDMENTS_DEFAULT, **d}
            except Exception: pass
    return {**COMMANDMENTS_HARD, **COMMANDMENTS_DEFAULT}

def save_commandments(data):
    for p in (COMMANDMENTS_FILE, Path("commandments.json")):
        try:
            p.write_text(json.dumps(data, indent=2))
            try:
                import os as _o, stat as _s
                _o.chmod(p, _s.S_IRUSR | _s.S_IWUSR)
            except Exception: pass
            return True
        except Exception: pass
    return False


def evaluate_credit_rule(retailer, cart_total):
    """Return (allowed, level, message).
       level: 'ok' | 'warn' | 'block'
    """
    cmd = load_commandments()
    limit = float((retailer or {}).get("credit_limit") or 0)
    out   = float((retailer or {}).get("outstanding") or 0)
    status = str((retailer or {}).get("status") or "").lower()

    # HARD: already on hold
    if "hold" in status or "suspend" in status:
        return False, "block", "Account on credit hold — clear dues to unlock."

    # HARD: over 100%
    if limit > 0:
        pct_after = ((out + cart_total) / limit) * 100
    else:
        pct_after = 999 if (out + cart_total) > 0 else 0

    if cmd.get("block_at_100pct") and pct_after > 100:
        return False, "block", f"Order would push you to {pct_after:.0f}% of credit limit (₹{limit:,.0f})."

    # SOFT: over soft threshold
    soft = cmd.get("soft_block_at_pct", 90)
    if pct_after >= soft:
        return True, "warn", f"At {pct_after:.0f}% of credit limit after this order — owner will review."

    return True, "ok", ""

