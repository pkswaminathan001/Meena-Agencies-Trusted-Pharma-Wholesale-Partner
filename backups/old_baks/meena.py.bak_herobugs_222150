                return d if isinstance(d, list) else list(d.values())
            except Exception:
                pass
    return []

def save_salespeople(data):
    for p in (SALESPEOPLE_FILE, Path("salespeople.json")):
        try:
            p.write_text(json.dumps(data, indent=2))
            try:
                import os as _o, stat as _s
                _o.chmod(p, _s.S_IRUSR | _s.S_IWUSR)
            except Exception:
                pass
            return True
        except Exception:
            pass
    return False


