def owner_expiry():
    """Batch & Expiry Manager — never lose money to expired stock."""
    st.markdown("## ⏰ Batch & Expiry Manager")
    st.caption("Track expiring batches, avoid losses, plan discounts")

    inv = load_inventory()
    if inv.empty:
        st.error("inventory.csv not found.")
        return

    nm  = find_col(inv, "medicine_name", "medicine", "name")
    exp = find_col(inv, "expiry_date", "expiry", "exp")
    qty = find_col(inv, "quantity", "stock", "qty")
    prc = find_col(inv, "cost_price", "price", "rate")
    bat = find_col(inv, "batch_number", "batch", "lot")
    if not exp or not nm:
        st.error(f"Missing columns. Found: {list(inv.columns)}")
        return

    df = inv.copy()
    df["_exp"] = pd.to_datetime(df[exp], errors="coerce", format="mixed")
    df["_qty"] = pd.to_numeric(df[qty], errors="coerce").fillna(0).astype(int) if qty else 0
    df["_prc"] = pd.to_numeric(df[prc], errors="coerce").fillna(0) if prc else 0
    df["_val"] = df["_qty"] * df["_prc"]
    today = pd.Timestamp.now().normalize()
    df["_days"] = (df["_exp"] - today).dt.days

    def bucket(d):
        if pd.isna(d): return "No Date"
        if d < 0:      return "Expired"
        if d <= 30:    return "< 30 days"
        if d <= 90:    return "30-90 days"
        if d <= 180:   return "90-180 days"
        return "> 180 days"

    df["_bucket"] = df["_days"].apply(bucket)

    expired = df[df["_bucket"] == "Expired"]
    soon    = df[df["_bucket"] == "< 30 days"]
    warn    = df[df["_bucket"] == "30-90 days"]
    ok_long = df[df["_bucket"] == "> 180 days"]

    st.markdown('<div class="section-head">📊 Expiry Overview</div>', unsafe_allow_html=True)
    c1, c2, c3, c4 = st.columns(4)
    for col, tone, label, count, val in [
        (c1, "red",    "⛔ Expired",       len(expired), money(expired["_val"].sum())),
        (c2, "orange", "🚨 < 30 days", len(soon),    money(soon["_val"].sum())),
        (c3, "purple", "⚠ 30-90 days",    len(warn),    money(warn["_val"].sum())),
        (c4, "green",  "✅ > 180 days",    len(ok_long), money(ok_long["_val"].sum())),
    ]:
        with col:
            st.markdown(f'<div class="metric-tile {tone}"><div class="label">{label}</div><div class="value">{count}</div><div style="font-size:.7rem;color:#8892b0;margin-top:.3rem;">{val}</div></div>', unsafe_allow_html=True)

    st.markdown('<div class="section-head">🚨 Critical — Action Required</div>', unsafe_allow_html=True)
    action = df[df["_bucket"].isin(["Expired", "< 30 days"])].sort_values("_days")
    if action.empty:
        st.success("✅ No expired or near-expiry batches. Great job!")
    else:
        st.error(f"⚠ {len(action)} batch(es) need action — value at risk: **{money(action['_val'].sum())}**")
        show_cols = [c for c in [nm, bat, exp, qty, prc] if c]
        st.dataframe(action[show_cols], use_container_width=True, hide_index=True)

    st.markdown('<div class="section-head">📥 Suggested Discounts</div>', unsafe_allow_html=True)
    disc = warn.copy()
    if disc.empty:
        st.info("No batches in the 30–90 day window.")
    else:
        disc["Suggested Discount"] = disc["_days"].apply(
            lambda d: "40%" if d <= 45 else ("25%" if d <= 60 else "15%")
        )
        show_cols = [c for c in [nm, bat, exp, qty] if c] + ["Suggested Discount"]
        st.dataframe(disc[show_cols], use_container_width=True, hide_index=True)


