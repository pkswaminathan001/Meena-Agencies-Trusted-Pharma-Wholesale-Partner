def _time_of_day():
    """Return (slot, emoji, greeting, subtitle) based on current hour."""
    from datetime import datetime as _dt
    h = _dt.now().hour
    if 5 <= h < 11:
        return "morning", "🌅", "Good morning", "Fresh start — let's make today count"
    elif 11 <= h < 16:
        return "afternoon", "☀️", "Good afternoon", "Peak hours — focus on growth"
    elif 16 <= h < 20:
        return "evening", "🌇", "Good evening", "Wrapping up — review the day"
    else:
        return "night", "🌙", "Vanakkam, late night", "Working late — I've got your back"


