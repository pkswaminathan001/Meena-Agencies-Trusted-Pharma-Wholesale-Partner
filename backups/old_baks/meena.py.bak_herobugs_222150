DEFAULT_RULES = {
    "auto_approve_max_value": 5000.0,       # ₹ under this → auto approve
    "trusted_min_orders": 3,                # customers with ≥ this many orders → auto
    "restricted_categories": ["Injection", "Insulin"],  # always manual
    "block_overdue_days": 60,               # block if overdue > this
    "auto_approve_enabled": True,
    "manual_approvers": ["OWNER"],          # user IDs allowed to approve
}

def load_rules():
