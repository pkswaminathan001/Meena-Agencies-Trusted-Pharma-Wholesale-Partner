            p.write_text(json.dumps(rules, indent=2))
            return True
        except Exception: pass
    return False


def decide_approval(order, retailer, rules):
    """Return (decision, reason, decided_by).
       decision: 'auto' | 'manual'
    """
    if not rules.get("auto_approve_enabled", True):
        return "manual", "Auto-approve disabled", None

    total = float(order.get("total", 0))
    items = order.get("items", []) or []

    # ── Rule 1: Restricted categories → manual ──
    restricted = [c.lower() for c in rules.get("restricted_categories", [])]
    for it in items:
        nm = (it.get("medicine") or it.get("name") or "").lower()
        if any(r in nm for r in restricted):
            return "manual", f"Restricted category ({[r for r in restricted if r in nm][0].title()})", None

    # ── Rule 2: Block overdue ──
    if retailer:
        try:
            overdue = float(retailer.get("overdue_days") or 0)
            if overdue > float(rules.get("block_overdue_days", 60)):
                return "manual", f"Overdue {int(overdue)} days", None
        except Exception: pass

    # ── Rule 3: High value → manual ──
    max_val = float(rules.get("auto_approve_max_value", 0))
    if total > max_val:
        return "manual", f"High value order ({money(total)} > {money(max_val)})", None

    # ── Rule 4: Trusted customer → auto ──
    if retailer:
        order_count = int(retailer.get("_order_count") or 0)
        if order_count >= int(rules.get("trusted_min_orders", 3)):
            return "auto", f"Trusted customer ({order_count} prior orders)", "System"

    # ── Rule 5: Low value → auto ──
    if total <= max_val:
        return "auto", f"Low value order ({money(total)})", "System"

    return "manual", "Manual review", None


