CATEGORIES = ["Antibiotic","Pain Relief","Cardiac","Diabetes","Gastro",
              "Allergy","Injection","Syrup","Inhaler","Powder"]

def _classify(name):
    n = name.lower()
    if "inhal" in n: return "🌬️","#7b61ff","Inhaler"
    if "syrup" in n or "cough" in n: return "🧴","#00d4ff","Syrup"
    if "powder" in n or "ors" in n: return "🥤","#ffb547","Powder"
    if "insulin" in n or "inject" in n: return "💉","#ff4d6d","Injection"
    if "amoxi" in n or "azithro" in n: return "💊","#ff8c42","Antibiotic"
    if "metfor" in n: return "🩸","#ff4d6d","Diabetes"
    if "atorva" in n: return "❤️","#e91e63","Cardiac"
    if "paracet" in n or "ibupro" in n: return "💊","#00d4ff","Pain Relief"
    if "cetiri" in n: return "🤧","#7b61ff","Allergy"
    if "omepra" in n: return "🫃","#00d47a","Gastro"
    return "💊","#00d4ff","Medicine"

@st.cache_data(ttl=10)
def order_catalog():
    raw = load_inventory()
    if raw.empty: return pd.DataFrame()
    df = raw.copy()
    nm = find_col(df,"medicine_name","medicine","name")
    pr = find_col(df,"cost_price","price","mrp","rate")
    stk= find_col(df,"quantity","stock","qty")
    if not nm: return pd.DataFrame()
    out = pd.DataFrame()
    out["name"] = df[nm].astype(str).str.strip()
    out["price"] = pd.to_numeric(df[pr],errors="coerce").fillna(0) if pr else 0.0
    out["stock"] = pd.to_numeric(df[stk],errors="coerce").fillna(0).astype(int) if stk else 0
    if pr and pr.lower()=="cost_price":
        out["price"] = (out["price"]*1.18).round(2)
    g = out.groupby("name",as_index=False).agg(price=("price","min"),stock=("stock","sum"),batches=("name","count"))
    g["emoji"],g["color"],g["cat"] = zip(*g["name"].map(_classify))
    return g.sort_values("name").reset_index(drop=True)


