def find_col(df, *c):
    if df is None or df.empty: return None
    for cand in c:
        if cand in df.columns: return cand
    lower = {str(x).lower():x for x in df.columns}
    for cand in c:
        if cand.lower() in lower: return lower[cand.lower()]
    return None

