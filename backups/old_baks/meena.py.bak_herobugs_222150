def _count(items, status_value):
    try:
        return len([o for o in items if (o.get("status") or "").lower() == status_value])
    except Exception:
        return 0


def _sum(items, status_value):
    try:
        return sum(float(o.get("total", 0)) for o in items
                   if (o.get("status") or "").lower() == status_value)
    except Exception:
        return 0


