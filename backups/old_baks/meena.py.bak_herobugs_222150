def place_order_with_approval(retailer, cart):
    """Create order, evaluate credit rule, save to orders.json."""
    if not cart:
        return None
    total = sum(float(l["price"]) * int(l["qty"]) for l in cart)

    order = {
        "order_id": f"ORD-{datetime.now():%Y%m%d%H%M%S}",
        "retailer_id": st.session_state.get("retailer_id", ""),
        "shop": (retailer or {}).get("shop", ""),
        "placed_at": datetime.now().strftime("%d-%b-%Y %H:%M"),
        "total": round(total, 2),
        "items": [{
            "medicine": l["name"],
            "qty": int(l["qty"]),
            "price": float(l["price"]),
            "line_total": round(float(l["price"]) * int(l["qty"]), 2),
        } for l in cart],
        "status": "pending",
    }

    try:
        orders = load_orders()

        # Count prior orders for this retailer (for trusted-customer rule)
        prior = sum(1 for o in orders
                    if str(o.get("retailer_id", "")).upper()
                    == str(order["retailer_id"]).upper())

        # Credit rule check (Owner Commandments)
        allowed, level, msg = evaluate_credit_rule(retailer or {}, total)

        if not allowed:
            order["status"] = "blocked"
            order["approval_decision"] = "blocked"
            order["approval_reason"] = msg
        else:
            # Try the rules engine if it exists
            try:
                rules = load_rules()
                r_info = dict(retailer or {})
                r_info["_order_count"] = prior
                decision, reason, approver = decide_approval(order, r_info, rules)
                order["approval_decision"] = decision
                order["approval_reason"] = reason
                if decision == "auto":
                    order["status"] = "approved"
                    order["approved_by"] = approver or "System (auto)"
                    order["approved_at"] = datetime.now().strftime("%d-%b-%Y %H:%M")
                else:
                    order["approved_by"] = None
                    order["approved_at"] = None
            except Exception:
                # Fallback rule if decide_approval is missing
                order["approval_decision"] = "manual"
                order["approval_reason"] = "Queued for owner review"
                order["approved_by"] = None
                order["approved_at"] = None

            # Flag if over 90% credit
            try:
                lim = float((retailer or {}).get("credit_limit") or 0)
                out = float((retailer or {}).get("outstanding") or 0)
                if lim > 0 and (out + total) / lim >= 0.9:
                    order["flag"] = "OVER_LIMIT_REVIEW"
                    order["flag_reason"] = f"Uses {(out+total)/lim*100:.0f}% of credit"
            except Exception:
                pass

        orders.append(order)
        save_orders(orders)
    except Exception as e:
        order["approval_decision"] = "manual"
        order["approval_reason"] = f"Auto-approval error: {e}"

    return order


def _r_cart():
    cart = st.session_state.get("cart",[])
    if not cart: return
    total = sum(l["price"]*l["qty"] for l in cart)
    count = sum(l["qty"] for l in cart)
    st.markdown("---")
    st.markdown(f'<div class="section-head">🧺 Cart — {count} item(s) · {money(total)}</div>', unsafe_allow_html=True)
    for i,line in enumerate(list(cart)):
        c1,c2,c3,c4 = st.columns([4,2,2,1])
