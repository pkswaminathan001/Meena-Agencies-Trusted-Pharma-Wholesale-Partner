                    f'font-size:.78rem;margin-top:.2rem;">{info["label"].upper()}</div></div>',
                    unsafe_allow_html=True)

            if status == "cancelled":
                st.error(f"❌ Cancelled — {o.get('cancel_reason','—')}")
                continue

            st.markdown("---")
            decision    = o.get("approval_decision") or ("manual" if status == "pending" else "approved")
            approver    = o.get("approved_by") or "—"
            reason      = o.get("approval_reason") or "—"
            approved_at = o.get("approved_at") or "—"

            if status == "pending":
                st.info(f"⏳ **Awaiting approval** — {reason if reason != '—' else 'Queued for owner review'}")
            else:
                st.success(f"✅ **{decision.title()} approval** · {approver} · {approved_at} — Reason: {reason}")

            st.markdown("##### 🏢 Company Side")
            stages = [("Placed","📥",1),("Approved","✅",2),("Packed","📦",3),("Dispatched","🚚",4)]
            html = '<div style="display:flex;justify-content:space-between;margin:.6rem 0;">'
            for lbl, ic, stg in stages:
                done = info["stage"] >= stg
                bg = "linear-gradient(135deg,#00d4ff,#7b61ff)" if done else "#1a1f2e"
                col = "#00d4ff" if done else "#8892b0"
                html += (f'<div style="text-align:center;flex:1;">'
                         f'<div style="width:40px;height:40px;border-radius:50%;background:{bg};'
                         f'display:flex;align-items:center;justify-content:center;'
                         f'margin:0 auto;font-size:1rem;">{ic}</div>'
                         f'<div style="font-size:.7rem;color:{col};margin-top:.35rem;'
                         f'font-weight:600;">{lbl}</div></div>')
            html += '</div>'
            st.markdown(html, unsafe_allow_html=True)

            if info["stage"] >= 4:
                awb = o.get("awb_number") or o.get("tracking_id") or "—"
                courier = o.get("courier") or "DHL"
                st.markdown("---")
                st.markdown(
                    f'<div style="background:linear-gradient(135deg,#ffb54722,#ffb54708);'
                    f'border-left:4px solid #ffb547;border-radius:10px;padding:.9rem 1.1rem;">'
                    f'<div style="font-weight:700;color:#ffb547;font-size:.95rem;">'
                    f'📮 Handed to {courier}</div>'
                    f'<div style="color:#c5cae9;font-size:.85rem;margin-top:.4rem;">'
                    f'<b>AWB:</b> <code style="color:#00d4ff;">{awb}</code></div></div>',
                    unsafe_allow_html=True)
                if awb != "—":
                    st.markdown(
                        f'<a href="https://www.dhl.com/in-en/home/tracking.html?tracking-id={awb}" '
                        f'target="_blank" style="display:inline-block;margin-top:.5rem;'
                        f'padding:.5rem 1.1rem;background:linear-gradient(90deg,#00d4ff,#7b61ff);'
                        f'color:#0a0e1a;font-weight:700;border-radius:10px;'
                        f'text-decoration:none;font-size:.85rem;">🚚 Track on {courier} →</a>',
                        unsafe_allow_html=True)
                st.caption("✅ Company responsibility ends at dispatch. Further tracking is by courier.")
            else:
                st.info("📮 Once dispatched, we'll share the courier AWB so you can track it directly.")




