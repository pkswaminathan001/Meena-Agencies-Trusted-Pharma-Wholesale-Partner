def _r_med_card(row):
    color = row["color"]
    st.markdown(f'<div class="med-card" style="border-top:3px solid {color};"><div class="med-emoji">{row["emoji"]}</div><div class="med-name">{row["name"][:36]}</div><div class="med-price" style="color:{color};">₹{row["price"]:,.2f}</div><div class="med-meta">{int(row["batches"])} batch(es) · {int(row["stock"]):,} in stock</div></div>', unsafe_allow_html=True)
    if int(row["stock"])<=0:
        st.button("Out of stock", key=f"oos_{row['name']}", disabled=True, use_container_width=True); return
    q1,q2 = st.columns([1,2])
    with q1:
        qty = st.number_input("Q", min_value=1, max_value=int(row["stock"]),
                              value=1, key=f"q_{row['name']}", label_visibility="collapsed")
    with q2:
        if st.button("➕ Add", key=f"add_{row['name']}", use_container_width=True, type="primary"):
            for line in st.session_state.cart:
                if line["name"]==row["name"]: line["qty"]+=qty; break
            else: st.session_state.cart.append({"name":row["name"],"price":float(row["price"]),"qty":qty})
            st.toast(f"Added {qty} × {row['name']}"); st.rerun()


def _r_cart():
    cart = st.session_state.get("cart",[])
    if not cart: return
    total = sum(l["price"]*l["qty"] for l in cart)
    count = sum(l["qty"] for l in cart)
    st.markdown("---")
    st.markdown(f'<div class="section-head">🧺 Cart — {count} item(s) · {money(total)}</div>', unsafe_allow_html=True)
    for i,line in enumerate(list(cart)):
        c1,c2,c3,c4 = st.columns([4,2,2,1])
        c1.markdown(f"**{line['name']}**")
        c2.markdown(f"₹{line['price']:,.2f} × {line['qty']}")
        c3.markdown(f"**₹{line['price']*line['qty']:,.2f}**")
        if c4.button("✕", key=f"rm_{i}_{line['name']}"):
            cart.pop(i); st.rerun()
    b1,b2 = st.columns(2)
    if b1.button("✅ Submit Order (Get OTP)", type="primary", use_container_width=True):
        st.success(f"Order placed! {money(total)} — {count} item(s).")
        st.session_state.cart=[]; st.rerun()
    if b2.button("🗑️ Clear Cart", use_container_width=True):
        st.session_state.cart=[]; st.rerun()


