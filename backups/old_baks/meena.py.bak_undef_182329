            st.session_state.role = "retailer"
            st.session_state.retailer = target
            st.session_state.retailer_id = rid.strip().upper()
            st.session_state.user_name = target.get("owner") or target.get("shop") or rid
            st.session_state.page = "home"
            st.rerun()


