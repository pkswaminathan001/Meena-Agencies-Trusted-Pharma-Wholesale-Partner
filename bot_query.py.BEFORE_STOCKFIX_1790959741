def customer_context(retailer: dict) -> str:
    """Context for a specific retailer — only THEIR data."""
    if not retailer:
        return "Customer not identified."

    orders = _load_json("orders.json", [])
    r_orders = [o for o in orders if o.get("retailer_id") == retailer["id"]]
    recent = sorted(r_orders, key=lambda o: o.get("placed_at", ""), reverse=True)[:5]

    lines = [
        f"CUSTOMER: {retailer.get('shop','?')}",
        f"Owner: {retailer.get('owner','—')}",
        f"Credit limit: {_fmt_money(retailer.get('credit_limit',0))}",
        f"Outstanding: {_fmt_money(retailer.get('outstanding',0))}",
        f"Available credit: {_fmt_money(retailer.get('credit_limit',0) - retailer.get('outstanding',0))}",
        "",
        f"RECENT ORDERS ({len(recent)}):",
    ]
    for o in recent:
        lines.append(
            f"• {o.get('order_id','?')} · {_fmt_money(o.get('total',0))} · "
            f"{o.get('status','?')} · {o.get('placed_at','?')}"
        )

    # Pending orders
    pending = [o for o in r_orders if o.get("status") in ("Pending", "Awaiting OTP")]
    if pending:
        lines.append("")
        lines.append(f"PENDING ({len(pending)}):")
        for o in pending:
            lines.append(f"• {o.get('order_id','?')} · {_fmt_money(o.get('total',0))}")

    return "\n".join(lines)


def customer_stock_query(query: str) -> str:
    """Check stock for a medicine (customer-visible)."""
    inv = _load_inventory()
    if inv is None or len(inv) == 0:
        return "Stock data temporarily unavailable."
    try:
        match = inv[inv["medicine_name"].astype(str)
                   .str.contains(query, case=False, na=False)]
        if len(match) == 0:
            return f"No medicine found matching '{query}'."
        lines = [f"SEARCH RESULTS for '{query}':"]
        for _, row in match.head(5).iterrows():
            qty = int(row.get("quantity", 0) or 0)
            price = float(row.get("selling_price", row.get("price", 0)) or 0)
            mrp = float(row.get("mrp", price * 1.3) or 0)
            lines.append(
                f"• {row.get('medicine_name','?')} — "
                f"{qty} units available · "
                f"Price {_fmt_money(price)} (MRP {_fmt_money(mrp)}) · "
                f"Batch {row.get('batch', row.get('batch_number','—'))}"
            )
        return "\n".join(lines)
    except Exception as e:
        return f"Search error: {e}"


def customer_price_query(query: str) -> str:
    """Price lookup for a specific medicine."""
    return customer_stock_query(query)


# ═══════════════════════════════════════════════════════════
# MAIN DISPATCHER
# ═══════════════════════════════════════════════════════════

def get_context(intent: str, user_message: str, role: str, retailer: dict = None) -> str:
    """Return context string for the LLM based on intent."""
    if role == "owner":
        if intent == "owner_revenue": return owner_revenue_context()
        if intent == "owner_orders": return owner_revenue_context()
        if intent == "owner_pending": return owner_pending_context()
        if intent == "owner_payments": return owner_payments_context()
        if intent == "owner_stock":
            # Extract medicine name from message if any
            query = _extract_medicine(user_message)
            return owner_stock_context(query)
        if intent == "owner_retailer":
            name = _extract_retailer(user_message)
            return owner_retailer_context(name)
        if intent == "owner_fastmovers": return owner_fastmovers_context()
        if intent == "owner_quiet": return owner_quiet_context()
        if intent == "owner_summary": return owner_summary_context()
        return owner_summary_context()

    elif role == "retailer":
        base = customer_context(retailer) if retailer else ""
        if intent in ("cust_stock", "cust_price"):
            query = _extract_medicine(user_message)
            return base + "\n\n" + customer_stock_query(query)
        if intent == "cust_order_status":
            return base
        if intent == "cust_reorder":
            return base
        return base

    return ""


def _extract_medicine(text: str) -> str:
    """Pull likely medicine name from message."""
    # Common medicine keywords to look for
    common = ["dolo", "paracetamol", "amoxicillin", "azithromycin", "cetirizine",
              "insulin", "glargine", "ors", "cough syrup", "ibuprofen",
              "pantoprazole", "omeprazole", "metformin", "telmisartan"]
    t = text.lower()
    for med in common:
        if med in t:
            return med
    # Otherwise, take last 1-2 words
    words = [w.strip("?,.") for w in t.split() if len(w) > 3]
    return " ".join(words[-2:]) if words else ""


def _extract_retailer(text: str) -> str:
    """Pull likely retailer name from message."""
    retailers = _load_json("retailers.json", [])
    t = text.lower()
    for r in retailers:
        if r.get("shop", "").lower() in t:
            return r["shop"]
        if r.get("id", "").lower() in t:
            return r["id"]
        if r.get("owner", "").lower() in t:
            return r["owner"]
    # Take longest word that looks like a name
    words = [w.strip("?,.") for w in t.split() if len(w) > 4]
    return words[-1] if words else ""


