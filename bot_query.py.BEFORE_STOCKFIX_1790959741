"""
bot_query.py — Data engine for the conversational bot.
Reads real business data (orders, retailers, inventory) and returns
structured context strings for bot_nlu.py to reason about.
"""
import json
from pathlib import Path
from datetime import datetime, timedelta


def _load_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return default if default is not None else []


def _load_inventory():
    """Load inventory from SQLite (primary) or CSV (fallback)."""
    import pandas as pd
    # Try SQLite first — that's where the real data lives
    try:
        import sqlite3
        conn = sqlite3.connect("inventory.db")
        df = pd.read_sql("SELECT * FROM inventory", conn)
        conn.close()
        if len(df) > 0:
            # Normalize column names
            rename = {}
            if "batch_number" in df.columns and "batch" not in df.columns:
                rename["batch_number"] = "batch"
            if "selling_price" not in df.columns and "cost_price" in df.columns:
                df["selling_price"] = (df["cost_price"] * 1.25).round(2)
            if "mrp" not in df.columns and "cost_price" in df.columns:
                df["mrp"] = (df["cost_price"] * 1.30).round(2)
            if rename:
                df = df.rename(columns=rename)
            return df
    except Exception:
        pass

    # Fallback: CSV
    try:
        import pandas as pd
        df = pd.read_csv("inventory.csv")
        if len(df) > 0:
            return df
    except Exception:
        pass

    return None


def _fmt_money(v):
    try:
        return f"₹{float(v):,.0f}"
    except Exception:
        return "₹0"


